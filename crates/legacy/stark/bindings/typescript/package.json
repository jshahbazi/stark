{
    "name": "@jshahbazi/stark",
    "version": "0.1.0",
    "description": "A high-performance inference engine for AI models",
    "author": "Mirai Tech Inc. <contact@getmirai.co>",
    "types": "dist/index.d.ts",
    "main": "dist/index.js",
    "type": "commonjs",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jshahbazi/stark.git"
    },
    "license": "MIT",
    "packageManager": "pnpm@10.18.1",
    "os": [
        "darwin"
    ],
    "cpu": [
        "arm64",
        "x64"
    ],
    "napi": {
        "binaryName": "stark"
    },
    "files": [
        "**/*"
    ],
    "private": true,
    "scripts": {
        "build": "./scripts/build",
        "format": "./scripts/format",
        "tsn": "ts-node -r tsconfig-paths/register",
        "lint": "./scripts/lint",
        "test": "vitest run",
        "test:build": "node scripts/utils/check-build.cjs",
        "fix": "./scripts/format"
    },
    "dependencies": {
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.17.4",
        "@napi-rs/cli": "3.1.2",
        "@types/node": "^24.0.0",
        "@typescript-eslint/eslint-plugin": "8.71.1",
        "@typescript-eslint/parser": "8.71.1",
        "@typescript-eslint/typescript-estree": "^8.71.1",
        "eslint": "^10.12.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-unused-imports": "^4.4.1",
        "prettier": "^3.9.9",
        "publint": "^0.2.12",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "tslib": "^2.8.1",
        "typescript": "5.8.3",
        "typescript-eslint": "8.71.1",
        "vitest": "^5.0.3"
    },
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./*.mjs": {
            "default": "./dist/*.mjs"
        },
        "./*.js": {
            "default": "./dist/*.js"
        },
        "./*": {
            "import": "./dist/*.mjs",
            "require": "./dist/*.js"
        }
    }
}
