// Official MLX head-output precision policy. F32 accumulation is preserved;
// final values are BF16-rounded and widened into the F32 sampler/scorer buffer.
// Stock evidence: mlx-serve046b6476 / MLX64ea011c QuantizedMatmul, output T=x.dtype.
// Contains the preserved native-body epilogue control and the scoped stock
// affine QMV fast port below, with separate validation records.

static inline float official_head_bf16_value(float value) {
    const uint bits = as_type<uint>(value);
    if ((bits & 0x7fffffffu) > 0x7f800000u) {
        return as_type<float>((bits & 0xffff0000u) | 0x00400000u);
    }
    const uint rounded = bits + 0x7fffu + ((bits >> 16) & 1u);
    return as_type<float>(rounded & 0xffff0000u);
}

kernel void gemv_q4_bf16_bf16values_f32out(
    device const uint* codes [[buffer(0)]],
    device const bfloat* scales [[buffer(1)]],
    device const bfloat* biases [[buffer(2)]],
    device const bfloat* x [[buffer(3)]],
    device float* y [[buffer(4)]],
    constant uint& K [[buffer(5)]],
    constant uint& GS [[buffer(6)]],
    uint row [[threadgroup_position_in_grid]],
    uint lane [[thread_index_in_threadgroup]]) {
    GEMV_Q4_BODY(y[row] = official_head_bf16_value(sum))
}

kernel void official_head_round_bf16_values_f32(
    device float* values [[buffer(0)]],
    constant uint& count [[buffer(1)]],
    uint i [[thread_position_in_grid]]) {
    if (i < count) values[i] = official_head_bf16_value(values[i]);
}


