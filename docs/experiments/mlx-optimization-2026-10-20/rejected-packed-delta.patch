+#include <metal_stdlib>
+#include "../activation/activations.h"
+#include "../common/defines.h"
+#include "../common/dsl.h"
+#include "../common/thread_context.h"
+#include "../common/threadgroup_reduce.h"
+
+using namespace metal;
+
+#define PACKED_UPDATE_THREADS 128
+#define PACKED_UPDATE_MAX_HEAD_V_DIM 128
+
+// A four-lane subgroup owns one value row. Each lane combines four-element
+// partials from eight original lanes, then two shuffles complete the row sum.
+static float packed_row_sum(thread const float* partials) {
+  float value = ((partials[0] + partials[1]) + (partials[2] + partials[3])) +
+                ((partials[4] + partials[5]) + (partials[6] + partials[7]));
+  value += simd_shuffle_xor(value, 1);
+  value += simd_shuffle_xor(value, 2);
+  return value;
+}
+
+template <typename T>
+static void packed_prepare_qk(
+    device const T* in_proj,
+    const uint hk,
+    const uint key_dim,
+    const uint lane,
+    threadgroup float* shared_q,
+    threadgroup float* shared_k,
+    threadgroup float* kq_dot
+) {
+  float q[4];
+  float k[4];
+  float q_sq = 0.0f;
+  float k_sq = 0.0f;
+  for (uint i = 0; i < 4; ++i) {
+    const uint dk = lane + METAL_SIMD_SIZE * i;
+    q[i] = float(in_proj[hk * 128 + dk]);
+    k[i] = float(in_proj[key_dim + hk * 128 + dk]);
+    q_sq += q[i] * q[i];
+    k_sq += k[i] * k[i];
+  }
+  const float q_inv_norm = rsqrt(simd_sum(q_sq) + 1e-6f);
+  const float k_inv_norm = rsqrt(simd_sum(k_sq) + 1e-6f);
+  const float q_scale = rsqrt(128.0f);
+  float kq_partial = 0.0f;
+  for (uint i = 0; i < 4; ++i) {
+    const uint dk = lane + METAL_SIMD_SIZE * i;
+    q[i] *= q_inv_norm * q_scale;
+    k[i] *= k_inv_norm;
+    shared_q[dk] = q[i];
+    shared_k[dk] = k[i];
+    kq_partial += q[i] * k[i];
+  }
+  const float value = simd_sum(kq_partial);
+  if (lane == 0) {
+    *kq_dot = value;
+  }
+}
+
+static float packed_update_row(
+    device float* state_row,
+    threadgroup const float* q,
+    threadgroup const float* k,
+    const uint row_lane,
+    const float value,
+    const float kq_dot,
+    const float beta,
+    const float decay
+) {
+  float sq[8];
+  float sk[8];
+  float s[32];
+  for (uint part = 0; part < 8; ++part) {
+    const uint original_lane = row_lane * 8 + part;
+    float sq_partial = 0.0f;
+    float sk_partial = 0.0f;
+    for (uint i = 0; i < 4; ++i) {
+      const uint dk = original_lane + METAL_SIMD_SIZE * i;
+      const uint e = part * 4 + i;
+      s[e] = state_row[dk];
+      sq_partial += s[e] * q[dk];
+      sk_partial += s[e] * k[dk];
+    }
+    sq[part] = sq_partial;
+    sk[part] = sk_partial;
+  }
+  const float sq_acc = packed_row_sum(sq);
+  const float sk_acc = packed_row_sum(sk);
+  const float delta = beta * (value - decay * sk_acc);
+  const float output = decay * sq_acc + delta * kq_dot;
+  for (uint part = 0; part < 8; ++part) {
+    const uint original_lane = row_lane * 8 + part;
+    for (uint i = 0; i < 4; ++i) {
+      const uint dk = original_lane + METAL_SIMD_SIZE * i;
+      state_row[dk] = decay * s[part * 4 + i] + k[dk] * delta;
+    }
+  }
+  return output;
+}
+
+template <typename T, uint HEAD_K_DIM>
+VARIANTS(T, float, bfloat)
+VARIANTS(HEAD_K_DIM, 128)
+PUBLIC KERNEL(DeltaNetUpdatePacked)(
+    device const T* in_proj,
+    device const float* a_log,
+    device const float* dt_bias,
+    device const float* norm_weight,
+    device float* state,
+    device T* out,
+    constant const uint& num_v_heads,
+    constant const uint& num_k_heads,
+    constant const uint& head_v_dim,
+    constant const uint& key_dim,
+    constant const uint& value_dim,
+    constant const float& norm_epsilon,
+    threadgroup float shared_q[HEAD_K_DIM],
+    threadgroup float shared_k[HEAD_K_DIM],
+    threadgroup float shared_controls[3],
+    threadgroup float shared_o[PACKED_UPDATE_MAX_HEAD_V_DIM],
+    threadgroup float shared_scratch[METAL_SIMD_SIZE],
+    const ThreadContext thread_context,
+    const uint hv_idx GROUPS(num_v_heads),
+    const uint tid THREADS(PACKED_UPDATE_THREADS)
+) {
+  static_assert(HEAD_K_DIM == 128, "packed decode requires Dk=128");
+  constexpr uint LANES_PER_ROW = 4;
+  constexpr uint ROWS_PER_GROUP = PACKED_UPDATE_THREADS / LANES_PER_ROW;
+  const uint lane = tid % METAL_SIMD_SIZE;
+  const uint row_lane = tid % LANES_PER_ROW;
+  const uint row_in_group = tid / LANES_PER_ROW;
+  const uint conv_dim = 2 * key_dim + value_dim;
+  const uint hk = hv_idx / (num_v_heads / num_k_heads);
+
+  // Prepare once per head using the original strided four-element partials.
+  if (tid < METAL_SIMD_SIZE) {
+    float q[4];
+    float k[4];
+    float q_sq = 0.0f;
+    float k_sq = 0.0f;
+    for (uint i = 0; i < 4; ++i) {
+      const uint dk = lane + METAL_SIMD_SIZE * i;
+      q[i] = float(in_proj[hk * HEAD_K_DIM + dk]);
+      k[i] = float(in_proj[key_dim + hk * HEAD_K_DIM + dk]);
+      q_sq += q[i] * q[i];
+      k_sq += k[i] * k[i];
+    }
+    const float q_inv_norm = rsqrt(simd_sum(q_sq) + 1e-6f);
+    const float k_inv_norm = rsqrt(simd_sum(k_sq) + 1e-6f);
+    const float q_scale = rsqrt(float(HEAD_K_DIM));
+    float kq_partial = 0.0f;
+    for (uint i = 0; i < 4; ++i) {
+      const uint dk = lane + METAL_SIMD_SIZE * i;
+      q[i] *= q_inv_norm * q_scale;
+      k[i] *= k_inv_norm;
+      shared_q[dk] = q[i];
+      shared_k[dk] = k[i];
+      kq_partial += q[i] * k[i];
+    }
+    const float kq_dot = simd_sum(kq_partial);
+    if (lane == 0) {
+      shared_controls[0] = kq_dot;
+      const float beta_raw = float(in_proj[conv_dim + value_dim + hv_idx]);
+      shared_controls[1] = 1.0f / (1.0f + fast::exp(-beta_raw));
+      const float a_raw = float(in_proj[conv_dim + value_dim + num_v_heads + hv_idx]);
+      const float sp = activate_softplus(a_raw + float(dt_bias[hv_idx]));
+      shared_controls[2] = fast::exp(-fast::exp(float(a_log[hv_idx])) * sp);
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+
+  const float kq_dot = shared_controls[0];
+  const float beta = shared_controls[1];
+  const float decay = shared_controls[2];
+  for (uint dv = row_in_group; dv < head_v_dim; dv += ROWS_PER_GROUP) {
+    const uint state_row = (hv_idx * head_v_dim + dv) * HEAD_K_DIM;
+    float sq[8];
+    float sk[8];
+    float s[32];
+    for (uint part = 0; part < 8; ++part) {
+      const uint original_lane = row_lane * 8 + part;
+      float sq_partial = 0.0f;
+      float sk_partial = 0.0f;
+      for (uint i = 0; i < 4; ++i) {
+        const uint dk = original_lane + METAL_SIMD_SIZE * i;
+        const uint e = part * 4 + i;
+        s[e] = state[state_row + dk];
+        sq_partial += s[e] * shared_q[dk];
+        sk_partial += s[e] * shared_k[dk];
+      }
+      sq[part] = sq_partial;
+      sk[part] = sk_partial;
+    }
+    const float sq_acc = packed_row_sum(sq);
+    const float sk_acc = packed_row_sum(sk);
+    const float v_i = float(in_proj[2 * key_dim + hv_idx * head_v_dim + dv]);
+    const float delta_i = beta * (v_i - decay * sk_acc);
+    const float o_i = decay * sq_acc + delta_i * kq_dot;
+    for (uint part = 0; part < 8; ++part) {
+      const uint original_lane = row_lane * 8 + part;
+      for (uint i = 0; i < 4; ++i) {
+        const uint dk = original_lane + METAL_SIMD_SIZE * i;
+        state[state_row + dk] = decay * s[part * 4 + i] + shared_k[dk] * delta_i;
+      }
+    }
+    if (row_lane == 0) {
+      shared_o[dv] = o_i;
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+
+  const float o = tid < head_v_dim ? shared_o[tid] : 0.0f;
+  const float o_sumsq = threadgroup_cooperative_reduce<SimdReduceSum<float>, PACKED_UPDATE_THREADS>(
+      o * o, shared_scratch, thread_context);
+  const float inv_rms = rsqrt(o_sumsq / float(head_v_dim) + norm_epsilon);
+  if (tid < head_v_dim) {
+    const float z = float(in_proj[conv_dim + hv_idx * head_v_dim + tid]);
+    out[hv_idx * head_v_dim + tid] = static_cast<T>(o * inv_rms * norm_weight[tid] * activate_silu(z));
+  }
+}
+
+// The split route exposes eight independent row groups per head to the GPU.
+// Keep the intermediate in float: rounding it to T before RMSNorm would change
+// the fused decode contract for BF16 models.
+template <typename T, uint HEAD_K_DIM>
+VARIANTS(T, float, bfloat)
+VARIANTS(HEAD_K_DIM, 128)
+PUBLIC KERNEL(DeltaNetUpdatePackedRows)(
+    device const T* in_proj,
+    device const float* a_log,
+    device const float* dt_bias,
+    device float* state,
+    device float* out,
+    constant const uint& num_v_heads,
+    constant const uint& num_k_heads,
+    constant const uint& head_v_dim,
+    constant const uint& key_dim,
+    constant const uint& value_dim,
+    threadgroup float shared_q[HEAD_K_DIM],
+    threadgroup float shared_k[HEAD_K_DIM],
+    threadgroup float shared_kq[1],
+    const uint hv_idx GROUPS(num_v_heads),
+    const uint dv_group GROUPS((head_v_dim + 15u) / 16u),
+    const uint tid THREADS(64)
+) {
+  static_assert(HEAD_K_DIM == 128, "packed decode requires Dk=128");
+  const uint lane = tid % METAL_SIMD_SIZE;
+  const uint hk = hv_idx / (num_v_heads / num_k_heads);
+  if (tid < METAL_SIMD_SIZE) {
+    packed_prepare_qk(in_proj, hk, key_dim, lane, shared_q, shared_k, shared_kq);
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  const uint dv = dv_group * 16 + tid / 4;
+  if (dv >= head_v_dim) {
+    return;
+  }
+  const uint conv_dim = 2 * key_dim + value_dim;
+  const float beta_raw = float(in_proj[conv_dim + value_dim + hv_idx]);
+  const float beta = 1.0f / (1.0f + fast::exp(-beta_raw));
+  const float a_raw = float(in_proj[conv_dim + value_dim + num_v_heads + hv_idx]);
+  const float sp = activate_softplus(a_raw + dt_bias[hv_idx]);
+  const float decay = fast::exp(-fast::exp(a_log[hv_idx]) * sp);
+  const float value = float(in_proj[2 * key_dim + hv_idx * head_v_dim + dv]);
+  const float output = packed_update_row(
+      state + (hv_idx * head_v_dim + dv) * HEAD_K_DIM,
+      shared_q, shared_k, tid % 4, value, shared_kq[0], beta, decay);
+  if (tid % 4 == 0) {
+    out[hv_idx * head_v_dim + dv] = output;
+  }
+}
+
+template <typename T>
+VARIANTS(T, float, bfloat)
+PUBLIC KERNEL(DeltaNetUpdatePackedNormGate)(
+    device const float* raw,
+    device const T* in_proj,
+    device const float* norm_weight,
+    device T* out,
+    constant const uint& num_v_heads,
+    constant const uint& head_v_dim,
+    constant const uint& value_dim,
+    constant const uint& conv_dim,
+    constant const float& norm_epsilon,
+    threadgroup float shared_scratch[METAL_SIMD_SIZE],
+    const ThreadContext thread_context,
+    const uint hv_idx GROUPS(num_v_heads),
+    const uint tid THREADS(128)
+) {
+  const float value = tid < head_v_dim ? raw[hv_idx * head_v_dim + tid] : 0.0f;
+  const float sumsq = threadgroup_cooperative_reduce<SimdReduceSum<float>, 128>(
+      value * value, shared_scratch, thread_context);
+  if (tid < head_v_dim) {
+    const float inv_rms = rsqrt(sumsq / float(head_v_dim) + norm_epsilon);
+    const float z = float(in_proj[conv_dim + hv_idx * head_v_dim + tid]);
+    out[hv_idx * head_v_dim + tid] = static_cast<T>(value * inv_rms * norm_weight[tid] * activate_silu(z));
+  }
+}
