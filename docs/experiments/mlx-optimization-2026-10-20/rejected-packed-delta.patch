+use std::time::Duration;
+
+use half::bf16;
+use stark_engine_macros::stark_test;
+
+use crate::{
+    array::ArrayElement,
+    backends::{
+        common::{
+            Backend, CommandBufferCompleted, CommandBufferEncoding, CommandBufferExecutable, CommandBufferPending,
+            Context, Kernels,
+            kernel::{
+                DeltaNetUpdateKernel, DeltaNetUpdatePackedKernel, DeltaNetUpdatePackedNormGateKernel,
+                DeltaNetUpdatePackedRowsKernel,
+            },
+        },
+        cpu::Cpu,
+    },
+    tests::helpers::{buffer_to_vec, create_buffer, create_buffer_with_data, for_each_backend},
+};
+
+#[derive(Clone, Copy, Debug)]
+enum Variant {
+    Reference,
+    Packed,
+    Split,
+}
+
+fn run<B: Backend, T: ArrayElement>(
+    heads: u32,
+    key_heads: u32,
+    variant: Variant,
+    steps: usize,
+) -> (Vec<f32>, Vec<f32>, Duration) {
+    let context = B::Context::new().expect("context");
+    let key_dim = key_heads * 128;
+    let value_dim = heads * 128;
+    let conv_dim = 2 * key_dim + value_dim;
+    let projection_dim = conv_dim + value_dim + 2 * heads;
+    let mut projection: Vec<f32> = (0..projection_dim).map(|i| (i % 43) as f32 * 0.025 - 0.51).collect();
+    for head in 0..heads {
+        projection[(conv_dim + value_dim + head) as usize] = [-12.0, 0.0, 12.0][head as usize % 3];
+    }
+    let projection: Vec<T> =
+        projection.into_iter().map(|x| <T as num_traits::NumCast>::from(x).expect("activation")).collect();
+    let a: Vec<f32> = (0..heads).map(|i| [-5.0, -1.5, 1.0][i as usize % 3]).collect();
+    let bias: Vec<f32> = (0..heads).map(|i| (i % 7) as f32 * 0.1 - 0.3).collect();
+    let weights: Vec<f32> = (0..128).map(|i| 0.8 + i as f32 * 0.001).collect();
+    let initial: Vec<f32> = (0..heads * 128 * 128).map(|i| (i % 29) as f32 * 0.005 - 0.05).collect();
+    let projection = create_buffer_with_data::<B, T>(&context, &projection);
+    let a = create_buffer_with_data::<B, f32>(&context, &a);
+    let bias = create_buffer_with_data::<B, f32>(&context, &bias);
+    let weights = create_buffer_with_data::<B, f32>(&context, &weights);
+    let mut state = create_buffer_with_data::<B, f32>(&context, &initial);
+    let mut output = create_buffer::<B, T>(&context, value_dim as usize);
+    let mut raw = create_buffer::<B, f32>(&context, value_dim as usize);
+    let reference = <B::Kernels as Kernels>::DeltaNetUpdateKernel::new(&context, T::data_type(), 128).unwrap();
+    let packed = <B::Kernels as Kernels>::DeltaNetUpdatePackedKernel::new(&context, T::data_type(), 128).unwrap();
+    let rows = <B::Kernels as Kernels>::DeltaNetUpdatePackedRowsKernel::new(&context, T::data_type(), 128).unwrap();
+    let norm = <B::Kernels as Kernels>::DeltaNetUpdatePackedNormGateKernel::new(&context, T::data_type()).unwrap();
+    let mut command = context.create_command_buffer(None, None).unwrap();
+    for _ in 0..steps {
+        match variant {
+            Variant::Reference => reference.encode(
+                &projection,
+                &a,
+                &bias,
+                &weights,
+                &mut state,
+                &mut output,
+                heads,
+                key_heads,
+                128,
+                key_dim,
+                value_dim,
+                1e-6,
+                &mut command,
+            ),
+            Variant::Packed => packed.encode(
+                &projection,
+                &a,
+                &bias,
+                &weights,
+                &mut state,
+                &mut output,
+                heads,
+                key_heads,
+                128,
+                key_dim,
+                value_dim,
+                1e-6,
+                &mut command,
+            ),
+            Variant::Split => {
+                rows.encode(
+                    &projection,
+                    &a,
+                    &bias,
+                    &mut state,
+                    &mut raw,
+                    heads,
+                    key_heads,
+                    128,
+                    key_dim,
+                    value_dim,
+                    &mut command,
+                );
+                norm.encode(
+                    &raw,
+                    &projection,
+                    &weights,
+                    &mut output,
+                    heads,
+                    128,
+                    value_dim,
+                    conv_dim,
+                    1e-6,
+                    &mut command,
+                );
+            },
+        }
+    }
+    let complete = command.end_encoding().submit().wait_until_completed().unwrap();
+    let duration = complete.gpu_execution_time();
+    let output = buffer_to_vec::<B, T>(&output).into_iter().map(|x| x.to_f32().expect("output")).collect();
+    (output, buffer_to_vec::<B, f32>(&state), duration)
+}
+
+fn check<T: ArrayElement>(
+    heads: u32,
+    key_heads: u32,
+    steps: usize,
+    output_atol: f32,
+    output_rtol: f32,
+) {
+    let (reference, reference_state, _) = run::<Cpu, T>(heads, key_heads, Variant::Reference, steps);
+    for_each_backend!(|B| {
+        for variant in [Variant::Packed, Variant::Split] {
+            let (output, state, _) = run::<B, T>(heads, key_heads, variant, steps);
+            assert!(output.iter().chain(&state).all(|value| value.is_finite()), "nonfinite packed update");
+            assert!(
+                is_close::default()
+                    .abs_tol(output_atol)
+                    .rel_tol(output_rtol)
+                    .all_close(reference.iter().copied(), output.iter().copied()),
+                "packed output mismatch: {variant:?}, heads={heads}, key_heads={key_heads}, steps={steps}"
+            );
+            assert!(
+                is_close::default()
+                    .abs_tol(1e-4)
+                    .rel_tol(1e-3)
+                    .all_close(reference_state.iter().copied(), state.iter().copied()),
+                "packed state mismatch: {variant:?}, heads={heads}, key_heads={key_heads}, steps={steps}"
+            );
+        }
+    });
+}
+
+#[stark_test]
+fn test_delta_net_update_packed_f32() {
+    for (heads, key_heads) in [(16, 16), (48, 16)] {
+        for steps in [1, 16] {
+            check::<f32>(heads, key_heads, steps, 1e-3, 1e-2);
+        }
+    }
+}
+
+#[stark_test]
+fn test_delta_net_update_packed_bf16() {
+    for (heads, key_heads) in [(16, 16), (48, 16)] {
+        for steps in [1, 16] {
+            check::<bf16>(heads, key_heads, steps, 2e-2, 5e-2);
+        }
+    }
+}
+
+#[cfg(backend = "metal")]
+#[stark_test]
+#[ignore]
+fn benchmark_delta_net_update_packed_gpu_time() {
+    use crate::backends::metal::Metal;
+
+    for heads in [16, 48] {
+        let variants = [Variant::Reference, Variant::Packed, Variant::Split];
+        for variant in variants {
+            let _ = run::<Metal, bf16>(heads, 16, variant, 16);
+        }
+        let mut timings: [Vec<f64>; 3] = std::array::from_fn(|_| Vec::new());
+        for block in 0..6 {
+            let order = if block % 2 == 0 {
+                [0, 1, 2]
+            } else {
+                [2, 1, 0]
+            };
+            for index in order {
+                let (_, _, duration) = run::<Metal, bf16>(heads, 16, variants[index], 256);
+                timings[index].push(duration.as_secs_f64() * 1e6 / 256.0);
+            }
+        }
+        for (index, mut values) in timings.into_iter().enumerate() {
+            values.sort_by(f64::total_cmp);
+            eprintln!(
+                "GDN update GPU aggregate: heads={heads}, key_heads=16, dtype=BF16, variant={:?}, samples={}, updates_per_sample=256, median_us={:.6}, min_us={:.6}, max_us={:.6}",
+                variants[index],
+                values.len(),
+                (values[2] + values[3]) * 0.5,
+                values[0],
+                values[5]
+            );
+        }
+    }
+}
