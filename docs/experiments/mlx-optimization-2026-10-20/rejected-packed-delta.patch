+use half::bf16;
+use num_traits::Float;
+use stark_engine_macros::kernel;
+
+use crate::array::ArrayElement;
+
+// CPU reference remains independent of the Metal lane packing.
+#[kernel(DeltaNetUpdatePacked)]
+#[variants(T, f32, bf16)]
+#[variants(HEAD_K_DIM, 128)]
+pub fn delta_net_update_packed<T: ArrayElement + Float, const HEAD_K_DIM: u32>(
+    in_proj: *const T,
+    a_log: *const f32,
+    dt_bias: *const f32,
+    norm_weight: *const f32,
+    state: *mut f32,
+    out: *mut T,
+    num_v_heads: u32,
+    num_k_heads: u32,
+    head_v_dim: u32,
+    key_dim: u32,
+    value_dim: u32,
+    norm_epsilon: f32,
+) {
+    super::update::delta_net_update::<T, HEAD_K_DIM>(
+        in_proj,
+        a_log,
+        dt_bias,
+        norm_weight,
+        state,
+        out,
+        num_v_heads,
+        num_k_heads,
+        head_v_dim,
+        key_dim,
+        value_dim,
+        norm_epsilon,
+    );
+}
+
+#[kernel(DeltaNetUpdatePackedRows)]
+#[variants(T, f32, bf16)]
+#[variants(HEAD_K_DIM, 128)]
+pub fn delta_net_update_packed_rows<T: ArrayElement + Float, const HEAD_K_DIM: u32>(
+    in_proj: *const T,
+    a_log: *const f32,
+    dt_bias: *const f32,
+    state: *mut f32,
+    out: *mut f32,
+    num_v_heads: u32,
+    num_k_heads: u32,
+    head_v_dim: u32,
+    key_dim: u32,
+    value_dim: u32,
+) {
+    let d = HEAD_K_DIM as usize;
+    let dv = head_v_dim as usize;
+    let key_dim = key_dim as usize;
+    let value_dim = value_dim as usize;
+    let conv_dim = 2 * key_dim + value_dim;
+    for hv in 0..num_v_heads as usize {
+        let hk = hv / (num_v_heads / num_k_heads) as usize;
+        let mut q = vec![0.0f32; d];
+        let mut k = vec![0.0f32; d];
+        for j in 0..d {
+            q[j] = unsafe { (*in_proj.add(hk * d + j)).to_f32().unwrap() };
+            k[j] = unsafe { (*in_proj.add(key_dim + hk * d + j)).to_f32().unwrap() };
+        }
+        let q_scale = 1.0 / (q.iter().map(|x| x * x).sum::<f32>() + 1e-6).sqrt() / (d as f32).sqrt();
+        let k_scale = 1.0 / (k.iter().map(|x| x * x).sum::<f32>() + 1e-6).sqrt();
+        for j in 0..d {
+            q[j] *= q_scale;
+            k[j] *= k_scale;
+        }
+        let kq = q.iter().zip(&k).map(|(q, k)| q * k).sum::<f32>();
+        let beta_raw = unsafe { (*in_proj.add(conv_dim + value_dim + hv)).to_f32().unwrap() };
+        let beta = 1.0 / (1.0 + (-beta_raw).exp());
+        let a = unsafe { (*in_proj.add(conv_dim + value_dim + num_v_heads as usize + hv)).to_f32().unwrap() };
+        let bias = unsafe { *dt_bias.add(hv) };
+        let x = a + bias;
+        let softplus = if x > 20.0 {
+            x
+        } else {
+            x.exp().ln_1p()
+        };
+        let decay = (-unsafe { *a_log.add(hv) }.exp() * softplus).exp();
+        for i in 0..dv {
+            let base = (hv * dv + i) * d;
+            let mut sq = 0.0;
+            let mut sk = 0.0;
+            for j in 0..d {
+                let s = unsafe { *state.add(base + j) };
+                sq += s * q[j];
+                sk += s * k[j];
+            }
+            let value = unsafe { (*in_proj.add(2 * key_dim + hv * dv + i)).to_f32().unwrap() };
+            let delta = beta * (value - decay * sk);
+            unsafe { *out.add(hv * dv + i) = decay * sq + delta * kq };
+            for j in 0..d {
+                unsafe { *state.add(base + j) = decay * *state.add(base + j) + k[j] * delta };
+            }
+        }
+    }
+}
+
+#[kernel(DeltaNetUpdatePackedNormGate)]
+#[variants(T, f32, bf16)]
+pub fn delta_net_update_packed_norm_gate<T: ArrayElement + Float>(
+    raw: *const f32,
+    in_proj: *const T,
+    norm_weight: *const f32,
+    out: *mut T,
+    num_v_heads: u32,
+    head_v_dim: u32,
+    value_dim: u32,
+    conv_dim: u32,
+    norm_epsilon: f32,
+) {
+    for hv in 0..num_v_heads as usize {
+        let base = hv * head_v_dim as usize;
+        let values = unsafe { std::slice::from_raw_parts(raw.add(base), head_v_dim as usize) };
+        let inv_rms = 1.0 / (values.iter().map(|x| x * x).sum::<f32>() / head_v_dim as f32 + norm_epsilon).sqrt();
+        for (i, value) in values.iter().copied().enumerate() {
+            let z = unsafe { (*in_proj.add(conv_dim as usize + base + i)).to_f32().unwrap() };
+            let weight = unsafe { *norm_weight.add(i) };
+            let result = value * inv_rms * weight * z / (1.0 + (-z).exp());
+            unsafe { *out.add(base + i) = <T as num_traits::NumCast>::from(result).unwrap() };
+        }
+    }
+    let _ = value_dim;
+}
