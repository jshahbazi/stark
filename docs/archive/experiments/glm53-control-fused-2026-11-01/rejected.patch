 GLM_CONTROL_MIX_PARTS(glm_control_mix_split32_simd, 32)
+
+struct GlmFusedControlParameters {
+    GlmControlParameters control;
+    float rms_epsilon;
+    uint chunks;
+};
+
+// The first SIMD group retains the existing Sinkhorn chronology. After its
+// device writes become visible, all eight groups retain the ordinary RMS
+// lane, SIMD, and group reduction order. No cross-group scheduling is needed.
+kernel void glm_control_mix_input_rms(
+    device const float *projection [[buffer(0)]], device const float *coefficients [[buffer(1)]],
+    device const float *residual [[buffer(2)]], device const float *normalization [[buffer(3)]],
+    device float *mix [[buffer(4)]], device float *input [[buffer(5)]],
+    device float *output [[buffer(6)]], constant GlmFusedControlParameters &p [[buffer(7)]],
+    device atomic_uint *failure [[buffer(8)]], uint tid [[thread_index_in_threadgroup]],
+    uint lane [[thread_index_in_simdgroup]], uint sg [[simdgroup_index_in_threadgroup]]) {
+    if (sg == 0)
+        glm_control_mix_one_simd(projection, coefficients, mix, p.control, failure, lane, p.chunks);
+    threadgroup_barrier(mem_flags::mem_device | mem_flags::mem_threadgroup);
+    float sum = 0.0f;
+    for (uint d = tid; d < p.control.hidden; d += 256) {
+        float value = 0.0f;
+        for (uint stream = 0; stream < p.control.streams; ++stream)
+            value += mix[stream] * residual[stream * p.control.hidden + d];
+        input[d] = value;
+        if (!isfinite(value)) atomic_fetch_or_explicit(failure, 1u, memory_order_relaxed);
+        sum += value * value;
+    }
+    threadgroup float partial[8];
+    threadgroup float scale;
+    float total = simd_sum(sum);
+    if (lane == 0) partial[sg] = total;
+    threadgroup_barrier(mem_flags::mem_device | mem_flags::mem_threadgroup);
+    if (sg == 0) {
+        total = simd_sum(lane < 8 ? partial[lane] : 0.0f);
+        if (lane == 0) scale = 1.0f / sqrt(total / float(p.control.hidden) + p.rms_epsilon);
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (uint d = tid; d < p.control.hidden; d += 256) {
+        float weight = normalization[d];
+        float value = input[d] * scale * weight;
+        if (!isfinite(weight) || !isfinite(value)) atomic_fetch_or_explicit(failure, 1u, memory_order_relaxed);
+        output[d] = value;
+    }
+}
