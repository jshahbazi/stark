+// SPDX-License-Identifier: Apache-2.0
+//! Aggregate-only test instrumentation. Disabled TLS fast path does not read
+//! clocks/counters or allocate. Warm head rows alone activate the counters.
+
+use std::{
+    cell::{Cell, RefCell},
+    time::Instant,
+};
+
+pub(in crate::engine::hybrid) const SCHEMA: &str = "v7b_warm_decode_fixed_prefix_cache_policy_bound";
+pub(in crate::engine::hybrid) const KEYS: [&str; 17] = [
+    "head_total_inclusive",
+    "prepare",
+    "norm_mla_encode",
+    "norm_mla_wait_readback",
+    "projection_blocking",
+    "cpu_router",
+    "selected_mapping_admission",
+    "mapped_ffn_compute_wait",
+    "final_readout_encode",
+    "final_readout_wait_readback",
+    "validation_observe",
+    "selected_owner_release",
+    "autorelease_drain",
+    "projection_submit_return_inclusive",
+    "ffn_submit_return_inclusive",
+    "ffn_commit_call_inclusive",
+    "ffn_wait_return_inclusive",
+];
+
+#[repr(usize)]
+#[derive(Clone, Copy)]
+pub(in crate::engine::hybrid) enum Phase {
+    Total,
+    Prepare,
+    NormMlaEncode,
+    NormMlaWait,
+    Projection,
+    Router,
+    Mapping,
+    Ffn,
+    ReadoutEncode,
+    ReadoutWait,
+    Observe,
+    Release,
+    Autorelease,
+    ProjectionFence,
+    FfnFence,
+    FfnCommit,
+    FfnWait,
+}
+
+struct Stats {
+    wall: [f64; 17],
+    gpu: [f64; 17],
+    calls: [usize; 17],
+}
+impl Default for Stats {
+    fn default() -> Self {
+        Self {
+            wall: [0.0; 17],
+            gpu: [0.0; 17],
+            calls: [0; 17],
+        }
+    }
+}
+
+thread_local! {
+    static ACTIVE: Cell<bool> = const { Cell::new(false) };
+    static STATS: RefCell<Stats> = RefCell::new(Stats::default());
+    static IN_HEAD: Cell<bool> = const { Cell::new(false) };
+    static FFN_POLL: Cell<bool> = const { Cell::new(false) };
+}
+
+pub(in crate::engine::hybrid) fn configure_ffn_poll(enabled: bool) {
+    FFN_POLL.with(|value| value.set(enabled));
+}
+
+pub(in crate::engine::hybrid) fn ffn_policy_name() -> &'static str {
+    if FFN_POLL.with(Cell::get) {
+        "status_poll_then_final_wait"
+    } else {
+        "blocking_final_wait"
+    }
+}
+
+pub(in crate::engine::hybrid) fn poll_head_ffn() -> bool {
+    IN_HEAD.with(Cell::get) && FFN_POLL.with(Cell::get)
+}
+
+pub(in crate::engine::hybrid) struct HeadScope(bool);
+
+pub(in crate::engine::hybrid) fn enter_head() -> HeadScope {
+    HeadScope(IN_HEAD.with(|inside| inside.replace(true)))
+}
+
+impl Drop for HeadScope {
+    fn drop(&mut self) {
+        IN_HEAD.with(|inside| inside.set(self.0));
+    }
+}
+
+pub(in crate::engine::hybrid) fn reset() {
+    ACTIVE.with(|active| active.set(false));
+    STATS.with(|stats| *stats.borrow_mut() = Stats::default());
+}
+
+pub(in crate::engine::hybrid) fn is_active() -> bool {
+    ACTIVE.with(Cell::get)
+}
+
+pub(in crate::engine::hybrid) fn active(value: bool) {
+    ACTIVE.with(|active| active.set(value));
+}
+
+pub(in crate::engine::hybrid) struct Span(Option<(Phase, Instant, f64)>);
+
+pub(in crate::engine::hybrid) fn phase(phase: Phase) -> Span {
+    if !ACTIVE.with(Cell::get) {
+        return Span(None);
+    }
+    let gpu = crate::engine::hybrid::profile::native_gpu_seconds_for_test();
+    Span(Some((phase, Instant::now(), gpu)))
+}
+
+impl Drop for Span {
+    fn drop(&mut self) {
+        if let Some((phase, started, gpu_before)) = self.0.take() {
+            let wall = started.elapsed().as_secs_f64() * 1000.0;
+            let gpu = (crate::engine::hybrid::profile::native_gpu_seconds_for_test() - gpu_before) * 1000.0;
+            STATS.with(|stats| {
+                let mut stats = stats.borrow_mut();
+                let slot = phase as usize;
+                stats.wall[slot] += wall;
+                stats.gpu[slot] += gpu;
+                stats.calls[slot] += 1;
+            });
+        }
+    }
+}
+
+pub(in crate::engine::hybrid) fn snapshot() -> (serde_json::Value, serde_json::Value, serde_json::Value) {
+    STATS.with(|stats| {
+        let stats = stats.borrow();
+        let mut wall = serde_json::Map::new();
+        let mut gpu = serde_json::Map::new();
+        let mut calls = serde_json::Map::new();
+        for (index, key) in KEYS.into_iter().enumerate() {
+            wall.insert(key.to_owned(), serde_json::json!(stats.wall[index]));
+            gpu.insert(key.to_owned(), serde_json::json!(stats.gpu[index]));
+            calls.insert(key.to_owned(), serde_json::json!(stats.calls[index]));
+        }
+        (wall.into(), gpu.into(), calls.into())
+    })
+}
+
+#[stark_engine_macros::stark_test]
+fn mtp_ffn_poll_policy_is_head_scoped_and_restored_on_error() {
+    configure_ffn_poll(true);
+    assert!(!poll_head_ffn(), "test FFN policy escaped its head scope");
+    {
+        let _outer = enter_head();
+        assert!(poll_head_ffn(), "test FFN policy missing in head");
+        {
+            let _inner = enter_head();
+            assert!(poll_head_ffn(), "nested head policy");
+        }
+        assert!(poll_head_ffn(), "nested head scope failed to restore outer policy");
+    }
+    let fail = || -> Result<(), ()> {
+        let _head = enter_head();
+        Err(())
+    };
+    assert!(fail().is_err(), "simulated head failure");
+    assert!(!poll_head_ffn(), "head error leaked test FFN policy");
+    configure_ffn_poll(false);
+    let _head = enter_head();
+    assert!(!poll_head_ffn(), "blocking test policy unexpectedly polls");
+}
