+}
+
+fn require_equal_ffn_rows(
+    first: &[f32],
+    repeat: &[f32],
+) -> Result<()> {
+    if first.len() != 4096
+        || repeat.len() != 4096
+        || first.iter().zip(repeat).any(|(a, b)| !a.is_finite() || !b.is_finite() || a.to_bits() != b.to_bits())
+    {
+        return Err(Error::Invalid("MTP prefix cached FFN output mismatch"));
+    }
+    Ok(())
+}
+
+impl Weights {
+    fn mtp_prefix_snapshot(&self) -> Result<PrefixSeal> {
+        let cache = self.static_views.lock().map_err(|_| Error::Invalid("MTP prefix static cache lock"))?;
+        let residency = self.encoder_residency.lock().map_err(|_| Error::Invalid("MTP prefix residency lock"))?;
+        let r = residency.as_ref().ok_or(Error::Invalid("MTP prefix requires residency"))?;
+        let driver = r.driver.lock().map_err(|_| Error::Invalid("MTP prefix driver lock"))?;
+        if cache.limit != MAX_STATIC_VIEW_BYTES || r.static_reserve != MAX_STATIC_VIEW_BYTES || r.failed {
+            return Err(Error::Invalid("MTP prefix static policy"));
+        }
+        Ok(PrefixSeal {
+            keys: cache.entries.keys().copied().collect(),
+            registered_bytes: cache.registered_bytes,
+            resident_static_bytes: r.static_bytes,
+            resident_buffers: r.buffers.len(),
+            residency_allocated_bytes: usize::try_from(driver.set.allocated_size())
+                .map_err(|_| Error::Invalid("MTP prefix allocated size"))?,
+            mapping_owners: self.files.iter().map(Arc::strong_count).collect(),
+        })
+    }
+
+    fn mtp_prefix_check(
+        &self,
+        receipt: &Receipt,
+    ) -> Result<()> {
+        let Some(seal) = &receipt.prefix_seal else {
+            return Ok(());
+        };
+        let cache = self.static_views.lock().map_err(|_| Error::Invalid("MTP prefix static cache lock"))?;
+        let residency = self.encoder_residency.lock().map_err(|_| Error::Invalid("MTP prefix residency lock"))?;
+        let r = residency.as_ref().ok_or(Error::Invalid("MTP prefix requires residency"))?;
+        let driver = r.driver.lock().map_err(|_| Error::Invalid("MTP prefix driver lock"))?;
+        if cache.entries.len() != seal.keys.len()
+            || cache.registered_bytes != seal.registered_bytes
+            || cache.entries.keys().any(|key| !seal.keys.contains(key))
+            || r.static_bytes != seal.resident_static_bytes
+            || r.buffers.len() != seal.resident_buffers
+            || usize::try_from(driver.set.allocated_size()).ok() != Some(seal.residency_allocated_bytes)
+            || r.failed
+        {
+            return Err(Error::Invalid("MTP prefix static inventory changed after preload"));
+        }
+        Ok(())
+    }
+
+    /// Preflight the complete fixed inventory before creating any Metal view.
+    /// Cache -> residency -> driver lock order matches metal_view registration.
+    pub(in crate::engine::hybrid) fn mtp_probe_prebind_prefix(
+        &self,
+        prefix: usize,
+        extra: usize,
+        receipt: &mut Receipt,
+    ) -> Result<()> {
+        if !matches!(prefix, 0 | PREFIX_EXPERTS) || receipt.prefix_seal.is_some() || extra != 75_439_104 {
+            return Err(Error::Invalid("MTP prefix configuration"));
+        }
+        self.mtp_probe_selected_mode()?;
+        self.mtp_probe_observe(extra, receipt)?;
+        let started = std::time::Instant::now();
+        let base = self.mtp_prefix_snapshot()?;
+        if base.registered_bytes != BASE_STATIC_BYTES || base.keys.len() != BASE_STATIC_ENTRIES {
+            return Err(Error::Invalid("MTP prefix requires complete static warmup"));
+        }
+        let mut plan = Vec::with_capacity(3 * prefix);
+        let mut added = 0usize;
+        let mut planned_keys = HashSet::new();
+        for (name, kind, rows, columns) in GEOMETRIES {
+            let t = self.tensor(name)?;
+            if t.kind != kind || t.shape != [288, rows, columns] || t.affine.is_some() {
+                return Err(Error::Invalid("MTP prefix tensor contract"));
+            }
+            let plane =
+                rows.checked_mul(encoded_size(kind, columns)?).ok_or(Error::Invalid("MTP prefix plane size"))?;
+            for index in 0..prefix {
+                let offset = index
+                    .checked_mul(plane)
+                    .and_then(|n| t.offset.checked_add(n))
+                    .ok_or(Error::Invalid("MTP prefix offset overflow"))?;
+                let key = StaticViewKey {
+                    file: t.file,
+                    offset,
+                    length: plane,
+                };
+                if base.keys.contains(&key) || !planned_keys.insert(key) {
+                    return Err(Error::Invalid("MTP prefix duplicate cache key"));
+                }
+                let span = self.files[t.file].metal_span(offset, plane)?.1;
+                added = added.checked_add(span).ok_or(Error::Invalid("MTP prefix span overflow"))?;
+                plan.push((name, index, rows, columns, key, span));
+            }
+        }
+        if plan.len() != 3 * prefix || added > PREFIX_REGISTERED_MAX {
+            return Err(Error::Invalid("MTP prefix planned inventory"));
+        }
+        {
+            let cache = self.static_views.lock().map_err(|_| Error::Invalid("MTP prefix static cache lock"))?;
+            let residency = self.encoder_residency.lock().map_err(|_| Error::Invalid("MTP prefix residency lock"))?;
+            let r = residency.as_ref().ok_or(Error::Invalid("MTP prefix requires residency"))?;
+            let driver = r.driver.lock().map_err(|_| Error::Invalid("MTP prefix driver lock"))?;
+            let allocated = usize::try_from(driver.set.allocated_size())
+                .map_err(|_| Error::Invalid("MTP prefix allocated size"))?;
+            let ledger = PrefixLedger {
+                cache_bytes: cache.registered_bytes,
+                cache_entries: cache.entries.len(),
+                static_bytes: r.static_bytes,
+                bank_bytes: r.bank_bytes,
+                allocated_bytes: allocated,
+                dynamic: r.dynamic_allowance,
+                reserve: r.static_reserve,
+                cap: r.cap,
+                extra,
+            };
+            admit_prefix(&ledger, added, plan.len())?;
+            let next_static = r.static_bytes.checked_add(added).ok_or(Error::Invalid("MTP prefix static overflow"))?;
+            let next_allocated =
+                allocated.checked_add(added).ok_or(Error::Invalid("MTP prefix allocation overflow"))?;
+            if r.required(r.bank_bytes, next_static, next_allocated)?.checked_add(extra).is_none_or(|n| n > r.cap)
+                || cache.entries.len() != base.keys.len()
+                || cache.entries.keys().any(|key| !base.keys.contains(key))
+                || cache.registered_bytes != base.registered_bytes
+                || r.static_bytes != base.resident_static_bytes
+                || allocated != base.residency_allocated_bytes
+            {
+                return Err(Error::Invalid("MTP prefix preflight ledger changed"));
+            }
+        }
+        receipt.prefix.base_static_registered_bytes = base.registered_bytes;
+        receipt.prefix.base_resident_static_bytes = base.resident_static_bytes;
+        receipt.prefix.base_static_entries = base.keys.len();
+        receipt.prefix.base_residency_allocated_bytes = base.residency_allocated_bytes;
+        let mut expected_keys = base.keys;
+        let mut expected_bytes = base.registered_bytes;
+        for (name, index, rows, columns, key, span) in plan {
+            let view = self.mapped_matrix(self.tensor(name)?, index, rows, columns, true)?;
+            if view.codes.registered_bytes() != span {
+                return Err(Error::Invalid("MTP prefix mapped span changed"));
+            }
+            drop(view);
+            expected_keys.insert(key);
+            expected_bytes += span;
+            let actual = self.mtp_prefix_snapshot()?;
+            if actual.keys != expected_keys || actual.registered_bytes != expected_bytes {
+                return Err(Error::Invalid("MTP prefix preload evicted or changed cache"));
+            }
+            // Includes the original selected/cache allowance above ACTUAL
+            // driver-required bytes after every admitted insertion.
+            self.mtp_probe_observe(extra, receipt)?;
+        }
+        let seal = self.mtp_prefix_snapshot()?;
+        if seal.registered_bytes != expected_bytes
+            || seal.keys != expected_keys
+            || seal.registered_bytes > BASE_STATIC_BYTES + PREFIX_REGISTERED_MAX
+            || seal.resident_buffers != base.resident_buffers + 3 * prefix
+            || seal.resident_static_bytes < base.resident_static_bytes + added
+        {
+            return Err(Error::Invalid("MTP prefix final inventory"));
+        }
+        receipt.prefix.prefix_experts = prefix;
+        receipt.prefix.prebound_views = seal.resident_buffers - base.resident_buffers;
+        receipt.prefix.prebound_registered_bytes = added;
+        receipt.prefix.static_registered_after_bytes = seal.registered_bytes;
+        receipt.prefix.resident_static_after_bytes = seal.resident_static_bytes;
+        receipt.prefix.residency_allocated_after_bytes = seal.residency_allocated_bytes;
+        receipt.prefix.preload_wall_ms = started.elapsed().as_secs_f64() * 1000.0;
+        receipt.prefix_seal = Some(seal);
+        self.mtp_probe_observe(extra, receipt)
+    }
+    /// Fail before a selected view can enter bank_view's promotion branch.
+    fn mtp_probe_selected_mode(&self) -> Result<()> {
+        let cache = self.bank_views.lock().map_err(|_| Error::Invalid("MTP bank cache lock"))?;
+        if cache.limit != 0 || cache.registered_bytes != 0 || !cache.entries.is_empty() {
+            return Err(Error::Invalid("MTP requires uncached selected ranges"));
+        }
+        Ok(())
+    }
+
+    /// Reserve selected planes and one independent draft cache above the
+    /// unchanged trunk/static/dynamic reservation. No new resident bank names.
+    pub(in crate::engine::hybrid) fn mtp_probe_observe(
+        &self,
+        extra: usize,
+        receipt: &mut Receipt,
+    ) -> Result<()> {
+        let _profile = phase(Phase::Observe);
+        self.mtp_probe_selected_mode()?;
+        let guard = self.encoder_residency.lock().map_err(|_| Error::Invalid("MTP residency lock"))?;
+        let r = guard.as_ref().ok_or(Error::Invalid("MTP requires existing residency admission"))?;
+        if r.failed || r.names.iter().any(|n| n.starts_with("blk.45.")) {
+            return Err(Error::Invalid("MTP must not enter resident trunk inventory"));
+        }
+        let names = r.names.iter().cloned().collect::<Vec<_>>();
+        let trunk = self.bounded_bank_bytes(&names)?;
+        let prospective = trunk
+            .checked_add(r.static_reserve)
+            .and_then(|n| n.checked_add(r.dynamic_allowance))
+            .and_then(|n| n.checked_add(extra))
+            .filter(|&n| n <= r.cap)
+            .ok_or(Error::Invalid("MTP extra allocations exceed existing cap"))?;
+        let driver = r.driver.lock().map_err(|_| Error::Invalid("MTP residency driver lock"))?;
+        let actual = usize::try_from(driver.set.allocated_size()).map_err(|_| Error::Invalid("MTP allocation size"))?;
+        let actual_required = r.required(r.bank_bytes, r.static_bytes, actual)?;
+        // Driver overhead may exceed the header-based registration estimate.
+        // Keep MTP's extra reservation above BOTH source inventory and the
+        // actual existing-residency requirement; never spend it twice.
+        let actual_with_extra = actual_required
+            .checked_add(extra)
+            .filter(|&n| n <= r.cap)
+            .ok_or(Error::Invalid("MTP actual residency plus extra exceeds existing cap"))?;
+        receipt.resident_bank_peak_bytes = receipt.resident_bank_peak_bytes.max(r.bank_bytes);
+        receipt.resident_static_peak_bytes = receipt.resident_static_peak_bytes.max(r.static_bytes);
+        receipt.residency_allocated_peak_bytes = receipt.residency_allocated_peak_bytes.max(actual);
+        receipt.admitted_cap_bytes = r.cap;
+        receipt.prospective_reserved_bytes = receipt.prospective_reserved_bytes.max(prospective.max(actual_with_extra));
+        receipt.extra_reserved_bytes = extra;
+        receipt.target_registered_trunk_prospective_bytes = trunk;
+        receipt.target_static_reserve_bytes = r.static_reserve;
+        receipt.target_dynamic_allowance_bytes = r.dynamic_allowance;
+        receipt.observed_target_required_peak_bytes = receipt.observed_target_required_peak_bytes.max(actual_required);
+        // The probe rejects overlap=1, while the production recipe reserves
+        // two graphs. This is an accounting projection, never an admission of
+        // production scratch-heap behavior or speculative runtime state.
+        receipt.projected_production_overlap_extra_bytes = 512 * 1024 * 1024;
+        receipt.projected_production_reserved_bytes = receipt
+            .prospective_reserved_bytes
+            .checked_add(receipt.projected_production_overlap_extra_bytes)
+            .ok_or(Error::Invalid("MTP production projection overflow"))?;
+        receipt.projected_production_cap_margin_bytes =
+            r.cap.saturating_sub(receipt.projected_production_reserved_bytes);
+        receipt.projected_production_cap_deficit_bytes =
+            receipt.projected_production_reserved_bytes.saturating_sub(r.cap);
+        drop(driver);
+        drop(guard);
+        let statics = self.static_views.lock().map_err(|_| Error::Invalid("MTP static cache lock"))?;
+        if statics.registered_bytes > statics.limit || statics.limit != MAX_STATIC_VIEW_BYTES {
+            return Err(Error::Invalid("MTP static cache exceeded existing bound"));
+        }
+        receipt.static_cache_peak_bytes = receipt.static_cache_peak_bytes.max(statics.registered_bytes);
+        receipt.static_cache_entries_peak = receipt.static_cache_entries_peak.max(statics.entries.len());
+        receipt.sampled_metal_allocated_peak_bytes = receipt.sampled_metal_allocated_peak_bytes.max(allocated_bytes()?);
+        drop(statics);
+        self.mtp_prefix_check(receipt)?;
+        Ok(())
+    }
+
+    pub(in crate::engine::hybrid) fn mtp_probe_extra_bytes(
+        &self,
+        context: usize,
+    ) -> Result<usize> {
+        self.mtp_probe_selected_mode()?;
+        let mut selected = 0usize;
+        for (name, kind, rows, columns) in [
+            ("blk.45.ffn_gate_exps.weight", 10, 2048, 4096),
+            ("blk.45.ffn_up_exps.weight", 10, 2048, 4096),
+            ("blk.45.ffn_down_exps.weight", 11, 4096, 2048),
+        ] {
+            let t = self.tensor(name)?;
+            if t.kind != kind || t.shape != [288, rows, columns] || t.affine.is_some() {
+                return Err(Error::Invalid("MTP selected tensor contract"));
+            }
+            let plane = rows * encoded_size(kind, columns)?;
+            let max_span = (0..288)
+                .map(|index| self.files[t.file].metal_span(t.offset + index * plane, plane).map(|x| x.1))
+                .collect::<Result<Vec<_>>>()?
+                .into_iter()
+                .max()
+                .ok_or(Error::Invalid("MTP empty bank"))?;
+            selected = selected.checked_add(8 * max_span).ok_or(Error::Invalid("MTP selected size"))?;
+        }
+        // Two cache generations at a growth boundary, tails/APE, scores,
+        // private normalized rows and small persistent host/GPU norm buffers.
+        let cache = 4 * (2 * (context * 512 + context.div_ceil(4) * 128) + 3 * 4 * 128 + context);
+        selected.checked_add(cache).and_then(|n| n.checked_add(1024 * 1024)).ok_or(Error::Invalid("MTP extra size"))
+    }
+
+    /// Same mapped_ffn engine as selected_ffn, with explicit fixed NextN
+    /// geometry, page-span accounting, and drained mmap-owner release checks.
+    #[expect(clippy::too_many_arguments, reason = "test-only source-bound FFN and accounting operands")]
+    pub(in crate::engine::hybrid) fn mtp_probe_ffn(
+        &self,
+        experts: &[usize],
+        input: &[f32],
+        probabilities: &[f32],
+        shared_gate: &[f32],
+        shared_up: &[f32],
+        limit: f32,
+        extra: usize,
+        receipt: &mut Receipt,
+    ) -> Result<Vec<f32>> {
+        self.mtp_probe_ffn_mode(
+            experts,
+            input,
+            probabilities,
+            shared_gate,
+            shared_up,
+            limit,
+            extra,
+            receipt,
+            SelectionMode::Prefix,
+        )
+    }
+
+    #[expect(clippy::too_many_arguments, reason = "test-only identical FFN operands plus explicit cache control")]
+    fn mtp_probe_ffn_mode(
+        &self,
+        experts: &[usize],
+        input: &[f32],
+        probabilities: &[f32],
+        shared_gate: &[f32],
+        shared_up: &[f32],
+        limit: f32,
+        extra: usize,
+        receipt: &mut Receipt,
+        mode: SelectionMode,
+    ) -> Result<Vec<f32>> {
+        self.mtp_probe_observe(extra, receipt)?;
+        let mapping_profile = phase(Phase::Mapping);
+        if experts.len() != 8
+            || probabilities.len() != 8
+            || experts.iter().any(|&i| i >= 288)
+            || experts.iter().copied().collect::<HashSet<_>>().len() != 8
+            || input.len() != 4096
+            || shared_gate.len() != 2048
+            || shared_up.len() != 2048
+        {
+            return Err(Error::Invalid("MTP selected operands"));
+        }
+        let shared = self.tensor("blk.45.ffn_down_shexp.weight")?;
+        let shared_matrix = self.mapped_matrix(shared, 0, 4096, 2048, true)?;
+        let before = self.files.iter().map(Arc::strong_count).collect::<Vec<_>>();
+        if receipt.prefix_seal.as_ref().is_some_and(|seal| seal.mapping_owners != before) {
+            return Err(Error::Invalid("MTP prefix owner baseline changed before FFN"));
+        }
+        let repeated = input.repeat(8);
+        let down_inputs = vec![0.0; 8 * 2048];
+        let shared_inputs = vec![0.0; 2048];
+        let mut operations = Vec::with_capacity(4);
+        let mut registered = 0usize;
+        let mut cached_registered = 0usize;
+        let cached_experts = experts
+            .iter()
+            .filter(|&&i| {
+                matches!(mode, SelectionMode::Prefix)
+                    && receipt.prefix_seal.is_some()
+                    && i < receipt.prefix.prefix_experts
+            })
+            .count();
+        for (name, rows, columns, values) in [
+            ("blk.45.ffn_gate_exps.weight", 2048, 4096, repeated.as_slice()),
+            ("blk.45.ffn_up_exps.weight", 2048, 4096, repeated.as_slice()),
+            ("blk.45.ffn_down_exps.weight", 4096, 2048, down_inputs.as_slice()),
+        ] {
+            self.mtp_probe_selected_mode()?;
+            let t = self.tensor(name)?;
+            let mut matrices = Vec::with_capacity(8);
+            for &i in experts {
+                let cacheable = matches!(mode, SelectionMode::Prefix)
+                    && receipt.prefix_seal.is_some()
+                    && i < receipt.prefix.prefix_experts;
+                let m = self.mapped_matrix(t, i, rows, columns, cacheable)?;
+                registered =
+                    registered.checked_add(m.codes.registered_bytes()).ok_or(Error::Invalid("MTP selected span"))?;
+                if cacheable {
+                    cached_registered = cached_registered
+                        .checked_add(m.codes.registered_bytes())
+                        .ok_or(Error::Invalid("MTP cached reference span"))?;
+                }
+                matrices.push(m);
+            }
+            operations.push(MappedOperation {
+                matrices,
+                inputs: values,
+                rows,
+                columns,
+                rows_per_batch: 0,
+                format: self.matrix_format(t)?,
+            });
+        }
+        if registered > extra || registered > MAX_SELECTED_BYTES {
+            return Err(Error::Invalid("MTP live selected views exceed admission"));
+        }
+        operations.push(MappedOperation {
+            matrices: vec![shared_matrix],
+            inputs: &shared_inputs,
+            rows: 4096,
+            columns: 2048,
+            rows_per_batch: 0,
+            format: self.matrix_format(shared)?,
+        });
+        let operations: [MappedOperation<'_>; 4] =
+            operations.try_into().map_err(|_| Error::Invalid("MTP FFN count"))?;
+        receipt.selected_calls += 1;
+        let ephemeral = registered - cached_registered;
+        receipt.selected_reference_view_count_peak = receipt.selected_reference_view_count_peak.max(24);
+        receipt.selected_reference_registered_peak_bytes =
+            receipt.selected_reference_registered_peak_bytes.max(registered);
+        receipt.ephemeral_selected_live_bytes_at_return = ephemeral;
+        receipt.prefix.cached_plane_hits += 3 * cached_experts;
+        receipt.prefix.ephemeral_plane_refs += 3 * (8 - cached_experts);
+        receipt.prefix.cached_reference_registered_peak_bytes =
+            receipt.prefix.cached_reference_registered_peak_bytes.max(cached_registered);
+        receipt.prefix.ephemeral_registered_peak_bytes = receipt.prefix.ephemeral_registered_peak_bytes.max(ephemeral);
+        if head_profile::is_active() {
+            receipt.prefix.warm_cached_expert_histogram[cached_experts] += 1;
+            receipt.prefix.warm_fully_cached_heads += usize::from(cached_experts == 8);
+            receipt.prefix.warm_cached_plane_hits += 3 * cached_experts;
+            receipt.prefix.warm_ephemeral_plane_refs += 3 * (8 - cached_experts);
+        }
+        drop(mapping_profile);
+        self.mtp_probe_observe(extra, receipt)?;
+        let ffn_profile = phase(Phase::Ffn);
+        let result = mapped_ffn(&operations, probabilities, 1.0, shared_gate, shared_up, Some((limit, limit)));
+        drop(ffn_profile);
+        let release_profile = phase(Phase::Release);
+        drop(operations);
+        if self.files.iter().map(Arc::strong_count).ne(before) {
+            return Err(Error::Invalid("MTP selected mmap owners remained live after completion"));
+        }
+        receipt.ephemeral_selected_live_bytes_at_return = 0;
+        receipt.released_owner_checks += 1;
+        if receipt.prefix_seal.is_some() {
+            receipt.prefix.postpreload_owner_release_checks += 1;
+        }
+        drop(release_profile);
+        self.mtp_probe_observe(extra, receipt)?;
+        result
+    }
+
+    /// Fixed public fixture sets, sequentially drained. The first output is
+    /// ordinary CPU F32 storage before the uncached reference creates views;
+    /// no two ephemeral selected sets coexist. No output values are emitted.
+    pub(in crate::engine::hybrid) fn mtp_probe_prefix_parity(
+        &self,
+        limit: f32,
+        extra: usize,
+        receipt: &mut Receipt,
+    ) -> Result<()> {
+        let input = (0..4096).map(|i| ((i * 17 % 257) as f32 - 128.0) / 1024.0).collect::<Vec<_>>();
+        let shared_gate = vec![0.125; 2048];
+        let shared_up = vec![0.25; 2048];
+        let probabilities = [0.125; 8];
+        for experts in
+            [[0, 1, 2, 3, 4, 5, 6, 7], [0, 1, 2, 3, 192, 193, 194, 195], [192, 193, 194, 195, 196, 197, 198, 199]]
+        {
+            let cached = self.mtp_probe_ffn_mode(
+                &experts,
+                &input,
+                &probabilities,
+                &shared_gate,
+                &shared_up,
+                limit,
+                extra,
+                receipt,
+                SelectionMode::Prefix,
+            )?;
+            let uncached = self.mtp_probe_ffn_mode(
+                &experts,
+                &input,
+                &probabilities,
+                &shared_gate,
+                &shared_up,
+                limit,
+                extra,
+                receipt,
+                SelectionMode::Ephemeral,
+            )?;
+            require_equal_ffn_rows(&cached, &uncached)?;
+            receipt.prefix.parity_cases += 1;
+            receipt.prefix.parity_compared_elements += 4096;
+            let cached_experts = experts.iter().filter(|&&i| i < receipt.prefix.prefix_experts).count();
+            receipt.prefix.parity_cached_expert_histogram[cached_experts] += 1;
+        }
+        Ok(())
+    }
+}
