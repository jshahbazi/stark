+    pub ephemeral_plane_refs: usize,
+    pub cached_reference_registered_peak_bytes: usize,
+    pub ephemeral_registered_peak_bytes: usize,
+    pub warm_cached_expert_histogram: [usize; 9],
+    pub warm_fully_cached_heads: usize,
+    pub warm_cached_plane_hits: usize,
+    pub warm_ephemeral_plane_refs: usize,
+    pub parity_cases: usize,
+    pub parity_compared_elements: usize,
+    pub parity_mismatched_elements: usize,
+    pub parity_cached_expert_histogram: [usize; 9],
+    pub postpreload_alignment_target_rows: usize,
+    pub postpreload_alignment_cache_rows: usize,
+    pub postpreload_owner_release_checks: usize,
+}
+
+struct PrefixSeal {
+    keys: HashSet<StaticViewKey>,
+    registered_bytes: usize,
+    resident_static_bytes: usize,
+    resident_buffers: usize,
+    residency_allocated_bytes: usize,
+    mapping_owners: Vec<usize>,
+}
+
+struct PrefixLedger {
+    cache_bytes: usize,
+    cache_entries: usize,
+    static_bytes: usize,
+    bank_bytes: usize,
+    allocated_bytes: usize,
+    dynamic: usize,
+    reserve: usize,
+    cap: usize,
+    extra: usize,
+}
+
+#[derive(Clone, Copy)]
+enum SelectionMode {
+    Prefix,
+    Ephemeral,
+}
+
+fn admit_prefix(
+    ledger: &PrefixLedger,
+    bytes: usize,
+    entries: usize,
+) -> Result<(usize, usize)> {
+    let cache = ledger.cache_bytes.checked_add(bytes).filter(|&n| n <= MAX_STATIC_VIEW_BYTES);
+    let statics = ledger.static_bytes.checked_add(bytes).filter(|&n| n <= ledger.reserve);
+    let count = ledger.cache_entries.checked_add(entries).filter(|&n| n <= BASE_STATIC_ENTRIES + 3 * PREFIX_EXPERTS);
+    let allocated = ledger.allocated_bytes.checked_add(bytes);
+    let required = statics.zip(allocated).and_then(|(statics, allocated)| {
+        ledger
+            .bank_bytes
+            .checked_add(statics)
+            .map(|n| n.max(allocated))
+            .and_then(|n| n.checked_add(ledger.reserve - statics))
+            .and_then(|n| n.checked_add(ledger.dynamic))
+            .and_then(|n| n.checked_add(ledger.extra))
+            .filter(|&n| n <= ledger.cap)
+    });
+    cache
+        .zip(count)
+        .zip(required)
+        .map(|((cache, count), _)| (cache, count))
+        .ok_or(Error::Invalid("MTP prefix preflight budget"))
+}
