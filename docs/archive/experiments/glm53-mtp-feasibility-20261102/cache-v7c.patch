+#[stark_engine_macros::stark_test]
+fn mtp_prefix_ffn_comparison_checks_all_f32_bits() {
+    let first = vec![0.0; 4096];
+    assert!(require_equal_ffn_rows(&first, &first).is_ok());
+    let mut changed = first.clone();
+    changed[4095] = -0.0;
+    assert!(require_equal_ffn_rows(&first, &changed).is_err());
+    changed[4095] = f32::from_bits(1);
+    assert!(require_equal_ffn_rows(&first, &changed).is_err());
+    changed[4095] = f32::NAN;
+    assert!(require_equal_ffn_rows(&changed, &changed).is_err());
+    assert!(require_equal_ffn_rows(&first[..4095], &first).is_err());
+}
