+def parse_test_result(output: bytes) -> dict:
+    """Accept the sole strict sentinel, with pinned libtest-mimic framing.
+
+    libtest-mimic 0.8.2 pretty mode flushes this exact test prefix without a
+    newline before running the test. Names come from stark_test's module_path.
+    Only padding spaces and the fixed delimiter may precede the JSON object.
+    All captured bytes remain in RAM; no parser exception includes them.
+    """
+    if len(output) > 256 * 1024:
+        raise ProbeError("test_result")
+    prefix = re.compile(rb"test " + re.escape(TEST_NAME) + rb" * \.\.\. (?P<json>\{.*\})")
+    def unique_object(pairs):
+        result = {}
+        for key, value in pairs:
+            if key in result:
+                raise ProbeError("test_result")
+            result[key] = value
+        return result
+    results = []
+    try:
+        for line in output.splitlines():
+            stripped = line.strip()
+            if b'"glm_mtp_probe_result"' not in stripped:
+                continue
+            if stripped.startswith(b"{"):
+                candidate = stripped
+            else:
+                match = prefix.fullmatch(stripped)
+                if match is None:
+                    raise ProbeError("test_result")
+                candidate = match.group("json")
+            results.append(json.loads(candidate, object_pairs_hook=unique_object))
+        if len(results) != 1:
+            raise ProbeError("test_result")
+        return validate_aggregate(results[0])
+    except ProbeError:
+        raise
+    except BaseException:
+        raise ProbeError("test_result") from None
+
+
+def run(args: argparse.Namespace) -> dict:
+    requested_ffn_wait_policy()
+    model_path = args.model_path.resolve(strict=True)
+    test_binary = args.test_binary.resolve(strict=True)
+    if not model_path.is_dir() or not test_binary.is_file():
+        raise ProbeError("arguments")
+
+    # Load the same rendering convention used by benchmark_glm_mlx_serve.py.
+    try:
+        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
+            from stark_convert.chat import load_template
+            from tokenizers import Tokenizer
+
+            codec, template = load_template(model_path)
+            tokenizer_path = model_path / "tokenizer.json"
+            tokenizer = Tokenizer.from_file(str(tokenizer_path))
+            rendered = [
+                template.render(
+                    messages=[{"role": "user", "content": prompt}],
+                    tools=None,
+                    add_generation_prompt=True,
+                    enable_thinking=True,
+                    bos_token=codec.get("bos_token") or "",
+                    eos_token=codec.get("eos_token") or "",
+                )
+                for prompt in PROMPTS
+            ]
+            inputs = [tokenizer.encode(prompt, add_special_tokens=False).ids for prompt in rendered]
+    except ProbeError:
+        raise
+    except BaseException:
+        raise ProbeError("tokenization") from None
+
+    if (
+        len(inputs) != len(PROMPTS)
+        or any(len(ids) < 8 or len(ids) > 128 for ids in inputs)
+    ):
+        raise ProbeError("tokenization")
+
+    input_count = sum(map(len, inputs))
+    corpus_hash = hashlib.sha256(
+        json.dumps(inputs, separators=(",", ":")).encode("ascii")
+    ).hexdigest()
+    request = {
+        "schema_version": 1,
+        "cases": [{"input_token_ids": ids} for ids in inputs],
+        "continuation_tokens": CONTINUATION_TOKENS,
+        "context_tokens": CONTEXT_TOKENS,
+        "corpus_sha256": corpus_hash,
+    }
+    request_bytes = (json.dumps(request, separators=(",", ":")) + "\n").encode("ascii")
+
+    environment = os.environ.copy()
+    environment[MODEL_PATH_ENV] = str(model_path)
+    started = time.monotonic_ns()
+    try:
+        completed = subprocess.run(
+            [str(test_binary), "glm_mtp_one_step_probe", "--ignored", "--nocapture", "--test-threads=1"],
+            input=request_bytes,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            env=environment,
+            timeout=TIMEOUT_SECONDS,
+            check=False,
+        )
+    except subprocess.TimeoutExpired:
+        raise ProbeError("test_timeout") from None
+    except BaseException:
+        raise ProbeError("test_launch") from None
+    elapsed_ms = (time.monotonic_ns() - started) // 1_000_000
+    # Preserve strict schemas; only the pinned harness prefix is stripped.
+    aggregate = parse_test_result(completed.stdout)
+    validate_requested_inputs(aggregate, corpus_hash, input_count)
+
+    artifact_names = (
+        "config.json", "generation_config.json", "tokenizer.json",
+        "tokenizer_config.json", "chat_template.jinja", "native-source.json",
+    )
+    artifacts = {}
+    for name in artifact_names:
+        candidate = model_path / name
+        if candidate.is_file():
+            artifacts[name] = file_identity(candidate)
+    if "tokenizer.json" not in artifacts:
+        raise ProbeError("model_artifacts")
+
+    passed = completed.returncode == 0 and aggregate.get("status") != "rejected"
+    return {
+        "schema_version": 1,
+        "scope": SCOPE,
+        "status": "complete" if passed else "failed",
+        "glm_mtp_probe_result": True,
+        "error_stage": None if passed else ("test_exit" if completed.returncode != 0 else "test_rejected"),
+        "model_artifacts": artifacts,
+        "test_binary_sha256": sha256_file(test_binary),
+        "driver_sha256": sha256_file(Path(__file__).resolve()),
+        "execution_selector_sha256": execution_selector_sha256(),
+        "corpus_sha256": corpus_hash,
+        "prompt_count": len(inputs),
+        "input_token_count": input_count,
+        "input_token_min": min(map(len, inputs)),
+        "input_token_max": max(map(len, inputs)),
+        "context_tokens": CONTEXT_TOKENS,
+        "continuation_tokens": CONTINUATION_TOKENS,
+        "elapsed_ms": elapsed_ms,
+        "aggregate": aggregate,
+    }
+
+
+def emit(value: dict) -> None:
+    # Constructed output uses only fixed keys and allowlisted aggregate values.
+    sys.stdout.write(json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n")
+    sys.stdout.flush()
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--test-binary", type=Path, required=True)
+    parser.add_argument("--model-path", type=Path, required=True)
+    args = parser.parse_args()
+    try:
+        result = run(args)
+    except ProbeError as error:
+        result = {
+            "schema_version": 1,
+            "scope": SCOPE,
+            "status": "failed",
+            "glm_mtp_probe_result": False,
+            "error_stage": error.stage,
+        }
+    except BaseException:
+        result = {
+            "schema_version": 1,
+            "scope": SCOPE,
+            "status": "failed",
+            "glm_mtp_probe_result": False,
+            "error_stage": "driver",
+        }
+    emit(result)
+    return 0 if result["glm_mtp_probe_result"] and result["status"] == "complete" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
