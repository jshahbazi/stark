+#[stark_engine_macros::stark_test]
+fn mtp_prefix_preflight_rejects_budget_overflow_and_unbounded_entries() {
+    let mut ledger = PrefixLedger {
+        cache_bytes: BASE_STATIC_BYTES,
+        cache_entries: BASE_STATIC_ENTRIES,
+        static_bytes: BASE_STATIC_BYTES,
+        bank_bytes: 99_035_873_280,
+        allocated_bytes: 105_609_035_776,
+        dynamic: 1_066_257_728,
+        reserve: MAX_STATIC_VIEW_BYTES,
+        cap: 109_676_289_225,
+        extra: 75_439_104,
+    };
+    assert_eq!(admit_prefix(&ledger, 0, 0).unwrap(), (BASE_STATIC_BYTES, BASE_STATIC_ENTRIES));
+    assert_eq!(admit_prefix(&ledger, PREFIX_REGISTERED_MAX, 576).unwrap(), (8_331_624_448, 1185));
+    ledger.cache_entries += 1;
+    assert!(admit_prefix(&ledger, PREFIX_REGISTERED_MAX, 576).is_err());
+    ledger.cache_entries -= 1;
+    ledger.cache_bytes = MAX_STATIC_VIEW_BYTES;
+    assert!(admit_prefix(&ledger, 1, 0).is_err());
+    ledger.cache_bytes = BASE_STATIC_BYTES;
+    ledger.static_bytes = MAX_STATIC_VIEW_BYTES - PREFIX_REGISTERED_MAX + 1;
+    assert!(admit_prefix(&ledger, PREFIX_REGISTERED_MAX, 576).is_err());
+    ledger.static_bytes = BASE_STATIC_BYTES;
+    ledger.cap = 108_767_504_703;
+    assert!(admit_prefix(&ledger, PREFIX_REGISTERED_MAX, 576).is_err());
+    ledger.cap = 109_676_289_225;
+    ledger.allocated_bytes = usize::MAX;
+    assert!(admit_prefix(&ledger, 1, 0).is_err());
+    ledger.allocated_bytes = 105_609_035_776;
+    ledger.bank_bytes = usize::MAX;
+    assert!(admit_prefix(&ledger, 0, 0).is_err());
+    assert_eq!(2048 * encoded_size(10, 4096).unwrap(), 2_752_512);
+    assert_eq!(4096 * encoded_size(11, 2048).unwrap(), 3_604_480);
+    assert_eq!(192 * (2 * (2_752_512 + 16_384) + 3_604_480 + 16_384), PREFIX_REGISTERED_MAX);
+}
