+// SPDX-License-Identifier: Apache-2.0
+//! Test-only accounting adapter over existing bounded mapped FFN operations.
+//! Fixed-prefix experiments reuse existing static-cache admission; production
+//! policies and all residency/cap limits remain unchanged.
+
+use super::*;
+use crate::engine::hybrid::weight_metal::{MappedOperation, allocated_bytes, mapped_ffn};
+
+#[path = "mtp_head_profile.rs"]
+pub(in crate::engine::hybrid) mod head_profile;
+use head_profile::{Phase, phase};
+
+const PREFIX_EXPERTS: usize = 192;
+const BASE_STATIC_BYTES: usize = 6_573_162_496;
+const BASE_STATIC_ENTRIES: usize = 609;
+const PREFIX_REGISTERED_MAX: usize = 1_758_461_952;
+const GEOMETRIES: [(&str, u32, usize, usize); 3] = [
+    ("blk.45.ffn_gate_exps.weight", 10, 2048, 4096),
+    ("blk.45.ffn_up_exps.weight", 10, 2048, 4096),
+    ("blk.45.ffn_down_exps.weight", 11, 4096, 2048),
+];
+
+#[derive(Default, serde::Serialize)]
+pub(in crate::engine::hybrid) struct PrefixReceipt {
+    pub prefix_experts: usize,
+    pub prebound_views: usize,
+    pub prebound_registered_bytes: usize,
+    pub base_static_registered_bytes: usize,
+    pub base_resident_static_bytes: usize,
+    pub base_static_entries: usize,
+    pub base_residency_allocated_bytes: usize,
+    pub static_registered_after_bytes: usize,
+    pub resident_static_after_bytes: usize,
+    pub residency_allocated_after_bytes: usize,
