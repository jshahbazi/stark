+    chunks = environment.get("STARK_GLM53_CONTROL_CHUNKS")
+    selectors["STARK_GLM53_CONTROL_CHUNKS"] = chunks if chunks in {"8", "16", "32"} else "unset_or_invalid"
+    selectors[FFN_PREFIX_ENV] = requested_prefix()
+    selectors[CONCURRENT_FFN_ENV + "_RESOLVED"] = environment.get(CONCURRENT_FFN_ENV) != "0"
