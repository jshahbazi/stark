index 00000000..f1e16520
--- /dev/null
+++ b/crates/stark-engine/src/engine/hybrid/weights_mtp_probe.rs
@@ -0,0 +1,233 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Test-only accounting adapter over existing bounded mapped FFN operations.
+//! No residency/cap/cache policy is changed by this module.
+
+use super::*;
+use crate::engine::hybrid::weight_metal::{MappedOperation, allocated_bytes, mapped_ffn};
+
+#[path = "mtp_head_profile.rs"]
+pub(in crate::engine::hybrid) mod head_profile;
+use head_profile::{Phase, phase};
+
+#[derive(Default, serde::Serialize)]
+pub(in crate::engine::hybrid) struct Receipt {
+    pub selected_calls: usize,
+    pub selected_view_count_peak: usize,
+    pub selected_registered_peak_bytes: usize,
+    pub selected_live_bytes_at_return: usize,
+    pub released_owner_checks: usize,
+    pub resident_bank_peak_bytes: usize,
+    pub resident_static_peak_bytes: usize,
+    pub residency_allocated_peak_bytes: usize,
+    pub static_cache_peak_bytes: usize,
+    pub static_cache_entries_peak: usize,
+    pub sampled_metal_allocated_peak_bytes: usize,
+    pub prospective_reserved_bytes: usize,
+    pub admitted_cap_bytes: usize,
+    pub extra_reserved_bytes: usize,
+    pub target_registered_trunk_prospective_bytes: usize,
+    pub target_static_reserve_bytes: usize,
+    pub target_dynamic_allowance_bytes: usize,
+    pub observed_target_required_peak_bytes: usize,
+    pub projected_production_overlap_extra_bytes: usize,
+    pub projected_production_reserved_bytes: usize,
+    pub projected_production_cap_margin_bytes: usize,
+    pub projected_production_cap_deficit_bytes: usize,
+}
+
+impl Weights {
+    /// Fail before a selected view can enter bank_view's promotion branch.
+    fn mtp_probe_selected_mode(&self) -> Result<()> {
+        let cache = self.bank_views.lock().map_err(|_| Error::Invalid("MTP bank cache lock"))?;
+        if cache.limit != 0 || cache.registered_bytes != 0 || !cache.entries.is_empty() {
+            return Err(Error::Invalid("MTP requires uncached selected ranges"));
+        }
+        Ok(())
+    }
+
+    /// Reserve selected planes and one independent draft cache above the
+    /// unchanged trunk/static/dynamic reservation. No new resident bank names.
+    pub(in crate::engine::hybrid) fn mtp_probe_observe(
+        &self,
+        extra: usize,
+        receipt: &mut Receipt,
+    ) -> Result<()> {
+        let _profile = phase(Phase::Observe);
+        self.mtp_probe_selected_mode()?;
+        let guard = self.encoder_residency.lock().map_err(|_| Error::Invalid("MTP residency lock"))?;
+        let r = guard.as_ref().ok_or(Error::Invalid("MTP requires existing residency admission"))?;
+        if r.failed || r.names.iter().any(|n| n.starts_with("blk.45.")) {
+            return Err(Error::Invalid("MTP must not enter resident trunk inventory"));
+        }
+        let names = r.names.iter().cloned().collect::<Vec<_>>();
+        let trunk = self.bounded_bank_bytes(&names)?;
+        let prospective = trunk
+            .checked_add(r.static_reserve)
+            .and_then(|n| n.checked_add(r.dynamic_allowance))
+            .and_then(|n| n.checked_add(extra))
+            .filter(|&n| n <= r.cap)
+            .ok_or(Error::Invalid("MTP extra allocations exceed existing cap"))?;
+        let driver = r.driver.lock().map_err(|_| Error::Invalid("MTP residency driver lock"))?;
+        let actual = usize::try_from(driver.set.allocated_size()).map_err(|_| Error::Invalid("MTP allocation size"))?;
+        let actual_required = r.required(r.bank_bytes, r.static_bytes, actual)?;
+        // Driver overhead may exceed the header-based registration estimate.
+        // Keep MTP's extra reservation above BOTH source inventory and the
+        // actual existing-residency requirement; never spend it twice.
+        let actual_with_extra = actual_required
+            .checked_add(extra)
+            .filter(|&n| n <= r.cap)
+            .ok_or(Error::Invalid("MTP actual residency plus extra exceeds existing cap"))?;
+        receipt.resident_bank_peak_bytes = receipt.resident_bank_peak_bytes.max(r.bank_bytes);
+        receipt.resident_static_peak_bytes = receipt.resident_static_peak_bytes.max(r.static_bytes);
+        receipt.residency_allocated_peak_bytes = receipt.residency_allocated_peak_bytes.max(actual);
+        receipt.admitted_cap_bytes = r.cap;
+        receipt.prospective_reserved_bytes = receipt.prospective_reserved_bytes.max(prospective.max(actual_with_extra));
+        receipt.extra_reserved_bytes = extra;
+        receipt.target_registered_trunk_prospective_bytes = trunk;
+        receipt.target_static_reserve_bytes = r.static_reserve;
+        receipt.target_dynamic_allowance_bytes = r.dynamic_allowance;
+        receipt.observed_target_required_peak_bytes = receipt.observed_target_required_peak_bytes.max(actual_required);
+        // The probe rejects overlap=1, while the production recipe reserves
+        // two graphs. This is an accounting projection, never an admission of
+        // production scratch-heap behavior or speculative runtime state.
+        receipt.projected_production_overlap_extra_bytes = 512 * 1024 * 1024;
+        receipt.projected_production_reserved_bytes = receipt
+            .prospective_reserved_bytes
+            .checked_add(receipt.projected_production_overlap_extra_bytes)
+            .ok_or(Error::Invalid("MTP production projection overflow"))?;
+        receipt.projected_production_cap_margin_bytes =
+            r.cap.saturating_sub(receipt.projected_production_reserved_bytes);
+        receipt.projected_production_cap_deficit_bytes =
+            receipt.projected_production_reserved_bytes.saturating_sub(r.cap);
+        drop(driver);
+        drop(guard);
+        let statics = self.static_views.lock().map_err(|_| Error::Invalid("MTP static cache lock"))?;
+        if statics.registered_bytes > statics.limit || statics.limit != MAX_STATIC_VIEW_BYTES {
+            return Err(Error::Invalid("MTP static cache exceeded existing bound"));
+        }
+        receipt.static_cache_peak_bytes = receipt.static_cache_peak_bytes.max(statics.registered_bytes);
+        receipt.static_cache_entries_peak = receipt.static_cache_entries_peak.max(statics.entries.len());
+        receipt.sampled_metal_allocated_peak_bytes = receipt.sampled_metal_allocated_peak_bytes.max(allocated_bytes()?);
+        Ok(())
+    }
+
+    pub(in crate::engine::hybrid) fn mtp_probe_extra_bytes(
+        &self,
+        context: usize,
+    ) -> Result<usize> {
+        self.mtp_probe_selected_mode()?;
+        let mut selected = 0usize;
+        for (name, kind, rows, columns) in [
+            ("blk.45.ffn_gate_exps.weight", 10, 2048, 4096),
+            ("blk.45.ffn_up_exps.weight", 10, 2048, 4096),
+            ("blk.45.ffn_down_exps.weight", 11, 4096, 2048),
+        ] {
+            let t = self.tensor(name)?;
+            if t.kind != kind || t.shape != [288, rows, columns] || t.affine.is_some() {
+                return Err(Error::Invalid("MTP selected tensor contract"));
+            }
+            let plane = rows * encoded_size(kind, columns)?;
+            let max_span = (0..288)
+                .map(|index| self.files[t.file].metal_span(t.offset + index * plane, plane).map(|x| x.1))
+                .collect::<Result<Vec<_>>>()?
+                .into_iter()
+                .max()
+                .ok_or(Error::Invalid("MTP empty bank"))?;
+            selected = selected.checked_add(8 * max_span).ok_or(Error::Invalid("MTP selected size"))?;
+        }
+        // Two cache generations at a growth boundary, tails/APE, scores,
+        // private normalized rows and small persistent host/GPU norm buffers.
+        let cache = 4 * (2 * (context * 512 + context.div_ceil(4) * 128) + 3 * 4 * 128 + context);
+        selected.checked_add(cache).and_then(|n| n.checked_add(1024 * 1024)).ok_or(Error::Invalid("MTP extra size"))
+    }
+
+    /// Same mapped_ffn engine as selected_ffn, with explicit fixed NextN
+    /// geometry, page-span accounting, and drained mmap-owner release checks.
+    #[expect(clippy::too_many_arguments, reason = "test-only source-bound FFN and accounting operands")]
+    pub(in crate::engine::hybrid) fn mtp_probe_ffn(
+        &self,
+        experts: &[usize],
+        input: &[f32],
+        probabilities: &[f32],
+        shared_gate: &[f32],
+        shared_up: &[f32],
+        limit: f32,
+        extra: usize,
+        receipt: &mut Receipt,
+    ) -> Result<Vec<f32>> {
+        self.mtp_probe_observe(extra, receipt)?;
+        let mapping_profile = phase(Phase::Mapping);
+        if experts.len() != 8
+            || probabilities.len() != 8
+            || experts.iter().any(|&i| i >= 288)
+            || experts.iter().copied().collect::<HashSet<_>>().len() != 8
+            || input.len() != 4096
+            || shared_gate.len() != 2048
+            || shared_up.len() != 2048
+        {
+            return Err(Error::Invalid("MTP selected operands"));
+        }
+        let shared = self.tensor("blk.45.ffn_down_shexp.weight")?;
+        let shared_matrix = self.mapped_matrix(shared, 0, 4096, 2048, true)?;
+        let before = self.files.iter().map(Arc::strong_count).collect::<Vec<_>>();
+        let repeated = input.repeat(8);
+        let down_inputs = vec![0.0; 8 * 2048];
+        let shared_inputs = vec![0.0; 2048];
+        let mut operations = Vec::with_capacity(4);
+        let mut registered = 0usize;
+        for (name, rows, columns, values) in [
+            ("blk.45.ffn_gate_exps.weight", 2048, 4096, repeated.as_slice()),
+            ("blk.45.ffn_up_exps.weight", 2048, 4096, repeated.as_slice()),
+            ("blk.45.ffn_down_exps.weight", 4096, 2048, down_inputs.as_slice()),
+        ] {
+            self.mtp_probe_selected_mode()?;
+            let t = self.tensor(name)?;
+            let matrices =
+                experts.iter().map(|&i| self.mapped_matrix(t, i, rows, columns, false)).collect::<Result<Vec<_>>>()?;
+            for m in &matrices {
+                registered =
+                    registered.checked_add(m.codes.registered_bytes()).ok_or(Error::Invalid("MTP selected span"))?;
+            }
+            operations.push(MappedOperation {
+                matrices,
+                inputs: values,
+                rows,
+                columns,
+                rows_per_batch: 0,
+                format: self.matrix_format(t)?,
+            });
+        }
+        if registered > extra || registered > MAX_SELECTED_BYTES {
+            return Err(Error::Invalid("MTP live selected views exceed admission"));
+        }
+        operations.push(MappedOperation {
+            matrices: vec![shared_matrix],
+            inputs: &shared_inputs,
+            rows: 4096,
+            columns: 2048,
+            rows_per_batch: 0,
+            format: self.matrix_format(shared)?,
+        });
+        let operations: [MappedOperation<'_>; 4] =
+            operations.try_into().map_err(|_| Error::Invalid("MTP FFN count"))?;
+        receipt.selected_calls += 1;
+        receipt.selected_view_count_peak = receipt.selected_view_count_peak.max(24);
+        receipt.selected_registered_peak_bytes = receipt.selected_registered_peak_bytes.max(registered);
+        receipt.selected_live_bytes_at_return = registered;
+        drop(mapping_profile);
+        self.mtp_probe_observe(extra, receipt)?;
+        let ffn_profile = phase(Phase::Ffn);
+        let result = mapped_ffn(&operations, probabilities, 1.0, shared_gate, shared_up, Some((limit, limit)));
+        drop(ffn_profile);
+        let release_profile = phase(Phase::Release);
+        drop(operations);
+        if self.files.iter().map(Arc::strong_count).ne(before) {
+            return Err(Error::Invalid("MTP selected mmap owners remained live after completion"));
+        }
+        receipt.selected_live_bytes_at_return = 0;
+        receipt.released_owner_checks += 1;
+        drop(release_profile);
+        self.mtp_probe_observe(extra, receipt)?;
+        result
+    }
+}
