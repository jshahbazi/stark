+"""Private, aggregate-only driver for the ignored GLM-5.3 MTP probe.
+
+Prompts, token IDs, and the Rust test process output are kept in memory. The
+driver writes only allowlisted aggregate JSON to stdout and never writes a
+report or private test input to disk.
+"""
+
+from __future__ import annotations
+
+import argparse
+import contextlib
+import hashlib
+import io
+import json
+import math
+import os
+import re
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+
+SCOPE = "glm53_mtp_one_step_probe"
+MODEL_PATH_ENV = "STARK_GLM53_MTP_PROBE_MODEL_PATH"
+TEST_NAME = b"stark_engine::engine::hybrid::glm::mtp_probe::glm_mtp_one_step_probe"
+CONTINUATION_TOKENS = 8
+CONTEXT_TOKENS = 256
+TIMEOUT_SECONDS = 1800
+
+# Authored public prompts; content is deliberately never included in receipts.
+PROMPTS = (
+    "Name three colors.",
+    "Give one sentence about a quiet garden.",
+    "What is 7 plus 5? Answer briefly.",
+)
+
+AGGREGATE_KEYS = {
+    "status", "precision", "source_convention", "memory_gauges", "rows",
+    "timing_ms", "counts", "hashes",
+    "head_profile_schema", "head_profile_v4_wall_ms", "head_profile_v4_gpu_ms", "head_profile_v4_calls",
+}
+PROFILE_V4_SCHEMA = "v4_warm_decode_wall_gpu_calls"
+PROFILE_V4_PHASES = {
+    "head_total_inclusive", "prepare", "norm_mla_encode", "norm_mla_wait_readback",
+    "projection_blocking", "cpu_router", "selected_mapping_admission", "mapped_ffn_compute_wait",
+    "final_readout_encode", "final_readout_wait_readback", "validation_observe", "selected_owner_release",
+    "autorelease_drain", "projection_submit_return_inclusive", "ffn_submit_return_inclusive",
+}
+MEMORY_KEYS = {
+    "selected_calls", "selected_view_count_peak", "selected_registered_peak_bytes",
+    "selected_live_bytes_at_return", "released_owner_checks", "resident_bank_peak_bytes",
+    "resident_static_peak_bytes", "residency_allocated_peak_bytes", "static_cache_peak_bytes",
+    "static_cache_entries_peak", "sampled_metal_allocated_peak_bytes",
+    "prospective_reserved_bytes", "admitted_cap_bytes", "extra_reserved_bytes",
+    "target_registered_trunk_prospective_bytes", "target_static_reserve_bytes",
+    "target_dynamic_allowance_bytes", "observed_target_required_peak_bytes",
+    "projected_production_overlap_extra_bytes", "projected_production_reserved_bytes",
+    "projected_production_cap_margin_bytes", "projected_production_cap_deficit_bytes",
+}
+COUNT_KEYS = {
+    "cases", "prompt_rows", "comparisons", "agreements", "eos_cases",
+    "alignment_target_rows", "alignment_cache_rows", "alignment_chunk_groups",
+    "target_rollback_calls",
+}
+TIMING_KEYS = {
+    "cold_full_head_wall_including_lazy_pipeline_compile", "first_measured_prefill_cache_row_wall",
+    "prefill_cache_only_head_wall", "decode_head_wall", "serial_target_with_hidden_tap_wall",
+    "decode_head_gpu", "serial_target_with_hidden_tap_gpu",
+}
+HASH_KEYS = {"corpus_sha256", "target_continuation_sha256"}
+FAILURE_GUARDS = {
+    "probe_rejected", "stdin_bound", "stdin_schema", "stdin_admission",
+    "target_policy", "model_load", "alignment_parity", "memory_gate",
+    "static_cache_growth",
+}
+BOOLEAN_EXECUTION_SELECTORS = (
+    "STARK_GLM53_ENCODER_BANKS",
+    "STARK_GLM53_RESIDENT_BANKS",
+    "STARK_GLM53_WIDE_ENCODER",
+    "STARK_GLM53_Q4_GROUPED32",
+    "STARK_GLM53_Q5_GROUPED32",
+    "STARK_GLM53_Q6_GROUPED16",
+    "STARK_GLM53_IQ_GPU_BOUND",
+    "STARK_GLM53_IQ_TYPED16",
+    "STARK_GLM53_IQ_SIGNED_FACTOR",
+    "STARK_GLM53_IQ_FUSED_GATE_UP",
+    "STARK_GLM53_IQ_FUSED_GATE_UP_R2",
+    "STARK_GLM53_IQ_MULTIROW",
+    "STARK_GLM53_IQ4_VECTOR",
+    "STARK_GLM53_Q8_GROUPED8",
+    "STARK_GLM53_Q8_SHAPES",
+    "STARK_GLM53_Q4K_BLOCK",
+    "STARK_GLM53_KQUANT_FACTORED",
+    "STARK_GLM53_KDA_TRANSPOSED",
+    "STARK_GLM53_KDA_FUSED_STATE",
+    "STARK_GLM53_KDA_PARALLEL_NORM",
+    "STARK_GLM53_BATCH_FINITE",
+    "STARK_GLM53_FINITE_SELECTIVE",
+    "STARK_GLM53_SERIAL_FINITE_ORDER",
+    "STARK_HYBRID_SEPARATE_FINITE",
+    "STARK_GLM53_PARALLEL_RMS",
+    "STARK_GLM53_RMS_PREFETCH",
+    "STARK_HYBRID_ORDERED_RMS",
+    "STARK_GLM53_CONTROL_SPLIT",
+    "STARK_GLM53_CONTROL_SIMD",
+    "STARK_GLM53_CONTROL_RMS_PROJECT",
+    "STARK_GLM53_CONTROL_FUSED_PARALLEL",
+    "STARK_GLM53_UNRETAINED_GRAPH",
+    "STARK_GLM53_BOUNDED_GRAPH",
+    "STARK_GLM53_GREEDY_OVERLAP",
+    "STARK_GLM53_PREFILL_MMA",
+    "STARK_GLM53_PREFILL_OVERLAP",
+    "STARK_GLM53_PREFILL_QUEUED",
+    "STARK_GLM53_SCRATCH_HEAP",
+)
+SCALAR = (str, int, float, bool, type(None))
+
+
+class ProbeError(Exception):
+    def __init__(self, stage: str):
+        super().__init__(stage)
+        self.stage = stage
+
+
+def sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def file_identity(path: Path) -> dict:
+    if not path.is_file():
+        raise ProbeError("model_artifacts")
+    return {"bytes": path.stat().st_size, "sha256": sha256_file(path)}
+
+
+def execution_selector_sha256() -> str:
+    environment = os.environ
+    selectors = {name: environment.get(name) == "1" for name in BOOLEAN_EXECUTION_SELECTORS}
+
+    group_layers = environment.get("STARK_GLM53_BANK_GROUP_LAYERS")
+    if group_layers is None:
+        selectors["STARK_GLM53_BANK_GROUP_LAYERS"] = 45
+    else:
+        try:
+            parsed_group_layers = int(group_layers, 10)
+            selectors["STARK_GLM53_BANK_GROUP_LAYERS"] = (
+                parsed_group_layers if 1 <= parsed_group_layers <= 45 else "invalid"
+            )
+        except ValueError:
+            selectors["STARK_GLM53_BANK_GROUP_LAYERS"] = "invalid"
+
+    chunks = environment.get("STARK_GLM53_CONTROL_CHUNKS")
+    selectors["STARK_GLM53_CONTROL_CHUNKS"] = chunks if chunks in {"8", "16", "32"} else "unset_or_invalid"
+    encoded = json.dumps(selectors, sort_keys=True, separators=(",", ":")).encode("ascii")
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def validate_aggregate(value: object) -> dict:
+    if (
+        not isinstance(value, dict)
+        or set(value) != {"glm_mtp_probe_result", "aggregate"}
+        or value.get("glm_mtp_probe_result") is not True
+    ):
+        raise ProbeError("test_result")
+    aggregate = value.get("aggregate")
+    if not isinstance(aggregate, dict):
+        raise ProbeError("test_result")
+    rejected = aggregate.get("status") == "rejected"
+    expected_keys = {"status", "source_convention", "rows"} if rejected else AGGREGATE_KEYS
+    if set(aggregate) != expected_keys:
+        raise ProbeError("test_result")
+    for key, item in aggregate.items():
+        if key == "rows":
+            if not isinstance(item, dict):
+                raise ProbeError("test_result")
+            if rejected and set(item) != {"failure"}:
+                raise ProbeError("test_result")
+            if not rejected and any(row_name == "failure" for row_name in item):
+                raise ProbeError("test_result")
+            for row_name, row in item.items():
+                if not isinstance(row_name, str) or not isinstance(row, dict):
+                    raise ProbeError("test_result")
+                if row_name == "failure":
+                    if set(row) != {"guard"} or row["guard"] not in FAILURE_GUARDS:
+                        raise ProbeError("test_result")
+                elif (
+                    not row_name.startswith("case_")
+                    or not row_name[5:].isdigit()
+                    or set(row) != {"comparisons", "agreements"}
+                    or any(type(cell) is not int or cell < 0 for cell in row.values())
+                ):
+                    raise ProbeError("test_result")
+        elif key in {"head_profile_v4_wall_ms", "head_profile_v4_gpu_ms", "head_profile_v4_calls"}:
+            if not isinstance(item, dict) or set(item) != PROFILE_V4_PHASES:
+                raise ProbeError("test_result")
+            if key == "head_profile_v4_calls":
+                if any(type(cell) is not int or cell < 0 for cell in item.values()):
+                    raise ProbeError("test_result")
+            elif any(type(cell) not in (int, float) or not math.isfinite(cell) or cell < 0 for cell in item.values()):
+                raise ProbeError("test_result")
+        elif key == "head_profile_schema":
+            if item != PROFILE_V4_SCHEMA:
+                raise ProbeError("test_result")
+        elif key in {"memory_gauges", "timing_ms", "counts", "hashes"}:
+            expected_map_keys = {
+                "memory_gauges": MEMORY_KEYS,
+                "timing_ms": TIMING_KEYS,
+                "counts": COUNT_KEYS,
+                "hashes": HASH_KEYS,
+            }[key]
+            if not isinstance(item, dict) or set(item) != expected_map_keys:
+                raise ProbeError("test_result")
+            if key == "hashes":
+                if any(not isinstance(cell, str) or len(cell) != 64 or any(c not in "0123456789abcdef" for c in cell) for cell in item.values()):
+                    raise ProbeError("test_result")
+            elif any(type(cell) not in (int, float) or not math.isfinite(cell) or cell < 0 for cell in item.values()):
+                raise ProbeError("test_result")
+        elif key == "status":
+            if item not in {"component_probe_complete_no_speculative_runtime", "rejected"}:
+                raise ProbeError("test_result")
+        elif key == "precision":
+            if item != "existing_safe_f32_graph_quant_weights_cpu_f32_router":
+                raise ProbeError("test_result")
+        elif key == "source_convention":
+            if item != "llama_1b6935b227b9f9aa89deea8016c0e208f547446f_zero_prior_hidden_normal_pos0_embedding":
+                raise ProbeError("test_result")
+        elif not isinstance(item, SCALAR):
+            raise ProbeError("test_result")
+    return aggregate
+
+
+def parse_test_result(output: bytes) -> dict:
+    """Accept the sole strict sentinel, with pinned libtest-mimic framing.
+
+    libtest-mimic 0.8.2 pretty mode flushes this exact test prefix without a
+    newline before running the test. Names come from stark_test's module_path.
+    Only padding spaces and the fixed delimiter may precede the JSON object.
+    All captured bytes remain in RAM; no parser exception includes them.
+    """
+    if len(output) > 256 * 1024:
+        raise ProbeError("test_result")
+    prefix = re.compile(rb"test " + re.escape(TEST_NAME) + rb" * \.\.\. (?P<json>\{.*\})")
+    def unique_object(pairs):
+        result = {}
+        for key, value in pairs:
+            if key in result:
+                raise ProbeError("test_result")
+            result[key] = value
+        return result
+    results = []
+    try:
+        for line in output.splitlines():
+            stripped = line.strip()
+            if b'"glm_mtp_probe_result"' not in stripped:
+                continue
+            if stripped.startswith(b"{"):
+                candidate = stripped
+            else:
+                match = prefix.fullmatch(stripped)
+                if match is None:
+                    raise ProbeError("test_result")
+                candidate = match.group("json")
+            results.append(json.loads(candidate, object_pairs_hook=unique_object))
+        if len(results) != 1:
+            raise ProbeError("test_result")
+        return validate_aggregate(results[0])
+    except ProbeError:
+        raise
+    except BaseException:
+        raise ProbeError("test_result") from None
+
+
+def run(args: argparse.Namespace) -> dict:
+    model_path = args.model_path.resolve(strict=True)
+    test_binary = args.test_binary.resolve(strict=True)
+    if not model_path.is_dir() or not test_binary.is_file():
+        raise ProbeError("arguments")
+
+    # Load the same rendering convention used by benchmark_glm_mlx_serve.py.
+    try:
+        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
+            from stark_convert.chat import load_template
+            from tokenizers import Tokenizer
+
+            codec, template = load_template(model_path)
+            tokenizer_path = model_path / "tokenizer.json"
+            tokenizer = Tokenizer.from_file(str(tokenizer_path))
+            rendered = [
+                template.render(
+                    messages=[{"role": "user", "content": prompt}],
+                    tools=None,
+                    add_generation_prompt=True,
+                    enable_thinking=True,
+                    bos_token=codec.get("bos_token") or "",
+                    eos_token=codec.get("eos_token") or "",
+                )
+                for prompt in PROMPTS
+            ]
+            inputs = [tokenizer.encode(prompt, add_special_tokens=False).ids for prompt in rendered]
+    except ProbeError:
+        raise
+    except BaseException:
+        raise ProbeError("tokenization") from None
+
+    if (
+        len(inputs) != len(PROMPTS)
+        or any(len(ids) < 8 or len(ids) > 128 for ids in inputs)
+    ):
+        raise ProbeError("tokenization")
+
+    input_count = sum(map(len, inputs))
+    corpus_hash = hashlib.sha256(
+        json.dumps(inputs, separators=(",", ":")).encode("ascii")
+    ).hexdigest()
+    request = {
+        "schema_version": 1,
+        "cases": [{"input_token_ids": ids} for ids in inputs],
+        "continuation_tokens": CONTINUATION_TOKENS,
+        "context_tokens": CONTEXT_TOKENS,
+        "corpus_sha256": corpus_hash,
+    }
+    request_bytes = (json.dumps(request, separators=(",", ":")) + "\n").encode("ascii")
+
+    environment = os.environ.copy()
+    environment[MODEL_PATH_ENV] = str(model_path)
+    started = time.monotonic_ns()
+    try:
+        completed = subprocess.run(
+            [str(test_binary), "glm_mtp_one_step_probe", "--ignored", "--nocapture", "--test-threads=1"],
+            input=request_bytes,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            env=environment,
+            timeout=TIMEOUT_SECONDS,
+            check=False,
+        )
+    except subprocess.TimeoutExpired:
+        raise ProbeError("test_timeout") from None
+    except BaseException:
+        raise ProbeError("test_launch") from None
+    elapsed_ms = (time.monotonic_ns() - started) // 1_000_000
+    # Preserve strict schemas; only the pinned harness prefix is stripped.
+    aggregate = parse_test_result(completed.stdout)
+
+    artifact_names = (
+        "config.json", "generation_config.json", "tokenizer.json",
+        "tokenizer_config.json", "chat_template.jinja", "native-source.json",
+    )
+    artifacts = {}
+    for name in artifact_names:
+        candidate = model_path / name
+        if candidate.is_file():
+            artifacts[name] = file_identity(candidate)
+    if "tokenizer.json" not in artifacts:
+        raise ProbeError("model_artifacts")
+
+    passed = completed.returncode == 0 and aggregate.get("status") != "rejected"
+    return {
+        "schema_version": 1,
+        "scope": SCOPE,
+        "status": "complete" if passed else "failed",
+        "glm_mtp_probe_result": True,
+        "error_stage": None if passed else ("test_exit" if completed.returncode != 0 else "test_rejected"),
+        "model_artifacts": artifacts,
+        "test_binary_sha256": sha256_file(test_binary),
+        "driver_sha256": sha256_file(Path(__file__).resolve()),
+        "execution_selector_sha256": execution_selector_sha256(),
+        "corpus_sha256": corpus_hash,
+        "prompt_count": len(inputs),
+        "input_token_count": input_count,
+        "input_token_min": min(map(len, inputs)),
+        "input_token_max": max(map(len, inputs)),
+        "context_tokens": CONTEXT_TOKENS,
+        "continuation_tokens": CONTINUATION_TOKENS,
+        "elapsed_ms": elapsed_ms,
+        "aggregate": aggregate,
+    }
+
+
+def emit(value: dict) -> None:
+    # Constructed output uses only fixed keys and allowlisted aggregate values.
+    sys.stdout.write(json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n")
+    sys.stdout.flush()
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--test-binary", type=Path, required=True)
+    parser.add_argument("--model-path", type=Path, required=True)
+    args = parser.parse_args()
+    try:
+        result = run(args)
+    except ProbeError as error:
+        result = {
+            "schema_version": 1,
+            "scope": SCOPE,
+            "status": "failed",
+            "glm_mtp_probe_result": False,
+            "error_stage": error.stage,
+        }
+    except BaseException:
+        result = {
+            "schema_version": 1,
+            "scope": SCOPE,
+            "status": "failed",
+            "glm_mtp_probe_result": False,
+            "error_stage": "driver",
+        }
+    emit(result)
+    return 0 if result["glm_mtp_probe_result"] and result["status"] == "complete" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
