+// SPDX-License-Identifier: Apache-2.0
+//! Ignored, aggregate-only one-step NextN feasibility probe. No runtime route.
+//!
+//! Positive-position math and cold-row policy follow llama.cpp (MIT),
+//! 1b6935b227b9f9aa89deea8016c0e208f547446f:
+//! src/models/glm5-next.cpp:544-671,779-804 and common/speculative.cpp:1593,1673-1695.
+//! Copyright (c) 2023-2026 the ggml authors. See LICENSE.ggml-hybrid.
+//! vLLM 3b6eeb060621eba88deb74a146039291a1afbc42's pos-0 zero-embedding
+//! convention is different and is deliberately not mixed into these results.
+
+use std::{io::Read, path::PathBuf, time::Instant};
+
+use serde::Deserialize;
+use sha2::{Digest, Sha256};
+use stark_engine_macros::stark_test;
+
+use super::*;
+use crate::engine::hybrid::{
+    glm_metal, profile,
+    weight_metal::DecodeGraph,
+    weights::mtp_probe::{
+        Receipt,
+        head_profile::{self as hp, Phase, phase},
+    },
+};
+
+const SOURCE: &str = "llama_1b6935b227b9f9aa89deea8016c0e208f547446f_zero_prior_hidden_normal_pos0_embedding";
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Case {
+    input_token_ids: Vec<u32>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Request {
+    schema_version: usize,
+    cases: Vec<Case>,
+    continuation_tokens: usize,
+    context_tokens: usize,
+    corpus_sha256: String,
+}
+
+struct TargetRow {
+    hidden: Vec<f32>,
+    choice: Option<u32>,
+    logits: Option<Vec<f32>>,
+}
+
+fn choice(values: &[f32]) -> Result<u32> {
+    if values.is_empty() || values.iter().any(|v| !v.is_finite()) {
+        return Err(Error::Invalid("MTP greedy values"));
+    }
+    let mut best = 0;
+    for i in 1..values.len() {
+        if values[i] > values[best] {
+            best = i;
+        }
+    }
+    Ok(best as u32)
+}
+
+fn index(
+    values: &[f32],
+    vocab: usize,
+) -> Result<u32> {
+    if values.len() != 1
+        || !values[0].is_finite()
+        || values[0] < 0.0
+        || values[0].fract() != 0.0
+        || values[0] as f64 >= vocab as f64
+    {
+        return Err(Error::Invalid("MTP GPU index"));
+    }
+    Ok(values[0] as u32)
+}
+
+/// Source-equivalent serial encoder path, omitting cfg(test) layer trace
+/// readbacks. The returned tap is exactly the existing readout's norm input.
+fn target_row(
+    model: &mut GlmModel,
+    token: u32,
+    readout: bool,
+    full: bool,
+    extra: usize,
+    memory: &mut Receipt,
+) -> Result<TargetRow> {
+    objc2::rc::autoreleasepool(|_| target_row_inner(model, token, readout, full, extra, memory))
+}
+
+fn target_row_inner(
+    model: &mut GlmModel,
+    token: u32,
+    readout: bool,
+    full: bool,
+    extra: usize,
+    memory: &mut Receipt,
+) -> Result<TargetRow> {
+    let c = &model.config;
+    if token as usize >= c.vocab || model.position >= c.max_context {
+        return Err(Error::Invalid("MTP target bounds"));
+    }
+    let decode = model.decode.as_mut().ok_or(Error::Invalid("MTP target not initialized"))?;
+    let plan = decode.bounded_plan.clone().ok_or(Error::Invalid("MTP requires bounded target"))?;
+    if !decode.encoder_banks {
+        return Err(Error::Invalid("MTP requires target encoder banks"));
+    }
+    let embedding = model.weights.row("token_embd.weight", token as usize)?;
+    let mut streams = DecodeGraph::upload(&embedding.repeat(c.hc))?;
+    let mut graph = new_encoder_graph(decode)?;
+    for group in &plan.groups {
+        let banks = model.weights.encoder_indexed_group(&group.names, plan.budget)?;
+        if banks.registered_bytes() > group.bytes {
+            return Err(Error::Invalid("MTP target bank accounting"));
+        }
+        for layer in group.start..group.end {
+            (graph, streams) = encode_metal_layer(
+                &model.weights,
+                c,
+                decode,
+                layer,
+                &mut model.states[layer],
+                graph,
+                streams,
+                Some(&banks),
+            )?;
+        }
+        drop(banks);
+        if group.end < c.layer_types.len() {
+            graph.resource_boundary()?;
+        }
+    }
+    let mean = glm_metal::stream_mean(&mut graph, &streams, c.hidden, c.hc)?;
+    let hidden = graph.rms_norm(&mean, &decode.output_norm, c.hidden, c.rms_eps)?;
+    let mut outputs = vec![hidden];
+    if readout {
+        let logits = model.weights.encode_matvec(&mut graph, "output.weight", &outputs[0])?;
+        let greedy = graph.greedy_argmax(&logits)?;
+        outputs.push(greedy);
+        if full {
+            outputs.push(logits);
+        }
+    }
+    model.weights.mtp_probe_observe(extra, memory)?;
+    let mut rows = graph.finish(&outputs)?.into_iter();
+    let hidden = rows.next().ok_or(Error::Invalid("MTP target tap"))?;
+    let selected = if readout {
+        Some(index(&rows.next().ok_or(Error::Invalid("MTP target index"))?, c.vocab)?)
+    } else {
+        None
+    };
+    let logits = if full {
+        rows.next()
+    } else {
+        None
+    };
+    for state in &model.states {
+        if let LayerState::Kda(s) = state {
+            if let Some(metal) = &s.metal {
+                metal.check_completed()?;
+            }
+        }
+    }
+    model.position += 1;
+    model.weights.mtp_probe_observe(extra, memory)?;
+    Ok(TargetRow {
+        hidden,
+        choice: selected,
+        logits,
+    })
+}
+
+struct Head {
+    attention: glm_metal::Attention,
+    position: usize,
+}
+
+impl Head {
+    fn new(
+        model: &GlmModel,
+        context: usize,
+    ) -> Result<Self> {
+        let c = &model.config;
+        Ok(Self {
+            attention: glm_metal::Attention::new(
+                glm_metal::AttentionGeometry {
+                    rank: c.kv_rank,
+                    heads: c.heads,
+                    query_dim: c.qk_dim,
+                    index_dim: c.index_dim,
+                    index_heads: c.index_heads,
+                    pool: c.index_pool,
+                    top_k: c.index_topk,
+                    context,
+                },
+                &model.weights.vector("blk.45.indexer_compressor_ape.weight")?,
+            )?,
+            position: 0,
+        })
+    }
+
+    /// Full head or cache-only catch-up. Both execute identical MLA updates;
+    /// FFN and output layers have no cache state. No mHC control is called.
+    fn row(
+        &mut self,
+        model: &GlmModel,
+        previous_hidden: &[f32],
+        token: u32,
+        expected_position: usize,
+        readout: bool,
+        extra: usize,
+        memory: &mut Receipt,
+    ) -> Result<Option<u32>> {
+        let _total = phase(Phase::Total);
+        let mut drain = None;
+        let result = objc2::rc::autoreleasepool(|_| {
+            let result = self.row_inner(model, previous_hidden, token, expected_position, readout, extra, memory);
+            drain = Some(phase(Phase::Autorelease));
+            result
+        });
+        drop(drain);
+        result
+    }
+
+    fn row_inner(
+        &mut self,
+        model: &GlmModel,
+        previous_hidden: &[f32],
+        token: u32,
+        expected_position: usize,
+        readout: bool,
+        extra: usize,
+        memory: &mut Receipt,
+    ) -> Result<Option<u32>> {
+        let prepare_profile = phase(Phase::Prepare);
+        let c = &model.config;
+        let w = &model.weights;
+        if previous_hidden.len() != c.hidden
+            || self.position != expected_position
+            || self.attention.mtp_probe_position() != expected_position
+            || token as usize >= c.vocab
+        {
+            return Err(Error::Invalid("MTP shifted-row alignment"));
+        }
+        let mut graph = DecodeGraph::new()?;
+        let embed = DecodeGraph::upload(&w.row("token_embd.weight", token as usize)?)?;
+        let prior = DecodeGraph::upload(previous_hidden)?;
+        let en = DecodeGraph::upload(&w.vector("blk.45.nextn.enorm.weight")?)?;
+        let hn = DecodeGraph::upload(&w.vector("blk.45.nextn.hnorm.weight")?)?;
+        drop(prepare_profile);
+        let encode_profile = phase(Phase::NormMlaEncode);
+        let e = graph.rms_norm(&embed, &en, c.hidden, c.rms_eps)?;
+        let h = graph.rms_norm(&prior, &hn, c.hidden, c.rms_eps)?;
+        let joined = graph.scratch(2 * c.hidden)?;
+        graph.copy_into(&e, &joined.slice(0, c.hidden)?)?;
+        graph.copy_into(&h, &joined.slice(c.hidden, c.hidden)?)?;
+        let z = w.encode_matvec(&mut graph, "blk.45.nextn.eh_proj.weight", &joined)?;
+        let norm = DecodeGraph::upload(&w.vector("blk.45.attn_norm.weight")?)?;
+        let x = graph.rms_norm(&z, &norm, c.hidden, c.rms_eps)?;
+        let attention = encode_mla(w, c, &mut graph, &x, "blk.45", &mut self.attention, false)?;
+        let residual = graph.add(&z, &attention)?;
+        let ffn_norm = DecodeGraph::upload(&w.vector("blk.45.ffn_norm.weight")?)?;
+        let x = graph.rms_norm(&residual, &ffn_norm, c.hidden, c.rms_eps)?;
+        drop(encode_profile);
+        w.mtp_probe_observe(extra, memory)?;
+        let wait_profile = phase(Phase::NormMlaWait);
+        let rows = graph.finish(if readout {
+            std::slice::from_ref(&x)
+        } else {
+            &[]
+        })?;
+        drop(wait_profile);
+        self.position += 1;
+        if self.attention.mtp_probe_position() != self.position {
+            return Err(Error::Invalid("MTP MLA position"));
+        }
+        if !readout {
+            return Ok(None);
+        }
+        let x = &rows[0];
+        let projection_profile = phase(Phase::Projection);
+        let [router, shared_gate, shared_up] = project_many(
+            w,
+            [
+                ("blk.45.ffn_gate_inp.weight", x.as_slice()),
+                ("blk.45.ffn_gate_shexp.weight", x.as_slice()),
+                ("blk.45.ffn_up_shexp.weight", x.as_slice()),
+            ],
+        )?;
+        drop(projection_profile);
+        let router_profile = phase(Phase::Router);
+        let routed = route(&router, &w.vector("blk.45.exp_probs_b.bias")?, c.active_experts, c.routed_scale)?;
+        let experts = routed.iter().map(|&(i, _)| i).collect::<Vec<_>>();
+        let probabilities = routed.iter().map(|&(_, p)| p).collect::<Vec<_>>();
+        drop(router_profile);
+        let ffn =
+            w.mtp_probe_ffn(&experts, x, &probabilities, &shared_gate, &shared_up, c.swiglu_limit, extra, memory)?;
+        let readout_profile = phase(Phase::ReadoutEncode);
+        let mut graph = DecodeGraph::new()?;
+        let ffn = DecodeGraph::upload(&ffn)?;
+        let output = graph.add(&residual, &ffn)?;
+        let hn = DecodeGraph::upload(&w.vector("blk.45.nextn.shared_head_norm.weight")?)?;
+        let output = graph.rms_norm(&output, &hn, c.hidden, c.rms_eps)?;
+        let logits = w.encode_matvec(&mut graph, "output.weight", &output)?;
+        let output = graph.greedy_argmax(&logits)?;
+        drop(readout_profile);
+        w.mtp_probe_observe(extra, memory)?;
+        let _wait_profile = phase(Phase::ReadoutWait);
+        Ok(Some(index(&graph.finish(&[output])?.remove(0), c.vocab)?))
+    }
+}
+
+fn same_rows(
+    a: &[Vec<f32>],
+    b: &[Vec<f32>],
+) -> bool {
+    a.len() == b.len()
+        && a.iter().zip(b).all(|(x, y)| x.len() == y.len() && x.iter().zip(y).all(|(a, b)| a.to_bits() == b.to_bits()))
+}
+
+fn gpu_seconds() -> f64 {
+    profile::snapshot().get("native.metal.gpu").map_or(0.0, |c| c.seconds)
+}
+
+fn validate_head(model: &GlmModel) -> Result<()> {
+    let c = &model.config;
+    if c.hidden != 4096
+        || c.hc != 4
+        || c.layer_types.len() != 45
+        || c.active_experts != 8
+        || c.kv_rank != 512
+        || c.index_pool != 4
+        || c.index_dim != 128
+        || c.expert_intermediate != 2048
+        || model.weights.names().iter().filter(|n| n.starts_with("blk.45.")).count() != 29
+    {
+        return Err(Error::Invalid("MTP model geometry"));
+    }
+    for (name, dims) in [
+        ("nextn.eh_proj.weight", vec![4096, 8192]),
+        ("nextn.enorm.weight", vec![4096]),
+        ("nextn.hnorm.weight", vec![4096]),
+        ("nextn.shared_head_norm.weight", vec![4096]),
+        ("attn_norm.weight", vec![4096]),
+        ("ffn_norm.weight", vec![4096]),
+        ("ffn_gate_inp.weight", vec![288, 4096]),
+        ("ffn_down_shexp.weight", vec![4096, 2048]),
+    ] {
+        shape(&model.weights, &format!("blk.45.{name}"), &dims)?;
+    }
+    if model.weights.names().iter().any(|n| n.starts_with("blk.45.hc_") || n.starts_with("blk.45.ssm_")) {
+        return Err(Error::Invalid("MTP must be mHC-free MLA"));
+    }
+    Ok(())
+}
+
+fn probe() -> Result<Value> {
+    let mut bytes = Vec::new();
+    std::io::stdin().take(128 * 1024 + 1).read_to_end(&mut bytes)?;
+    if bytes.len() > 128 * 1024 {
+        return Err(Error::Invalid("MTP stdin bound"));
+    }
+    let request: Request = serde_json::from_slice(&bytes).map_err(|_| Error::Invalid("MTP stdin schema"))?;
+    if request.schema_version != 1
+        || !(1..=4).contains(&request.cases.len())
+        || !(1..=16).contains(&request.continuation_tokens)
+        || request.context_tokens != 256
+        || request.corpus_sha256.len() != 64
+        || !request.corpus_sha256.bytes().all(|b| b.is_ascii_hexdigit())
+        || request.cases.iter().any(|c| !(8..=128).contains(&c.input_token_ids.len()))
+    {
+        return Err(Error::Invalid("MTP stdin admission"));
+    }
+    let ids = request.cases.iter().map(|c| &c.input_token_ids).collect::<Vec<_>>();
+    let encoded = serde_json::to_vec(&ids).map_err(|_| Error::Invalid("MTP stdin schema"))?;
+    if format!("{:x}", Sha256::digest(&encoded)) != request.corpus_sha256 {
+        return Err(Error::Invalid("MTP stdin admission"));
+    }
+    for name in ["STARK_GLM53_ENCODER_BANKS", "STARK_GLM53_RESIDENT_BANKS", "STARK_GLM53_WIDE_ENCODER"] {
+        if std::env::var_os(name).is_none_or(|v| v != "1") {
+            return Err(Error::Invalid("MTP target policy required"));
+        }
+    }
+    for name in ["STARK_GLM53_GREEDY_OVERLAP", "STARK_GLM53_PREFILL_MMA", "STARK_GLM53_SCRATCH_HEAP"] {
+        if std::env::var_os(name).is_some_and(|v| v == "1") {
+            return Err(Error::Invalid("MTP probe is serial only"));
+        }
+    }
+    let path =
+        PathBuf::from(std::env::var_os("STARK_GLM53_MTP_PROBE_MODEL_PATH").ok_or(Error::Invalid("MTP model path"))?);
+    let config: Value = serde_json::from_slice(&std::fs::read(path.join("config.json"))?)
+        .map_err(|_| Error::Invalid("MTP model config"))?;
+    let source: Value = serde_json::from_slice(&std::fs::read(path.join("native-source.json"))?)
+        .map_err(|_| Error::Invalid("MTP model provenance"))?;
+    if source["architecture"].as_str() != Some("glm5_next")
+        || source["weights_source"]["revision"].as_str() != Some("a38483c8cd5df544f53d70fb281afe97369d5ab6")
+        || source["metadata_source"]["revision"].as_str() != Some("04c4e9e95c5da8862dced7e5056455116f83a7e0")
+    {
+        return Err(Error::Invalid("MTP model provenance"));
+    }
+    let mut model = GlmModel::new(Weights::open(&path)?, &config)?;
+    validate_head(&model)?;
+    if request.cases.iter().any(|row| {
+        row.input_token_ids.iter().any(|&t| t as usize >= model.config.vocab)
+            || row.input_token_ids.len() + request.continuation_tokens + 1 > request.context_tokens
+    }) {
+        return Err(Error::Invalid("MTP corpus bounds"));
+    }
+    model.decode = Some(MetalDecode::new(&model.weights, &model.config, model.hyper_connections.as_deref())?);
+    // Mirror production ownership after controls move to Metal. The ordinary
+    // graph reference below reuses this initialized decode, so it needs no CPU
+    // control-weight copy. Do not retain test-only duplicate model weights.
+    model.hyper_connections = None;
+    let generation: Value = serde_json::from_slice(&std::fs::read(path.join("generation_config.json"))?)
+        .map_err(|_| Error::Invalid("MTP generation config"))?;
+    let eos = match &generation["eos_token_id"] {
+        Value::Number(n) => {
+            vec![n.as_u64().and_then(|n| u32::try_from(n).ok()).ok_or(Error::Invalid("MTP EOS config"))?]
+        },
+        Value::Array(values) => values
+            .iter()
+            .map(|v| v.as_u64().and_then(|n| u32::try_from(n).ok()).ok_or(Error::Invalid("MTP EOS config")))
+            .collect::<Result<Vec<_>>>()?,
+        _ => return Err(Error::Invalid("MTP EOS config")),
+    };
+    if eos.is_empty() || eos.iter().any(|&n| n as usize >= model.config.vocab) {
+        return Err(Error::Invalid("MTP EOS config"));
+    }
+    let extra = model.weights.mtp_probe_extra_bytes(request.context_tokens)?;
+    let mut memory = Receipt::default();
+    model.weights.mtp_probe_observe(extra, &mut memory)?;
+    profile::enable(true);
+    profile::reset();
+    // Explicit alignment proof: first eight target rows match the ordinary
+    // API's full logits; full-head and chunked cache-only catch-up agree exactly.
+    let initial = &request.cases[0].input_token_ids[..8];
+    let mut target_rows = Vec::with_capacity(8);
+    for &t in initial {
+        target_rows.push(target_row(&mut model, t, true, true, extra, &mut memory)?);
+    }
+    model.reset();
+    for (&t, reference) in initial.iter().zip(&target_rows) {
+        let ordinary = model.step(t)?;
+        let expected = reference.logits.as_ref().ok_or(Error::Invalid("MTP missing reference"))?;
+        if ordinary.len() != expected.len()
+            || ordinary.iter().zip(expected).any(|(a, b)| a.to_bits() != b.to_bits())
+            || Some(choice(&ordinary)?) != reference.choice
+        {
+            return Err(Error::Invalid("MTP target-tap parity"));
+        }
+    }
+    let mut full = Head::new(&model, request.context_tokens)?;
+    let mut chunked = Head::new(&model, request.context_tokens)?;
+    let zero = vec![0.0; 4096];
+    let mut final_full = None;
+    let mut cold_full_head_ms = 0.0;
+    for (i, &t) in initial.iter().enumerate() {
+        let started = Instant::now();
+        final_full = full.row(
+            &model,
+            if i == 0 {
+                &zero
+            } else {
+                &target_rows[i - 1].hidden
+            },
+            t,
+            i,
+            true,
+            extra,
+            &mut memory,
+        )?;
+        if i == 0 {
+            cold_full_head_ms = started.elapsed().as_secs_f64() * 1000.0;
+        }
+    }
+    let mut at = 0;
+    let mut final_chunked = None;
+    for size in [1, 3, 4] {
+        for _ in 0..size {
+            final_chunked = chunked.row(
+                &model,
+                if at == 0 {
+                    &zero
+                } else {
+                    &target_rows[at - 1].hidden
+                },
+                initial[at],
+                at,
+                at == 7,
+                extra,
+                &mut memory,
+            )?;
+            at += 1;
+        }
+    }
+    if final_full != final_chunked
+        || !same_rows(&full.attention.mtp_probe_cache()?, &chunked.attention.mtp_probe_cache()?)
+    {
+        return Err(Error::Invalid("MTP shifted cache alignment parity"));
+    }
+    drop(full);
+    drop(chunked);
+    drop(target_rows);
+    model.reset();
+    let static_entries = memory.static_cache_entries_peak;
+    let static_bytes = memory.static_cache_peak_bytes;
+    let mut agreement = 0usize;
+    let mut comparisons = 0usize;
+    let mut prompt_rows = 0usize;
+    let mut head_prefill_ms = 0.0;
+    let mut head_decode_ms = 0.0;
+    let mut target_decode_ms = 0.0;
+    let mut first_prefill_cache_ms = 0.0;
+    let mut head_decode_gpu_ms = 0.0;
+    let mut target_decode_gpu_ms = 0.0;
+    let mut eos_cases = 0usize;
+    let mut output_hash = Sha256::new();
+    let mut case_rows = serde_json::Map::new();
+    hp::reset();
+    for (case_index, case) in request.cases.iter().enumerate() {
+        model.reset();
+        let mut head = Head::new(&model, request.context_tokens)?;
+        let mut hidden = vec![0.0; 4096];
+        let mut pending = None;
+        for (i, &t) in case.input_token_ids.iter().enumerate() {
+            let started = Instant::now();
+            let _ = head.row(&model, &hidden, t, i, false, extra, &mut memory)?;
+            let ms = started.elapsed().as_secs_f64() * 1000.0;
+            if prompt_rows == 0 {
+                first_prefill_cache_ms = ms;
+            }
+            head_prefill_ms += ms;
+            prompt_rows += 1;
+            let row = target_row(&mut model, t, i + 1 == case.input_token_ids.len(), false, extra, &mut memory)?;
+            hidden = row.hidden;
+            pending = row.choice;
+        }
+        let mut case_agree = 0;
+        let mut case_comparisons = 0;
+        for _ in 0..request.continuation_tokens {
+            let t = pending.ok_or(Error::Invalid("MTP pending target token"))?;
+            if eos.contains(&t) {
+                eos_cases += 1;
+                break;
+            }
+            let gpu_before = gpu_seconds();
+            hp::active(true);
+            let started = Instant::now();
+            let draft_result = head.row(&model, &hidden, t, model.position, true, extra, &mut memory);
+            head_decode_ms += started.elapsed().as_secs_f64() * 1000.0;
+            hp::active(false);
+            let draft = draft_result?.ok_or(Error::Invalid("MTP draft index"))?;
+            head_decode_gpu_ms += (gpu_seconds() - gpu_before) * 1000.0;
+            let gpu_before = gpu_seconds();
+            let started = Instant::now();
+            let row = target_row(&mut model, t, true, false, extra, &mut memory)?;
+            target_decode_ms += started.elapsed().as_secs_f64() * 1000.0;
+            target_decode_gpu_ms += (gpu_seconds() - gpu_before) * 1000.0;
+            let next = row.choice.ok_or(Error::Invalid("MTP target index"))?;
+            case_agree += usize::from(draft == next);
+            comparisons += 1;
+            case_comparisons += 1;
+            output_hash.update(next.to_le_bytes());
+            hidden = row.hidden;
+            pending = Some(next);
+        }
+        agreement += case_agree;
+        case_rows.insert(
+            format!("case_{case_index}"),
+            serde_json::json!({"comparisons": case_comparisons, "agreements": case_agree}),
+        );
+        if memory.static_cache_entries_peak != static_entries || memory.static_cache_peak_bytes != static_bytes {
+            return Err(Error::Invalid("MTP static registrations crept after warm-up"));
+        }
+    }
+    let counters = profile::snapshot();
+    let (head_profile_wall, head_profile_gpu, head_profile_calls) = hp::snapshot();
+    profile::enable(false);
+    if let Some(counter) = counters.get("native.metal.allocated_bytes") {
+        memory.sampled_metal_allocated_peak_bytes =
+            memory.sampled_metal_allocated_peak_bytes.max(counter.max_bytes as usize);
+    }
+    model.weights.mtp_probe_observe(extra, &mut memory)?;
+    if comparisons == 0
+        || memory.selected_live_bytes_at_return != 0
+        || memory.selected_calls != memory.released_owner_checks
+        || memory.sampled_metal_allocated_peak_bytes > memory.admitted_cap_bytes
+    {
+        return Err(Error::Invalid("MTP final memory gate"));
+    }
+    model.reset();
+    Ok(serde_json::json!({"glm_mtp_probe_result": true, "aggregate": {
+        "status": "component_probe_complete_no_speculative_runtime", "precision": "existing_safe_f32_graph_quant_weights_cpu_f32_router",
+        "source_convention": SOURCE, "memory_gauges": memory,
+        "head_profile_schema": hp::SCHEMA, "head_profile_v4_wall_ms": head_profile_wall,
+        "head_profile_v4_gpu_ms": head_profile_gpu, "head_profile_v4_calls": head_profile_calls,
+        "counts": {"cases": request.cases.len(), "prompt_rows": prompt_rows, "comparisons": comparisons, "agreements": agreement, "eos_cases": eos_cases,
+            "alignment_target_rows": 8, "alignment_cache_rows": 8, "alignment_chunk_groups": 3, "target_rollback_calls": 0},
+        "timing_ms": {"cold_full_head_wall_including_lazy_pipeline_compile": cold_full_head_ms,
+            "first_measured_prefill_cache_row_wall": first_prefill_cache_ms, "prefill_cache_only_head_wall": head_prefill_ms,
+            "decode_head_wall": head_decode_ms, "serial_target_with_hidden_tap_wall": target_decode_ms,
+            "decode_head_gpu": head_decode_gpu_ms, "serial_target_with_hidden_tap_gpu": target_decode_gpu_ms},
+        "hashes": {"corpus_sha256": request.corpus_sha256, "target_continuation_sha256": format!("{:x}", output_hash.finalize())},
+        "rows": case_rows
+    }}))
+}
+
+#[stark_test]
+#[ignore]
+fn glm_mtp_one_step_probe() {
+    let result = objc2::rc::autoreleasepool(|_| probe());
+    match result {
+        Ok(aggregate) => println!("{aggregate}"),
+        Err(error) => {
+            hp::active(false);
+            profile::enable(false);
+            // Only fixed enum labels cross the process boundary. Never format
+            // an Error, request, model value, or captured process output.
+            let guard = match error {
+                Error::Invalid("MTP stdin bound") => "stdin_bound",
+                Error::Invalid("MTP stdin schema") => "stdin_schema",
+                Error::Invalid("MTP stdin admission") => "stdin_admission",
+                Error::Invalid("MTP target policy required" | "MTP probe is serial only") => "target_policy",
+                Error::Invalid("MTP static registrations crept after warm-up") => "static_cache_growth",
+                Error::Invalid(code)
+                    if code.contains("parity") || code.contains("alignment") || code.contains("tap") =>
+                {
+                    "alignment_parity"
+                },
+                Error::Invalid(code)
+                    if code.contains("cap")
+                        || code.contains("resident")
+                        || code.contains("selected")
+                        || code.contains("alloc")
+                        || code.contains("memory") =>
+                {
+                    "memory_gate"
+                },
+                Error::Io(_) => "model_load",
+                _ => "probe_rejected",
+            };
+            println!(
+                "{}",
+                serde_json::json!({"glm_mtp_probe_result":true,"aggregate":{
+                    "status":"rejected","source_convention":SOURCE,"rows":{"failure":{"guard":guard}}
+                }})
+            );
+            panic!("MTP aggregate probe failed; no private values are reported");
+        },
+    }
+}
diff --git a/crates/stark-engine/src/engine/hybrid/weights_mtp_probe.rs b/crates/stark-engine/src/engine/hybrid/weights_mtp_probe.rs
