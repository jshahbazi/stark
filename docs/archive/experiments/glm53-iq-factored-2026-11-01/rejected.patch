--- /dev/null
+++ b/crates/stark-engine/src/engine/hybrid/packed_iq_factored_matvec.metal
@@ -0,0 +1,87 @@
+// Original Stark vector-factored IQ2_XS/IQ3_XXS dot. Source layout and tables
+// retain packed_matvec.metal/LICENSE.ggml-hybrid provenance. Stored weights
+// are unchanged; the local dot and scale association are separately qualified.
+
+inline float hybrid_iq_factored_dot_vector8(device const uchar *codes, device const float *input,
+    ulong row_offset, ulong input_offset, uint columns, uint lane) {
+    const uint kind = hybrid_packed_kind;
+    float sum = 0.0f;
+    bool reference_required = false;
+    for (uint col = lane * 8; col < columns; col += 256) {
+        device const uchar *block = codes + row_offset + ulong(col >> 8) * hybrid_packed_block_bytes;
+        const uint part = (col & 255) >> 5;
+        const uint l = (col & 31) >> 3;
+        uint signs;
+        uint2 grid;
+        float scale;
+        if (kind == 17) {
+            const uint q = hybrid_u16(block + 2 + part * 8 + l * 2);
+            const uint scales = block[66 + part];
+            const ulong packed = iq2xs_grid[q & 511];
+            grid = uint2(uint(packed), uint(packed >> 32));
+            signs = ksigns[q >> 9];
+            scale = hybrid_half(block) * (0.5f + float((scales >> (l < 2 ? 0 : 4)) & 15)) * 0.25f;
+        } else {
+            const uint ss = hybrid_u32(block + 66 + part * 4);
+            signs = ksigns[(ss >> (7 * l)) & 127];
+            const uint at = 2 + part * 8 + 2 * l;
+            grid = uint2(iq3xxs_grid[block[at]], iq3xxs_grid[block[at + 1]]);
+            scale = hybrid_half(block) * (0.5f + float(ss >> 28)) * 0.5f;
+        }
+        const float4 x0 = float4(input[input_offset + col], input[input_offset + col + 1],
+            input[input_offset + col + 2], input[input_offset + col + 3]);
+        const float4 x1 = float4(input[input_offset + col + 4], input[input_offset + col + 5],
+            input[input_offset + col + 6], input[input_offset + col + 7]);
+        reference_required = reference_required || any(abs(x0) > float4(1e20f)) || any(abs(x1) > float4(1e20f));
+        const uint4 mask0 = ((uint4(signs) >> uint4(0, 1, 2, 3)) & 1u) << 31;
+        const uint4 mask1 = ((uint4(signs) >> uint4(4, 5, 6, 7)) & 1u) << 31;
+        const float4 signed0 = as_type<float4>(as_type<uint4>(x0) ^ mask0);
+        const float4 signed1 = as_type<float4>(as_type<uint4>(x1) ^ mask1);
+        const float4 code0 = float4(as_type<uchar4>(grid.x));
+        const float4 code1 = float4(as_type<uchar4>(grid.y));
+        sum += scale * (dot(code0, signed0) + dot(code1, signed1));
+    }
+    // Finite encoded scales bound decoded magnitudes below 2.7e8. At bounded
+    // inputs all admitted absolute product sums stay below F32 overflow. Larger
+    // inputs use the old row so factoring cannot mask an overflowing product.
+    if (simd_any(reference_required)) {
+        return hybrid_iq_dot_vector8(codes, input, row_offset, input_offset, columns, lane);
+    }
+    return simd_sum(sum);
+}
+
+kernel void hybrid_iq_factored_matvec_vector8(
+    device const uchar *codes_base [[buffer(0)]], device const float *input [[buffer(1)]],
+    device float *output [[buffer(2)]], constant HybridMatrixParams &p [[buffer(3)]],
+    constant uint4 &offsets [[buffer(6)]], uint tile [[threadgroup_position_in_grid]],
+    uint lane [[thread_index_in_simdgroup]], uint simd_group [[simdgroup_index_in_threadgroup]]) {
+    const uint row = tile * 8 + simd_group;
+    if (row >= p.rows) return;
+    const ulong row_offset = ulong(row) * (p.columns >> 8) * hybrid_packed_block_bytes;
+    const ulong input_offset = p.group ? ulong(row / p.group) * p.columns : 0;
+    const float total = hybrid_iq_factored_dot_vector8(codes_base + offsets.x, input, row_offset, input_offset, p.columns, lane);
+    if (lane == 0) output[row] = total;
+}
+
+kernel void hybrid_graph_iq_indexed_factored_vector8(
+    device const uchar *codes [[buffer(0)]], device const float *input [[buffer(1)]],
+    device float *output [[buffer(2)]], constant uint *p [[buffer(3)]],
+    device const uint *indices [[buffer(6)]], device atomic_uint *failure [[buffer(30)]],
+    uint2 grid [[threadgroup_position_in_grid]], uint lane [[thread_index_in_simdgroup]],
+    uint simd_group [[simdgroup_index_in_threadgroup]]) {
+    const uint row = grid.x * 8 + simd_group;
+    if (row >= p[0]) return;
+    const uint batch = grid.y;
+    const uint expert = indices[batch];
+    if (expert >= p[2]) {
+        if (lane == 0) {
+            output[batch * p[0] + row] = 0.0f;
+            atomic_store_explicit(failure, 1u, memory_order_relaxed);
+        }
+        return;
+    }
+    const ulong at = (ulong(expert) * p[0] + row) * (p[1] >> 8) * hybrid_packed_block_bytes;
+    const ulong input_offset = p[3] ? ulong(batch) * p[1] : 0;
+    const float total = hybrid_iq_factored_dot_vector8(codes, input, at, input_offset, p[1], lane);
+    if (lane == 0) output[batch * p[0] + row] = total;
+}
