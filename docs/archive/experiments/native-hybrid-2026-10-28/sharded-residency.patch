+
+fn use_weight_residency(
+    command: &ProtocolObject<dyn MTLCommandBuffer>,
+    operations: &[MappedOperation<'_>],
+) {
+    let mut used = Vec::<&Arc<super::bank_residency::ResidencyShard>>::new();
+    for matrix in operations.iter().flat_map(|operation| &operation.matrices) {
+        let views =
+            std::iter::once(&matrix.codes).chain(matrix.planes.iter().flat_map(|(scales, biases)| [scales, biases]));
+        for allocation in views.filter_map(|view| view.residency.as_ref()) {
+            let set = allocation.shard();
+            if !used.iter().any(|old| Arc::ptr_eq(old, set)) {
+                set.use_in(command);
+                used.push(set);
+            }
+        }
+    }
 }

