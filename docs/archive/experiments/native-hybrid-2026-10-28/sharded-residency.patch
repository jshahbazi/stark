+//! Best-effort Metal preparation of admitted immutable weight banks.
+//! Each residency set holds at most 5% of the recommended working set, with
+//! at most 32 sets. A residency request is an OS hint, not physical page pinning.
+//!
+//! The sharding policy follows the public MLX allocator design; this lease and
+//! accounting implementation is original Stark code. See benchmark provenance.
+
+use std::sync::{Arc, Mutex};
+
+use metal::{MTLBuffer, MTLCommandBuffer, MTLDevice, MTLDeviceExt, MTLResidencySet, MTLResidencySetDescriptor};
+use objc2::{rc::Retained, runtime::ProtocolObject};
+
+use super::{Error, Result};
+
+const MAX_SHARDS: usize = 32;
+type Buffer = Retained<ProtocolObject<dyn MTLBuffer>>;
+
+struct Pool {
+    shards: Vec<Arc<ResidencyShard>>,
+}
+
+pub(super) struct BankResidency {
+    device: Retained<ProtocolObject<dyn MTLDevice>>,
+    shard_budget: usize,
+    total_budget: usize,
+    pool: Mutex<Pool>,
+}
+
+pub(super) struct ResidencyShard {
+    set: Retained<ProtocolObject<dyn MTLResidencySet>>,
+    bytes: Mutex<usize>,
+}
+
+/// The manager and active views own shards; a shard owns no leases. Releasing
+/// the last view of a buffer removes that buffer from its actual shard, even
+/// after the manager or its cache entry has been dropped.
+pub(super) struct BankAllocation {
+    shard: Arc<ResidencyShard>,
+    buffer: Buffer,
+    bytes: usize,
+}
+
+impl BankAllocation {
+    pub(super) fn shard(&self) -> &Arc<ResidencyShard> {
+        &self.shard
+    }
+}
+
+impl Drop for BankAllocation {
+    fn drop(&mut self) {
+        let mut bytes = self.shard.bytes.lock().unwrap_or_else(|error| error.into_inner());
+        self.shard.set.remove_allocation(self.buffer.as_ref());
+        self.shard.set.commit();
+        *bytes -= self.bytes;
+    }
+}
+
+impl ResidencyShard {
+    fn new(device: &ProtocolObject<dyn MTLDevice>) -> Result<Self> {
+        let descriptor = MTLResidencySetDescriptor::new();
+        descriptor.set_initial_capacity(64);
+        let set = device
+            .new_residency_set_with_descriptor(&descriptor)
+            .map_err(|_| Error::Unsupported("Metal bank residency unavailable"))?;
+        // A single standing request covers later commits, which update the
+        // resident set. Pair it with end_residency when the last owner drops.
+        set.request_residency();
+        Ok(Self {
+            set,
+            bytes: Mutex::new(0),
+        })
+    }
+
+    pub(super) fn use_in(
+        &self,
+        command: &ProtocolObject<dyn MTLCommandBuffer>,
+    ) {
+        command.use_residency_set(&self.set);
+    }
+}
+
+impl Drop for ResidencyShard {
+    fn drop(&mut self) {
+        self.set.end_residency();
+        self.set.remove_all_allocations();
+        self.set.commit();
+    }
+}
+
+impl BankResidency {
+    pub(super) fn new(admitted_bytes: usize) -> Result<Self> {
+        let device = <dyn MTLDevice>::system_default().ok_or(Error::Unsupported("Metal device unavailable"))?;
+        let shard_budget = device.recommended_max_working_set_size() as usize / 20;
+        Self::with_limits(device, shard_budget, admitted_bytes)
+    }
+
+    fn with_limits(
+        device: Retained<ProtocolObject<dyn MTLDevice>>,
+        shard_budget: usize,
+        total_budget: usize,
+    ) -> Result<Self> {
+        if shard_budget == 0 {
+            return Err(Error::Unsupported("Metal residency shard budget unavailable"));
+        }
+        // Establish availability before model readiness, preserving the
+        // caller's optional-residency fallback on unsupported Metal devices.
+        let initial = Arc::new(ResidencyShard::new(&device)?);
+        Ok(Self {
+            device,
+            shard_budget,
+            total_budget,
+            pool: Mutex::new(Pool {
+                shards: vec![initial],
+            }),
+        })
+    }
+
+    /// A buffer larger than one shard, or a full pool, keeps its ordinary
+    /// mapped-buffer path. Optional residency hints never enlarge admission.
+    pub(super) fn add(
+        self: &Arc<Self>,
+        buffer: &Buffer,
+    ) -> Result<Option<Arc<BankAllocation>>> {
+        let resource: &ProtocolObject<dyn metal::MTLResource> = buffer.as_ref();
+        let bytes = buffer.length().max(metal::MTLResource::allocated_size(resource));
+        if bytes == 0 || bytes > self.shard_budget {
+            return Ok(None);
+        }
+        let mut pool = self.pool.lock().map_err(|_| Error::Invalid("Metal residency pool update failed"))?;
+        let mut total = 0usize;
+        let mut selected = None;
+        for shard in &pool.shards {
+            let used_guard = shard.bytes.lock().map_err(|_| Error::Invalid("Metal residency shard update failed"))?;
+            // MappedSlice clones share their existing lease. A repeated add of
+            // the same buffer gets no second lease: two independent drops
+            // must never remove one another's set membership.
+            if shard.set.contains_allocation(buffer.as_ref()) {
+                return Ok(None);
+            }
+            let used = *used_guard;
+            total = total.checked_add(used).ok_or(Error::Invalid("Metal residency accounting overflow"))?;
+            if selected.is_none() && used <= self.shard_budget - bytes {
+                selected = Some(Arc::clone(shard));
+            }
+        }
+        if total.checked_add(bytes).is_none_or(|sum| sum > self.total_budget) {
+            return Ok(None);
+        }
+        let shard = match selected {
+            Some(shard) => shard,
+            None if pool.shards.len() < MAX_SHARDS => {
+                let Ok(shard) = ResidencyShard::new(&self.device) else {
+                    return Ok(None);
+                };
+                let shard = Arc::new(shard);
+                pool.shards.push(Arc::clone(&shard));
+                shard
+            },
+            None => return Ok(None),
+        };
+        {
+            let mut used = shard.bytes.lock().map_err(|_| Error::Invalid("Metal residency shard update failed"))?;
+            shard.set.add_allocation(buffer.as_ref());
+            shard.set.commit();
+            *used += bytes;
+            super::profile::record("native.metal.bank_residency.shard_bytes", 0.0, *used);
+        }
+        let allocation = Arc::new(BankAllocation {
+            shard,
+            buffer: buffer.clone(),
+            bytes,
+        });
+        super::profile::record("native.metal.bank_residency.bytes", 0.0, total + bytes);
+        super::profile::record("native.metal.bank_residency.shards", 0.0, pool.shards.len());
+        Ok(Some(allocation))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use metal::MTLResourceOptions;
+    use stark_engine_macros::stark_test;
+
+    use super::*;
+
+    fn fixture(
+        shard_budget: usize,
+        total_budget: usize,
+    ) -> (Retained<ProtocolObject<dyn MTLDevice>>, Arc<BankResidency>) {
+        let device = <dyn MTLDevice>::system_default().unwrap();
+        let residency = Arc::new(BankResidency::with_limits(device.clone(), shard_budget, total_budget).unwrap());
+        (device, residency)
+    }
+
+    #[stark_test]
+    fn residency_membership_lasts_until_last_view_lease() {
+        let (device, residency) = fixture(32_768, 65_536);
+        let buffer = device.new_buffer(16_384, MTLResourceOptions::STORAGE_MODE_SHARED).unwrap();
+        let lease = residency.add(&buffer).unwrap().unwrap();
+        assert!(residency.add(&buffer).unwrap().is_none());
+        let shard = Arc::downgrade(lease.shard());
+        assert_eq!(lease.shard.set.allocation_count(), 1);
+        let active_view = Arc::clone(&lease);
+        drop(lease);
+        assert_eq!(shard.upgrade().unwrap().set.allocation_count(), 1);
+        drop(active_view);
+        assert_eq!(shard.upgrade().unwrap().set.allocation_count(), 0);
+        let lease = residency.add(&buffer).unwrap().unwrap();
+        let shard = Arc::downgrade(lease.shard());
+        drop(residency);
+        assert!(shard.upgrade().is_some());
+        drop(lease);
+        assert!(shard.upgrade().is_none(), "last view retained its residency shard");
+    }
+
+    #[stark_test]
+    fn residency_shards_pack_bounded_buffers_and_reuse_released_capacity() {
+        let (device, residency) = fixture(32_768, 65_536);
+        let make = |bytes| device.new_buffer(bytes, MTLResourceOptions::STORAGE_MODE_SHARED).unwrap();
+        let a = residency.add(&make(16_384)).unwrap().unwrap();
+        let b = residency.add(&make(16_384)).unwrap().unwrap();
+        let c = residency.add(&make(16_384)).unwrap().unwrap();
+        assert!(Arc::ptr_eq(a.shard(), b.shard()));
+        assert!(!Arc::ptr_eq(a.shard(), c.shard()));
+        let d = residency.add(&make(16_384)).unwrap().unwrap();
+        assert!(residency.add(&make(16_384)).unwrap().is_none());
+        assert!(residency.add(&make(32_769)).unwrap().is_none());
+        drop(a);
+        let replacement = residency.add(&make(16_384)).unwrap().unwrap();
+        assert!(Arc::ptr_eq(b.shard(), replacement.shard()));
+        let pool = residency.pool.lock().unwrap();
+        assert_eq!(pool.shards.len(), 2);
+        assert!(pool.shards.iter().all(|shard| *shard.bytes.lock().unwrap() <= 32_768));
+        drop(pool);
+        drop((b, c, d, replacement));
+        assert!(residency.pool.lock().unwrap().shards.iter().all(|shard| shard.set.allocation_count() == 0));
+    }
+
+    #[stark_test]
+    fn residency_pool_never_exceeds_thirty_two_shards() {
+        let (device, residency) = fixture(16_384, 16_384 * 33);
+        let mut leases = Vec::new();
+        for _ in 0..MAX_SHARDS {
+            let buffer = device.new_buffer(16_384, MTLResourceOptions::STORAGE_MODE_SHARED).unwrap();
+            leases.push(residency.add(&buffer).unwrap().unwrap());
+        }
+        let overflow = device.new_buffer(16_384, MTLResourceOptions::STORAGE_MODE_SHARED).unwrap();
+        assert!(residency.add(&overflow).unwrap().is_none());
+        assert_eq!(residency.pool.lock().unwrap().shards.len(), MAX_SHARDS);
+        leases.pop();
+        assert!(residency.add(&overflow).unwrap().is_some());
+    }
+}
