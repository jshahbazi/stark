+fn wait_for_completion(command: &ProtocolObject<dyn MTLCommandBuffer>) {
+    // A bounded active interval avoids a thread sleep/wakeup for the many
+    // submillisecond matrix commands. Long commands still use Metal's blocking
+    // wait, and every path retains that final wait as the completion barrier.
+    let poll = profile::Scope::new("native.metal.poll");
+    let started = Instant::now();
+    let budget = Duration::from_micros(200);
+    while !matches!(command.status(), MTLCommandBufferStatus::Completed | MTLCommandBufferStatus::Error)
+        && started.elapsed() < budget
+    {
+        std::hint::spin_loop();
+    }
+    drop(poll);
+    let _blocking = profile::Scope::new("native.metal.blocking_wait");
+    command.wait_until_completed();
+}
