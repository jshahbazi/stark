+    #[cfg(feature = "metal")]
+    #[stark_test]
+    fn selected_view_cache_reuses_duplicate_experts_and_accounts_rounded_spans() {
+        struct DisableProfile;
+        impl Drop for DisableProfile {
+            fn drop(&mut self) {
+                super::super::profile::enable(false);
+            }
+        }
+        let _disable = DisableProfile;
+        super::super::profile::reset();
+        super::super::profile::enable(true);
+        let fixture = Fixture::new();
+        let data: Vec<_> = (1..=4).flat_map(|expert| (expert as f32).to_le_bytes().repeat(64)).collect();
+        safetensors(&fixture.0.join("model.safetensors"), &[("experts", "F32", vec![4, 2, 32], data)]);
+        fs::write(fixture.0.join("config.json"), b"{}").unwrap();
+        let weights = Weights::open(&fixture.0).unwrap();
+        let tensor = weights.tensor("experts").unwrap();
+        let matrix_bytes = tensor.size / tensor.shape[0];
+        let registered = weights.files[tensor.file].metal_span(tensor.offset, matrix_bytes).unwrap().1;
+        *weights.bank_views.lock().unwrap() = StaticViewCache::new(0);
+        *weights.selected_views.lock().unwrap() = StaticViewCache::new(2 * registered);
+        let weak = Arc::downgrade(&weights.files[0]);
+        let input = vec![1.0; 32];
+        assert_eq!(
+            weights.selected_matvec("experts", &[3, 1, 3], &input.repeat(3)).unwrap(),
+            [128.0, 128.0, 64.0, 64.0, 128.0, 128.0]
+        );
+        assert_eq!(weights.selected_matvec("experts", &[1, 0], &input.repeat(2)).unwrap(), [64.0, 64.0, 32.0, 32.0]);
+        {
+            let cache = weights.selected_views.lock().unwrap();
+            assert_eq!(cache.entries.len(), 2);
+            assert_eq!(cache.order.len(), 2);
+            assert_eq!(
+                cache.registered_bytes,
+                cache.entries.values().map(|view| view.registered_bytes()).sum::<usize>()
+            );
+            assert!(cache.registered_bytes <= cache.limit);
+        }
+        assert!(weights.bank_views.lock().unwrap().entries.is_empty());
+        assert!(weights.static_views.lock().unwrap().entries.is_empty());
+        let counters = super::super::profile::snapshot();
+        assert_eq!(counters["native.metal.expert_cache.hit"].calls, 2);
+        assert_eq!(counters["native.metal.expert_cache.miss"].calls, 3);
+        assert_eq!(counters["native.metal.expert_cache.eviction"].calls, 1);
+        assert!(!counters.contains_key("native.metal.static_cache.eviction"));
+        drop(weights);
+        for _ in 0..100 {
+            if weak.upgrade().is_none() {
+                break;
+            }
+            std::thread::sleep(std::time::Duration::from_millis(1));
+        }
+        assert!(weak.upgrade().is_none(), "selected cache retained its source mapping after drop");
+    }
