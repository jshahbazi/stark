+    #[cfg(feature = "metal")]
+    #[stark_test]
+    fn selected_view_cache_preserves_evicted_active_views_and_zero_budget_fallback() {
+        let fixture = Fixture::new();
+        let data: Vec<_> = (1..=4).flat_map(|expert| (expert as f32).to_le_bytes().repeat(64)).collect();
+        safetensors(&fixture.0.join("model.safetensors"), &[("experts", "F32", vec![4, 2, 32], data)]);
+        fs::write(fixture.0.join("config.json"), b"{}").unwrap();
+        let weights = Weights::open(&fixture.0).unwrap();
+        let tensor = weights.tensor("experts").unwrap();
+        let bytes = tensor.size / tensor.shape[0];
+        let registered = weights.files[tensor.file].metal_span(tensor.offset, bytes).unwrap().1;
+        *weights.bank_views.lock().unwrap() = StaticViewCache::new(0);
+        *weights.selected_views.lock().unwrap() = StaticViewCache::new(registered);
+        let active = weights.bank_view(tensor, 0, bytes).unwrap();
+        let replacement = weights.bank_view(tensor, bytes, bytes).unwrap();
+        assert_eq!(weights.selected_views.lock().unwrap().entries.len(), 1);
+        assert_eq!(weights.selected_views.lock().unwrap().registered_bytes, registered);
+        let input = vec![1.0; 32];
+        let operation = |codes| super::super::weight_metal::MappedOperation {
+            matrices: vec![super::super::weight_metal::MappedMatrix {
+                codes,
+                planes: None,
+            }],
+            inputs: input.as_slice(),
+            rows: 2,
+            columns: 32,
+            rows_per_batch: 0,
+            format: super::super::weight_metal::MatrixFormat::Packed(0),
+        };
+        let active_operation = operation(active);
+        assert_eq!(
+            super::super::weight_metal::mapped_many(std::slice::from_ref(&active_operation)).unwrap(),
+            [vec![32.0; 2]]
+        );
+        assert_eq!(super::super::weight_metal::mapped_many(&[operation(replacement)]).unwrap(), [vec![64.0; 2]]);
+        *weights.selected_views.lock().unwrap() = StaticViewCache::new(0);
+        assert_eq!(weights.expert_matvec("experts", 2, &input).unwrap(), [96.0; 2]);
+        {
+            let cache = weights.selected_views.lock().unwrap();
+            assert!(cache.entries.is_empty());
+            assert!(cache.order.is_empty());
+            assert_eq!(cache.registered_bytes, 0);
+        }
+        let weak = Arc::downgrade(&weights.files[0]);
+        drop(weights);
+        assert!(weak.upgrade().is_some(), "active evicted view lost its source mapping");
+        assert_eq!(
+            super::super::weight_metal::mapped_many(std::slice::from_ref(&active_operation)).unwrap(),
+            [vec![32.0; 2]]
+        );
+        drop(active_operation);
+        for _ in 0..100 {
+            if weak.upgrade().is_none() {
+                break;
+            }
+            std::thread::sleep(std::time::Duration::from_millis(1));
+        }
+        assert!(weak.upgrade().is_none(), "active selected view retained its mapping after drop");
     }

