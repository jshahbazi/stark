+    /// Reuse only immutable source ranges already selected by a model whose
+    /// complete bank inventory did not fit. Entries own mapped buffer views;
+    /// activations, router choices and probabilities never enter this cache.
+    #[cfg(feature = "metal")]
+    fn selected_view(
+        &self,
+        file: usize,
+        offset: usize,
+        length: usize,
+    ) -> Result<super::weight_metal::MappedSlice> {
+        let mapping = &self.files[file];
+        let key = StaticViewKey {
+            file,
+            offset,
+            length,
+        };
+        let mut cache = self.selected_views.lock().map_err(|_| Error::Invalid("Metal selected view cache failed"))?;
+        if let Some(view) = cache.entries.get(&key) {
+            super::profile::record("native.metal.expert_cache.hit", 0.0, 0);
+            super::profile::record("native.metal.expert_cache.registered_bytes", 0.0, cache.registered_bytes);
+            return Ok(view.clone());
+        }
+        let registered = mapping.metal_span(offset, length)?.1;
+        super::profile::record("native.metal.expert_cache.miss", 0.0, registered);
+        if registered > cache.limit {
+            drop(cache);
+            return mapping.metal_slice(offset, length);
+        }
+        cache.reserve(registered, "native.metal.expert_cache.eviction");
+        let view = mapping.metal_slice(offset, length)?;
+        cache.registered_bytes += registered;
+        cache.order.push_back(key);
+        cache.entries.insert(key, view.clone());
+        super::profile::record("native.metal.expert_cache.registered_bytes", 0.0, cache.registered_bytes);
+        Ok(view)
     }

