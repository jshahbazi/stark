33 #[stark_test]
34 fn recycled_argument_tables_rebind_buffers_constants_and_optional_inputs() {
35     let context = MetalContext::new().unwrap();
36     let out_of_place =
37         <<Metal as Backend>::Kernels as Kernels>::TensorAddScaleKernel::new(&context, DataType::F32, false).unwrap();
38     let in_place =
39         <<Metal as Backend>::Kernels as Kernels>::TensorAddScaleKernel::new(&context, DataType::F32, true).unwrap();
40     // Retain earlier buffers so stale bindings cannot accidentally refer to a
41     // new allocation at the same address.
42     let mut retained = Vec::new();
43     for iteration in 0..8 {
44         let values = [iteration as f32 + 1.0; 8];
45         let biases = [2.0f32; 8];
46         let mut input = context.create_buffer(32).unwrap();
47         input.copyin(&values);
48         let mut bias = context.create_buffer(32).unwrap();
49         bias.copyin(&biases);
50         let mut output = context.create_buffer(32).unwrap();
51         output.copyin(&values);
52         let scale = iteration as f32 + 0.5;
53         let mut command = context.create_command_buffer(None, None).unwrap();
54         // Vary constant offsets even when the global allocator reuses a page.
55         drop(command.allocate_constant((iteration + 1) * 64).unwrap());
56         if iteration % 2 == 0 {
57             out_of_place.encode(Some(&input), &bias, &mut output, 8, 8, scale, &mut command);
58         } else {
59             in_place.encode(None::<&<Metal as Backend>::GlobalBuffer>, &bias, &mut output, 8, 8, scale, &mut command);
60         }
61         command.end_encoding().submit().wait_until_completed().unwrap();
62         assert_eq!(output.copyout::<f32>(), vec![(values[0] + biases[0]) * scale; 8]);
63         retained.push((input, bias, output));
64     }
65 }
