 9 #[stark_test]
10 fn argument_tables_are_exclusive_until_completion() {
11     let context = MetalContext::new().unwrap();
12     let first = context.create_command_buffer(None, None).unwrap();
13     let first_table = first.argument_table.clone();
14     let second = context.create_command_buffer(None, None).unwrap();
15     let second_table = second.argument_table.clone();
16     assert!(!std::ptr::eq(&*first_table, &*second_table));
17     assert!(context.command_buffer_cache.lock().is_empty());
18 
19     let first_pending = first.end_encoding().submit();
20     let second_pending = second.end_encoding().submit();
21     first_pending.wait_until_completed().unwrap();
22     second_pending.wait_until_completed().unwrap();
23     assert_eq!(context.command_buffer_cache.lock().len(), 2);
24 
25     let recycled = context.create_command_buffer(None, None).unwrap();
26     assert!(
27         std::ptr::eq(&*recycled.argument_table, &*first_table)
28             || std::ptr::eq(&*recycled.argument_table, &*second_table)
29     );
30     recycled.end_encoding().submit().wait_until_completed().unwrap();
31 }
