+#[stark_test]
+#[ignore]
+fn qwen_fused_hc_microbenchmark() {
+    let (streams, dim, latent) = (4usize, 2560usize, 320usize);
+    let format = MatrixFormat::Affine {
+        scale_dtype: 30,
+        bits: 8,
+        group: 64,
+    };
+    let down = affine(latent, streams * dim, format, [7, 1, 3]);
+    let up = affine(streams * dim, latent, format, [7, 1, 3]);
+    let input =
+        DecodeGraph::upload(&(0..streams * dim).map(|i| ((i % 37) as f32 - 18.0) / 31.0).collect::<Vec<_>>()).unwrap();
+    let norm = DecodeGraph::upload(&vec![1.0; dim]).unwrap();
+    for _ in 0..3 {
+        let mut samples = Vec::new();
+        for fused in [false, true] {
+            let mut graph = DecodeGraph::new().unwrap();
+            let mut output = None;
+            for _ in 0..16 {
+                output = Some(if fused {
+                    graph
+                        .qwen_hc_fused(&down, &up, format, None, &input, &norm, streams, latent, 1e-6)
+                        .unwrap()
+                        .unwrap()
+                        .0
+                } else {
+                    reference(&mut graph, &down, &up, format, None, &input, &norm, streams, latent, 1e-6)
+                });
+            }
+            let started = Instant::now();
+            let values = graph.finish(&[output.unwrap()]).unwrap().remove(0);
+            samples.push((started.elapsed().as_secs_f64() / 16.0, values));
+        }
+        assert!(samples[0].1.iter().zip(&samples[1].1).all(|(&a, &b)| a.to_bits() == b.to_bits()));
+        eprintln!("qwen_hc_completion_us vector8={:.3} fused={:.3}", samples[0].0 * 1e6, samples[1].0 * 1e6);
+    }
+}
