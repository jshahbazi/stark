+                MatrixFormat::Affine {
+                    bits: 4 | 8,
+                    ..
+                }
+            )
+        {
+            return Ok(None);
+        }
+        input.validate()?;
+        norm.validate()?;
+        if !input.len.is_multiple_of(streams)
+            || ![input.len, input.len / streams].contains(&norm.len)
+            || !eps.is_finite()
+            || eps <= 0.0
