+        MappedOperation {
+            matrices: vec![up.clone()],
+            inputs: &[],
+            rows: input.len,
+            columns: latent,
+            rows_per_batch: 0,
+            format,
+        }
+        .parameters_for_input(latent)?;
+        if let Some((matrix, kind)) = injection {
+            if !matches!(kind, 0 | 1 | 30) {
+                return Ok(None);
+            }
