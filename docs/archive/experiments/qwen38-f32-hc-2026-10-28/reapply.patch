+
+fn plane(
+    values: impl Iterator<Item = f32>,
+    dtype: u32,
+) -> Vec<u8> {
+    values
+        .flat_map(|value| match dtype {
+            0 => value.to_le_bytes().to_vec(),
+            1 => half::f16::from_f32(value).to_bits().to_le_bytes().to_vec(),
+            30 => half::bf16::from_f32(value).to_bits().to_le_bytes().to_vec(),
+            _ => unreachable!(),
+        })
+        .collect()
+}
+
+fn view(
+    bytes: &[u8],
+    offset: usize,
+) -> MappedSlice {
+    let mut storage = vec![0u8; offset];
+    storage.extend_from_slice(bytes);
+    MappedSlice {
+        buffer: buffer(executor().unwrap(), &storage).unwrap(),
+        offset,
+        length: bytes.len(),
+        registered_length: storage.len(),
+    }
+}
+
+fn affine(
+    rows: usize,
+    columns: usize,
+    format: MatrixFormat,
+    offsets: [usize; 3],
+) -> MappedMatrix {
+    let MatrixFormat::Affine {
+        scale_dtype,
+        bits,
+        group,
+    } = format
+    else {
+        unreachable!()
+    };
+    let scales = (0..rows * columns / group).map(|i| ((i % 5 + 1) as f32) * 0.00390625);
+    let biases = scales.clone().map(|value| -value * ((1usize << bits) - 1) as f32 * 0.5);
+    let codes = (0..rows * columns * bits / 8).map(|i| (i * 13 + 41) as u8).collect::<Vec<_>>();
+    MappedMatrix {
+        codes: view(&codes, offsets[0]),
+        planes: Some((view(&plane(scales, scale_dtype), offsets[1]), view(&plane(biases, scale_dtype), offsets[2]))),
+    }
+}
+
+fn projection(
+    graph: &mut DecodeGraph,
+    matrix: &MappedMatrix,
+    rows: usize,
+    columns: usize,
+    format: MatrixFormat,
+    input: &DeviceVector,
+) -> DeviceVector {
+    graph
+        .mapped(
+            &MappedOperation {
+                matrices: vec![matrix.clone()],
+                inputs: &[],
+                rows,
+                columns,
+                rows_per_batch: 0,
+                format,
+            },
+            input,
+        )
+        .unwrap()
+}
+
+fn reference(
+    graph: &mut DecodeGraph,
+    down: &MappedMatrix,
+    up: &MappedMatrix,
+    format: MatrixFormat,
+    injection: Option<(&MappedMatrix, u32)>,
+    input: &DeviceVector,
+    norm: &DeviceVector,
+    streams: usize,
+    latent: usize,
+    eps: f32,
+) -> DeviceVector {
+    graph.vector8 = true;
+    graph.byte_loads = true;
+    let dim = input.len / streams;
+    let normalized = graph.rms_norm(input, norm, dim, eps).unwrap();
+    let down = projection(graph, down, latent, input.len, format, &normalized);
+    graph.kernel("hybrid_graph_qwen_hc_activate", &[&down], &[latent as u32, streams as u32], latent, 256).unwrap();
+    let up = projection(graph, up, input.len, latent, format, &down);
+    let inject = injection.map_or_else(
+        || DecodeGraph::zeros(1).unwrap(),
+        |(matrix, kind)| projection(graph, matrix, streams, input.len, MatrixFormat::Packed(kind), &normalized),
+    );
+    let output = graph
+        .scratch(
+            dim + if injection.is_some() {
+                streams
+            } else {
+                0
+            },
+        )
+        .unwrap();
+    graph
+        .kernel(
+            "hybrid_graph_qwen_hc_mix",
+            &[&up, &normalized, &inject, &output],
+            &[dim as u32, streams as u32, u32::from(injection.is_some())],
+            dim.max(streams),
+            256,
+        )
+        .unwrap();
+    output
+}
+
+#[stark_test]
+fn qwen_fused_hc_preserves_vector8_hidden_bits_and_bounded_injection_error() {
+    for (streams, dim, latent, bits, group, dtype, inject_kind, offsets) in [
+        (1usize, 32usize, 64usize, 4usize, 32usize, 0u32, 0u32, [0, 0, 0]),
+        (4, 16, 64, 8, 64, 30, 30, [1, 3, 1]),
+        (4, 64, 128, 4, 128, 1, 1, [3, 1, 3]),
+        (1, 256, 128, 8, 128, 1, 0, [1, 1, 1]),
+        (4, 2560, 320, 8, 64, 30, 30, [7, 3, 1]),
+    ] {
+        let format = MatrixFormat::Affine {
+            scale_dtype: dtype,
+            bits,
+            group,
+        };
+        let width = streams * dim;
+        let down = affine(latent, width, format, offsets);
+        let up = affine(width, latent, format, offsets);
+        let inject_values = (0..streams * width).map(|i| ((i * 17 % 71) as f32 - 35.0) / 1024.0);
+        let inject = MappedMatrix {
+            codes: view(&plane(inject_values, inject_kind), 1),
+            planes: None,
+        };
+        for per_stream_norm in [false, true] {
+            let input =
+                DecodeGraph::upload(&(0..width).map(|i| ((i * 13 % 97) as f32 - 48.0) / 83.0).collect::<Vec<_>>())
+                    .unwrap();
+            let norm = DecodeGraph::upload(
+                &(0..if per_stream_norm {
+                    width
+                } else {
+                    dim
+                })
+                    .map(|i| 0.7 + (i % 23) as f32 * 0.013)
+                    .collect::<Vec<_>>(),
+            )
+            .unwrap();
+            for with_inject in [false, true] {
+                let injection = with_inject.then_some((&inject, inject_kind));
+                let mut graph = DecodeGraph::new().unwrap();
+                let expected =
+                    reference(&mut graph, &down, &up, format, injection, &input, &norm, streams, latent, 1e-6);
+                let (hidden, gates) = graph
+                    .qwen_hc_fused(&down, &up, format, injection, &input, &norm, streams, latent, 1e-6)
+                    .unwrap()
+                    .unwrap();
+                let mut outputs = vec![expected, hidden];
+                if with_inject {
+                    outputs.push(gates);
+                }
+                let actual = graph.finish(&outputs).unwrap();
+                assert!(
+                    actual[0][..dim].iter().zip(&actual[1]).all(|(&a, &b)| a.to_bits() == b.to_bits()),
+                    "fused HC changed ordered hidden arithmetic"
+                );
+                if with_inject {
+                    assert!(
+                        actual[0][dim..].iter().zip(&actual[2]).all(|(&a, &b)| (a - b).abs() <= 2e-5),
+                        "fused HC injection exceeds unchanged gate"
+                    );
+                }
+            }
+        }
+    }
+}
+
+#[stark_test]
+fn qwen_fused_hc_up_copies_all_injection_gates_when_dim_is_smaller_than_streams() {
+    let (streams, dim, latent) = (4usize, 1usize, 32usize);
+    let format = MatrixFormat::Affine {
+        scale_dtype: 30,
+        bits: 4,
+        group: 32,
+    };
+    let up = affine(dim * streams, latent, format, [1, 1, 1]);
+    let input = DecodeGraph::upload(&[0.1, -0.2, 0.3, -0.4]).unwrap();
+    let norm = DecodeGraph::upload(&[1.0]).unwrap();
+    let mut values = vec![0.0; latent + 2 * streams];
+    values[latent..latent + streams].fill(1.0);
+    values[latent + streams..].copy_from_slice(&[0.25, 0.5, 0.75, 1.0]);
+    let controls = DecodeGraph::upload(&values).unwrap();
+    let mut graph = DecodeGraph::new().unwrap();
+    let output = graph.qwen_hc_up_mix(&up, format, &input, &norm, &controls, streams, latent, true).unwrap();
+    assert_eq!(&graph.finish(&[output]).unwrap()[0][dim..], &[0.25, 0.5, 0.75, 1.0]);
+}
+
+#[stark_test]
+fn qwen_fused_hc_rejects_nonfinite_values_before_saturating_activations() {
+    let (streams, dim, latent) = (4usize, 32usize, 32usize);
+    let format = MatrixFormat::Affine {
+        scale_dtype: 0,
+        bits: 4,
+        group: 32,
+    };
+    let down = affine(latent, streams * dim, format, [1, 1, 1]);
+    let up = affine(streams * dim, latent, format, [1, 1, 1]);
+    let norm = DecodeGraph::upload(&vec![1.0; dim]).unwrap();
+    for poison_norm in [false, true] {
+        let input = DecodeGraph::zeros(streams * dim).unwrap();
+        let norm = if poison_norm {
+            DecodeGraph::zeros(dim).unwrap()
+        } else {
+            norm.clone()
+        };
+        // Exclusive test storage has no submitted users. Poison one operand
+        // directly so host upload validation does not conceal shader checks.
+        let poisoned = if poison_norm {
+            &norm
+        } else {
+            &input
+        };
+        unsafe { poisoned.buffer.contents().as_ptr().cast::<f32>().write(f32::NAN) };
+        let mut graph = DecodeGraph::new().unwrap();
+        graph.qwen_hc_fused(&down, &up, format, None, &input, &norm, streams, latent, 1e-6).unwrap().unwrap();
+        assert!(graph.finish(&[]).is_err());
+    }
+    let input = DecodeGraph::upload(&vec![0.25; streams * dim]).unwrap();
+    let norm = DecodeGraph::upload(&vec![1.0; dim]).unwrap();
+    let mut controls = vec![0.0; latent + streams];
+    controls[..latent].fill(f32::MAX);
+    controls[latent..].fill(1.0);
+    let overflow_up = MappedMatrix {
+        codes: view(&vec![0xff; streams * dim * latent / 2], 1),
+        planes: Some((
+            view(bytemuck::cast_slice(&vec![0.5f32; streams * dim]), 1),
+            view(bytemuck::cast_slice(&vec![0.0f32; streams * dim]), 1),
+        )),
+    };
+    let mut graph = DecodeGraph::new().unwrap();
+    graph
+        .qwen_hc_up_mix(
+            &overflow_up,
+            format,
+            &input,
+            &norm,
+            &DecodeGraph::upload(&controls).unwrap(),
+            streams,
+            latent,
+            false,
+        )
+        .unwrap();
+    assert!(graph.finish(&[]).is_err(), "sigmoid concealed an overflowed up projection");
+}
