+                matrices: vec![matrix.clone()],
+                inputs: &[],
+                rows: streams,
+                columns: input.len,
+                rows_per_batch: 0,
+                format: MatrixFormat::Packed(kind),
+            }
+            .parameters_for_input(input.len)?;
+        }
+        let controls = self.scratch(
+            latent
+                .checked_add(
+                    streams
+                        * if injection.is_some() {
