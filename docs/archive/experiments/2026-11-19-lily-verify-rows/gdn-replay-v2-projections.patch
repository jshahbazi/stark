+// SPDX-License-Identifier: Apache-2.0
+//! Synthetic component timing of the Q4 row-reuse projections at Lily's GDN
+//! dimensions (36 distinct weight allocations, rows 1 to 4). Timings only.
+use super::*;
+use objc2_metal::MTLComputePipelineState;
+
+fn word(seed: &mut u32) -> u32 {
+    *seed ^= *seed << 13;
+    *seed ^= *seed >> 17;
+    *seed ^= *seed << 5;
+    *seed
+}
+
+fn values(seed: &mut u32, count: usize, scale: f32) -> Vec<f32> {
+    (0..count)
+        .map(|_| (word(seed) % 4097) as f32 * scale / 4096.0 - scale / 2.0)
+        .collect()
+}
+
+fn q4(ctx: &MetalContext, seed: &mut u32, n: usize, k: usize) -> Result<QuantWeights> {
+    let codes: Vec<_> = (0..n * k / 8).map(|_| word(seed)).collect();
+    Ok(QuantWeights {
+        codes: Tensor::from_bytes(ctx, bytemuck::cast_slice(&codes), &[n, k / 8], DType::U32)?,
+        scales: Tensor::from_f32_as_bf16(ctx, &values(seed, n * k / 64, 0.01), &[n, k / 64])?,
+        biases: Tensor::from_f32_as_bf16(ctx, &values(seed, n * k / 64, 0.125), &[n, k / 64])?,
+        group_size: 64,
+        bits: 4,
+    })
+}
+
+fn time<F: Fn(&ComputePass<'_>) -> Result<()>>(ctx: &MetalContext, f: F) -> Result<f64> {
+    let pass = ctx.begin_concurrent()?;
+    f(&pass)?;
+    let done = pass.commit()?.wait_retain()?;
+    let t = done.timing()?;
+    Ok((t.gpu_end_secs - t.gpu_start_secs) * 1e3)
+}
+
+#[test]
+#[ignore = "exclusive physical Apple Silicon GPU slot; synthetic component timing only"]
+fn q4_row_reuse_projection_timing() -> Result<()> {
+    let ctx = MetalContext::new()?;
+    let mut seed = 0x5171_0a2b;
+    let layers = 36;
+    let (k_in, n_in) = (2560, 16480);
+    let (c, v, h) = (10240, 6144, 48);
+    let (k_out, n_out) = (6144, 2560);
+    let gdn_in: Vec<_> =
+        (0..layers).map(|_| q4(&ctx, &mut seed, n_in, k_in)).collect::<Result<_>>()?;
+    let gdn_out: Vec<_> =
+        (0..layers).map(|_| q4(&ctx, &mut seed, n_out, k_out)).collect::<Result<_>>()?;
+    let conv_w = Tensor::from_f32_as_bf16(&ctx, &values(&mut seed, 4 * c, 1.0), &[4, c])?;
+    let windows: Vec<_> = (0..2)
+        .map(|_| Tensor::from_f32_as_bf16(&ctx, &values(&mut seed, 3 * c, 1.0), &[c, 3]))
+        .collect::<Result<_>>()?;
+    for name in [
+        "stark_q4_gdn_conv_rows_m1",
+        "stark_q4_gdn_conv_rows_m2",
+        "stark_q4_gdn_conv_rows_m3",
+        "stark_q4_gdn_conv_rows_m4",
+    ] {
+        let p = ctx.pipeline(name, GDN_ROWS_SOURCE, MslVersion::V3_1)?;
+        eprintln!(
+            "pipeline {name}: max_threads={} exec_width={}",
+            p.pipeline.maxTotalThreadsPerThreadgroup(),
+            p.thread_execution_width()
+        );
+    }
+    for name in [
+        "stark_decode_rows_q4_bf16_2row",
+        "stark_projection_reuse_q4_bf16_m2",
+        "stark_projection_reuse_q4_bf16_m3",
+        "stark_projection_reuse_q4_bf16_m4",
+    ] {
+        let p = ctx.pipeline(name, DECODE_ROWS_SOURCE, MslVersion::V3_1)?;
+        eprintln!(
+            "pipeline {name}: max_threads={} exec_width={}",
+            p.pipeline.maxTotalThreadsPerThreadgroup(),
+            p.thread_execution_width()
+        );
+    }
+    for m in 1..=4 {
+        let x_in = Tensor::from_f32_as_bf16(&ctx, &values(&mut seed, m * k_in, 4.0), &[m, k_in])?;
+        let x_out =
+            Tensor::from_f32_as_bf16(&ctx, &values(&mut seed, m * k_out, 4.0), &[m, k_out])?;
+        let bf = DType::BF16;
+        let qkv = Tensor::zeros(&ctx, &[m, c], bf)?;
+        let z = Tensor::zeros(&ctx, &[m, v], bf)?;
+        let a = Tensor::zeros(&ctx, &[m, h], bf)?;
+        let b = Tensor::zeros(&ctx, &[m, h], bf)?;
+        let conv = Tensor::zeros(&ctx, &[m, c], bf)?;
+        let capture = Tensor::zeros(&ctx, &[m, c], bf)?;
+        let y = Tensor::zeros(&ctx, &[m, n_out], bf)?;
+        let run_in = |pass: &ComputePass<'_>| -> Result<()> {
+            for w in &gdn_in {
+                gemv_q4_gdn_conv_rows_exact(
+                    &ctx, pass, w, &x_in, &qkv, &z, &a, &b, &windows[0], &windows[1],
+                    &conv_w, &conv, Some(&capture),
+                )?;
+                pass.level_barrier(&[&qkv, &z, &a, &b, &conv, &capture, &windows[1]])?;
+            }
+            Ok(())
+        };
+        let run_out = |pass: &ComputePass<'_>| -> Result<()> {
+            for w in &gdn_out {
+                gemv_quant_rows_decode_exact(&ctx, pass, w, &x_out, &y)?;
+                pass.level_barrier(&[&y])?;
+            }
+            Ok(())
+        };
+        let f32t = DType::F32;
+        let (xf_in, xs_in) =
+            (Tensor::zeros(&ctx, &[m, k_in], f32t)?, Tensor::zeros(&ctx, &[m, k_in / 8], f32t)?);
+        let (xf_out, xs_out) = (
+            Tensor::zeros(&ctx, &[m, k_out], f32t)?,
+            Tensor::zeros(&ctx, &[m, k_out / 8], f32t)?,
+        );
+        let stage_in = Q4RowStage { xf: &xf_in, xs: &xs_in };
+        let stage_out = Q4RowStage { xf: &xf_out, xs: &xs_out };
+        let run_in_staged = |pass: &ComputePass<'_>| -> Result<()> {
+            for w in &gdn_in {
+                stage_q4_rows(&ctx, pass, &x_in, &stage_in)?;
+                pass.level_barrier(&[&xf_in, &xs_in])?;
+                gemv_q4_gdn_conv_rows_staged(
+                    &ctx, pass, w, &x_in, &stage_in, &qkv, &z, &a, &b, &windows[0],
+                    &windows[1], &conv_w, &conv, Some(&capture),
+                )?;
+                pass.level_barrier(&[&qkv, &z, &a, &b, &conv, &capture, &windows[1]])?;
+            }
+            Ok(())
+        };
+        let run_out_staged = |pass: &ComputePass<'_>| -> Result<()> {
+            for w in &gdn_out {
+                stage_q4_rows(&ctx, pass, &x_out, &stage_out)?;
+                pass.level_barrier(&[&xf_out, &xs_out])?;
+                gemv_q4_rows_reuse_staged(&ctx, pass, w, &x_out, &stage_out, &y)?;
+                pass.level_barrier(&[&y])?;
+            }
+            Ok(())
+        };
+        let run_in_parked = |pass: &ComputePass<'_>| -> Result<()> {
+            set_rows_variant(RowsVariant::Parked);
+            let result = run_in(pass);
+            set_rows_variant(RowsVariant::Original);
+            result
+        };
+        let run_in_sums = |pass: &ComputePass<'_>| -> Result<()> {
+            set_rows_variant(RowsVariant::ParkedSums);
+            let result = run_in(pass);
+            set_rows_variant(RowsVariant::Original);
+            result
+        };
+        let staged = m > 1;
+        let start = std::time::Instant::now();
+        while start.elapsed() < std::time::Duration::from_millis(1500) {
+            time(&ctx, run_in)?;
+            time(&ctx, run_out)?;
+            if staged {
+                time(&ctx, run_in_staged)?;
+                time(&ctx, run_out_staged)?;
+                time(&ctx, run_in_parked)?;
+                time(&ctx, run_in_sums)?;
+            }
+        }
+        let mut samples = [Vec::new(), Vec::new(), Vec::new(), Vec::new(), Vec::new(), Vec::new()];
+        for _ in 0..15 {
+            samples[0].push(time(&ctx, run_in)?);
+            samples[1].push(time(&ctx, run_out)?);
+            if staged {
+                samples[2].push(time(&ctx, run_in_staged)?);
+                samples[3].push(time(&ctx, run_out_staged)?);
+                samples[4].push(time(&ctx, run_in_parked)?);
+                samples[5].push(time(&ctx, run_in_sums)?);
+            }
+        }
+        for (name, s) in ["gdn_in_proj_conv", "gdn_out_proj", "staged_in_proj_conv", "staged_out_proj", "parked_in_proj_conv", "parked_sums_in_proj_conv"]
+            .iter()
+            .zip(samples.iter_mut())
+            .filter(|(_, s)| !s.is_empty())
+        {
+            s.sort_by(f64::total_cmp);
+            eprintln!(
+                "q4 rows timing: m={m} stage={name} layers={layers} median_ms={:.3} min_ms={:.3}",
+                s[7], s[0]
+            );
+        }
+    }
+    Ok(())
+}
+
+/// Input styles: 0 ordinary, 1 subnormal-heavy, 2 cancellation (large equal
+/// magnitudes of alternating sign), 3 signed zeros and extremes.
+fn styled(seed: &mut u32, count: usize, style: u32) -> Vec<f32> {
+    let mut x = values(seed, count, 4.0);
+    for (i, v) in x.iter_mut().enumerate() {
+        match style {
+            1 if i % 4 != 0 => {
+                *v = f32::from_bits(word(seed) % 0x0080_0000)
+                    * if i % 2 == 0 { 1.0 } else { -1.0 }
+            }
+            2 => *v = if i % 2 == 0 { 96.0 } else { -96.0 } + (word(seed) % 4) as f32 * 0.25,
+            3 => *v = [0.0, -0.0, 3.0e38, -3.0e38, 1.0e-38, -1.0e-38][i % 6],
+            _ => {}
+        }
+    }
+    x
+}
+
+/// Guarded BF16 rows at an odd offset inside a canary-filled allocation.
+fn offset_rows(ctx: &MetalContext, data: &[f32], shape: &[usize]) -> Result<(Tensor, Tensor)> {
+    let storage = Tensor::zeros(ctx, &[data.len() + 8], DType::BF16)?;
+    storage.write_bytes(&vec![0xa5; storage.byte_len()])?;
+    let view = storage.view(4, shape)?;
+    let bf: Vec<_> = data.iter().copied().map(half::bf16::from_f32).collect();
+    view.write_bytes(bytemuck::cast_slice(&bf))?;
+    Ok((storage, view))
+}
+
+/// The staged shared-weight Q4 rows against the ordinary one-row decode
+/// projection (output projection) and against the byte-tested unstaged fused
+/// GDN rows kernel (input projection and convolution): three draws, four
+/// input styles, rows 2 to 4, offset views, Lily and small geometries.
+#[test]
+#[ignore = "requires a physical Apple Silicon Metal device"]
+fn staged_q4_rows_match_ordinary_decode_bytes() -> Result<()> {
+    let ctx = MetalContext::new()?;
+    let mut compared = 0usize;
+    let mut cases = 0usize;
+    for draw in 0..6u32 {
+        let mut seed = 0x51a6_e5d1 ^ draw.wrapping_mul(0x9e37_79b9);
+        for (n, k) in [(2560, 6144), (64, 256)] {
+            let w = q4(&ctx, &mut seed, n, k)?;
+            for m in 2..=4 {
+                for style in 0..4 {
+                    let (_xs_store, x) = offset_rows(&ctx, &styled(&mut seed, m * k, style), &[m, k])?;
+                    let reference = Tensor::zeros(&ctx, &[m, n], DType::BF16)?;
+                    let candidate = Tensor::zeros(&ctx, &[m, n], DType::BF16)?;
+                    let xf = Tensor::zeros(&ctx, &[m, k], DType::F32)?;
+                    let xsum = Tensor::zeros(&ctx, &[m, k / 8], DType::F32)?;
+                    let stage = Q4RowStage { xf: &xf, xs: &xsum };
+                    let pass = ctx.begin_concurrent()?;
+                    for row in 0..m {
+                        gemv_quant_rows_decode_exact(
+                            &ctx,
+                            &pass,
+                            &w,
+                            &x.view(row * k, &[1, k])?,
+                            &reference.view(row * n, &[1, n])?,
+                        )?;
+                    }
+                    stage_q4_rows(&ctx, &pass, &x, &stage)?;
+                    pass.level_barrier(&[&xf, &xsum])?;
+                    gemv_q4_rows_reuse_staged(&ctx, &pass, &w, &x, &stage, &candidate)?;
+                    pass.commit()?.wait()?;
+                    ensure!(
+                        reference.raw_bytes() == candidate.raw_bytes(),
+                        "staged reuse mismatch draw={draw} n={n} m={m} style={style}"
+                    );
+                    compared += reference.byte_len();
+                    cases += 1;
+                }
+            }
+        }
+        for (k, c, v, h) in [(2560, 10240, 6144, 48), (128, 192, 64, 2)] {
+            let n = c + v + 2 * h;
+            let w = q4(&ctx, &mut seed, n, k)?;
+            let conv_w = Tensor::from_f32_as_bf16(&ctx, &values(&mut seed, 4 * c, 1.0), &[4, c])?;
+            let window = Tensor::from_f32_as_bf16(&ctx, &values(&mut seed, 3 * c, 2.0), &[c, 3])?;
+            for m in 2..=4 {
+                for style in 0..4 {
+                    let (_xs_store, x) = offset_rows(&ctx, &styled(&mut seed, m * k, style), &[m, k])?;
+                    let bf = DType::BF16;
+                    let outs = |ctx: &MetalContext| -> Result<Vec<Tensor>> {
+                        [[m, c], [m, v], [m, h], [m, h], [c, 3], [m, c], [m, c]]
+                            .iter()
+                            .map(|s| Tensor::zeros(ctx, s, bf))
+                            .collect()
+                    };
+                    let (r, s) = (outs(&ctx)?, outs(&ctx)?);
+                    let xf = Tensor::zeros(&ctx, &[m, k], DType::F32)?;
+                    let xsum = Tensor::zeros(&ctx, &[m, k / 8], DType::F32)?;
+                    let stage = Q4RowStage { xf: &xf, xs: &xsum };
+                    let pass = ctx.begin_concurrent()?;
+                    set_rows_variant(RowsVariant::Original);
+                    gemv_q4_gdn_conv_rows_exact(
+                        &ctx, &pass, &w, &x, &r[0], &r[1], &r[2], &r[3], &window, &r[4],
+                        &conv_w, &r[5], Some(&r[6]),
+                    )?;
+                    stage_q4_rows(&ctx, &pass, &x, &stage)?;
+                    pass.level_barrier(&[&xf, &xsum])?;
+                    gemv_q4_gdn_conv_rows_staged(
+                        &ctx, &pass, &w, &x, &stage, &s[0], &s[1], &s[2], &s[3], &window,
+                        &s[4], &conv_w, &s[5], Some(&s[6]),
+                    )?;
+                    let mut variants = Vec::new();
+                    for variant in [RowsVariant::Parked, RowsVariant::ParkedSums] {
+                        let p = outs(&ctx)?;
+                        set_rows_variant(variant);
+                        let parked = gemv_q4_gdn_conv_rows_exact(
+                            &ctx, &pass, &w, &x, &p[0], &p[1], &p[2], &p[3], &window,
+                            &p[4], &conv_w, &p[5], Some(&p[6]),
+                        );
+                        set_rows_variant(RowsVariant::Original);
+                        parked?;
+                        variants.push(p);
+                    }
+                    pass.commit()?.wait()?;
+                    for (field, (a, b)) in r.iter().cycle().zip(variants.iter().flatten()).enumerate() {
+                        ensure!(
+                            a.raw_bytes() == b.raw_bytes(),
+                            "parked GDN rows mismatch field={field} draw={draw} c={c} m={m} style={style}"
+                        );
+                        compared += a.byte_len();
+                    }
+                    for (field, (a, b)) in r.iter().zip(&s).enumerate() {
+                        ensure!(
+                            a.raw_bytes() == b.raw_bytes(),
+                            "staged GDN rows mismatch field={field} draw={draw} c={c} m={m} style={style}"
+                        );
+                        compared += a.byte_len();
+                    }
+                    cases += 1;
+                }
+            }
+        }
+    }
+    eprintln!("staged Q4 rows exact: cases={cases} compared_bytes={compared}");
+    Ok(())
+}
