+        }
+    }
+    for (uint off = LANES / 2; off > 0; off >>= 1) {
+        _Pragma("clang loop unroll(full)")
+        for (uint m = 0; m < M; ++m) {
+            sums[m] += simd_shuffle_down(sums[m], off);
+        }
+    }
+}
+
+// Stark: threadgroup-parked inputs for the shared-weight Q4 rows. Eight
+// simdgroups (sixteen output channels) share one copy of the M input rows in
+// threadgroup memory instead of each pair of channels reading them through
+// the device cache. Each channel keeps stark_gemv_q4_packed_rows_sum's lanes,
+// block order, dot_word_q4 expression and reduction.
+#define STARK_Q4_TG_ROWS_ELEMS 10240
+
+static inline float stark_dot_word_q4_tg(uint word, float s, float b,
+                                         threadgroup const bfloat4* xv, uint w) {
+    float4 xlo = float4(xv[2 * w]);
+    float4 xhi = float4(xv[2 * w + 1]);
+    float4 qlo = float4(float((word >> 0) & 0xF), float((word >> 4) & 0xF),
+                        float((word >> 8) & 0xF), float((word >> 12) & 0xF));
+    float4 qhi = float4(float((word >> 16) & 0xF), float((word >> 20) & 0xF),
+                        float((word >> 24) & 0xF), float((word >> 28) & 0xF));
+    float qx = dot(qlo, xlo) + dot(qhi, xhi);
+    float xs = dot(xlo, float4(1.0f)) + dot(xhi, float4(1.0f));
+    return s * qx + b * xs;
+}
+
+template <uint M>
+static inline void stark_gemv_q4_packed_rows_sum_tg(
+    device const uint* codes, device const bfloat* scales,
+    device const bfloat* biases, threadgroup const bfloat* input,
+    uint channel, uint sublane, uint K, uint GS,
+    thread float (&sums)[M]) {
+    constexpr uint LANES = 16;
+    const uint words = K / 8;
+    const uint blocks = words / 4;
+    const uint bpg = GS / 32;
+    const uint groups = K / GS;
+    device const uint4* wrow =
+        (device const uint4*)(codes + (ulong)channel * words);
+    _Pragma("clang loop unroll(full)")
+    for (uint m = 0; m < M; ++m) {
+        sums[m] = 0.0f;
+    }
+    for (uint i = sublane; i < blocks; i += LANES) {
+        const uint g = i / bpg;
+        const float s = float(scales[channel * groups + g]);
+        const float b = float(biases[channel * groups + g]);
+        const uint4 w4 = wrow[i];
+        _Pragma("clang loop unroll(full)")
+        for (uint m = 0; m < M; ++m) {
+            threadgroup const bfloat4* xv =
+                (threadgroup const bfloat4*)(input + m * K);
+            sums[m] += stark_dot_word_q4_tg(w4.x, s, b, xv, 4 * i)
+                + stark_dot_word_q4_tg(w4.y, s, b, xv, 4 * i + 1)
+                + stark_dot_word_q4_tg(w4.z, s, b, xv, 4 * i + 2)
+                + stark_dot_word_q4_tg(w4.w, s, b, xv, 4 * i + 3);
+        }
+    }
+    for (uint off = LANES / 2; off > 0; off >>= 1) {
+        _Pragma("clang loop unroll(full)")
+        for (uint m = 0; m < M; ++m) {
+            sums[m] += simd_shuffle_down(sums[m], off);
+        }
+    }
+}
+
+// Copies M rows of K BF16 inputs into threadgroup memory (all threads).
+static inline void stark_q4_tg_park(device const bfloat* input,
+                                    threadgroup bfloat* parked, uint count,
+                                    uint tid, uint threads) {
+    device const bfloat4* src = (device const bfloat4*)input;
+    threadgroup bfloat4* dst = (threadgroup bfloat4*)parked;
+    for (uint i = tid; i < count / 4; i += threads) {
+        dst[i] = src[i];
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+}
+
+// Stark: threadgroup-parked inputs plus each word's parked input sum (the
+// weight-independent `xs` term of dot_word_q4, computed once per threadgroup
+// with dot_word_q4's own expression instead of once per output channel).
+static inline float stark_dot_word_q4_tgx(uint word, float s, float b,
+                                          threadgroup const bfloat4* xv,
+                                          float xs, uint w) {
+    float4 xlo = float4(xv[2 * w]);
+    float4 xhi = float4(xv[2 * w + 1]);
+    float4 qlo = float4(float((word >> 0) & 0xF), float((word >> 4) & 0xF),
+                        float((word >> 8) & 0xF), float((word >> 12) & 0xF));
+    float4 qhi = float4(float((word >> 16) & 0xF), float((word >> 20) & 0xF),
+                        float((word >> 24) & 0xF), float((word >> 28) & 0xF));
+    float qx = dot(qlo, xlo) + dot(qhi, xhi);
+    return s * qx + b * xs;
+}
+
+template <uint M>
+static inline void stark_gemv_q4_packed_rows_sum_tgx(
+    device const uint* codes, device const bfloat* scales,
+    device const bfloat* biases, threadgroup const bfloat* input,
+    threadgroup const float* xsum, uint channel, uint sublane, uint K, uint GS,
+    thread float (&sums)[M]) {
+    constexpr uint LANES = 16;
+    const uint words = K / 8;
+    const uint blocks = words / 4;
+    const uint bpg = GS / 32;
+    const uint groups = K / GS;
+    device const uint4* wrow =
+        (device const uint4*)(codes + (ulong)channel * words);
+    _Pragma("clang loop unroll(full)")
+    for (uint m = 0; m < M; ++m) {
+        sums[m] = 0.0f;
+    }
+    for (uint i = sublane; i < blocks; i += LANES) {
+        const uint g = i / bpg;
+        const float s = float(scales[channel * groups + g]);
+        const float b = float(biases[channel * groups + g]);
+        const uint4 w4 = wrow[i];
+        _Pragma("clang loop unroll(full)")
+        for (uint m = 0; m < M; ++m) {
+            threadgroup const bfloat4* xv =
+                (threadgroup const bfloat4*)(input + m * K);
+            const float4 x4 = ((threadgroup const float4*)(xsum + m * words))[i];
+            sums[m] += stark_dot_word_q4_tgx(w4.x, s, b, xv, x4.x, 4 * i)
+                + stark_dot_word_q4_tgx(w4.y, s, b, xv, x4.y, 4 * i + 1)
+                + stark_dot_word_q4_tgx(w4.z, s, b, xv, x4.z, 4 * i + 2)
+                + stark_dot_word_q4_tgx(w4.w, s, b, xv, x4.w, 4 * i + 3);
+        }
+    }
+    for (uint off = LANES / 2; off > 0; off >>= 1) {
+        _Pragma("clang loop unroll(full)")
+        for (uint m = 0; m < M; ++m) {
+            sums[m] += simd_shuffle_down(sums[m], off);
+        }
+    }
+}
+
+// Parks M rows of K BF16 inputs and their per-word sums (all threads).
+static inline void stark_q4_tgx_park(device const bfloat* input,
+                                     threadgroup bfloat* parked,
+                                     threadgroup float* xsum, uint count,
+                                     uint tid, uint threads) {
+    device const bfloat4* src = (device const bfloat4*)input;
+    threadgroup bfloat4* dst = (threadgroup bfloat4*)parked;
+    for (uint i = tid; i < count / 8; i += threads) {
+        const bfloat4 lo = src[2 * i];
+        const bfloat4 hi = src[2 * i + 1];
+        dst[2 * i] = lo;
+        dst[2 * i + 1] = hi;
+        const float4 xlo = float4(lo);
+        const float4 xhi = float4(hi);
+        xsum[i] = dot(xlo, float4(1.0f)) + dot(xhi, float4(1.0f));
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+}
