+// Stark: staged row inputs for the shared-weight Q4 rows. The input terms of
+// dot_word_q4 that do not depend on the weight (each word's eight BF16
+// inputs widened to F32, and their sum `xs`) are computed once per row and
+// word by stark_q4_rows_stage instead of once per output channel. The
+// per-channel term `s * qx + b * xs` keeps dot_word_q4's expression and the
+// lane and reduction order of stark_gemv_q4_packed_rows_sum.
+kernel void stark_q4_rows_stage(device const bfloat* input [[buffer(0)]],
+                                device float* xf [[buffer(1)]],
+                                device float* xs [[buffer(2)]],
+                                constant uint& K [[buffer(3)]],
+                                uint2 at [[thread_position_in_grid]]) {
+    const uint words = K / 8;
+    const uint w = at.x;
+    const uint m = at.y;
+    if (w >= words) {
+        return;
+    }
+    device const bfloat4* xv = (device const bfloat4*)(input + (ulong)m * K);
+    float4 xlo = float4(xv[2 * w]);
+    float4 xhi = float4(xv[2 * w + 1]);
+    device float4* out = (device float4*)(xf + (ulong)m * K);
+    out[2 * w] = xlo;
+    out[2 * w + 1] = xhi;
+    xs[(ulong)m * words + w] = dot(xlo, float4(1.0f)) + dot(xhi, float4(1.0f));
+}
+
+static inline float stark_dot_word_q4_staged(uint word, float s, float b,
+                                             device const float4* xf,
+                                             float xs, uint w) {
+    float4 xlo = xf[2 * w];
+    float4 xhi = xf[2 * w + 1];
+    float4 qlo = float4(float((word >> 0) & 0xF), float((word >> 4) & 0xF),
+                        float((word >> 8) & 0xF), float((word >> 12) & 0xF));
+    float4 qhi = float4(float((word >> 16) & 0xF), float((word >> 20) & 0xF),
+                        float((word >> 24) & 0xF), float((word >> 28) & 0xF));
+    float qx = dot(qlo, xlo) + dot(qhi, xhi);
+    return s * qx + b * xs;
+}
+
+template <uint M>
+static inline void stark_gemv_q4_packed_rows_sum_staged(
+    device const uint* codes, device const bfloat* scales,
+    device const bfloat* biases, device const float* xf,
+    device const float* xsum, uint channel, uint sublane, uint K, uint GS,
+    thread float (&sums)[M]) {
+    constexpr uint LANES = 16;
+    const uint words = K / 8;
+    const uint blocks = words / 4;
+    const uint bpg = GS / 32;
+    const uint groups = K / GS;
+    device const uint4* wrow =
+        (device const uint4*)(codes + (ulong)channel * words);
+    _Pragma("clang loop unroll(full)")
