+                                &pass,
+                                &down_w,
+                                h,
+                                args.0,
+                                args.1,
+                                args.2,
+                                args.3,
+                                args.4,
+                                args.5,
+                                top_k,
+                                moe::HcInjection {
+                                    hyper: &ref_hyper.view(r * g * h, &[g * h])?,
+                                    logits: &inj.view(r * g, &[g])?,
+                                    groups: g,
+                                },
+                            )?;
+                        }
+                    }
+                    moe::moe_down_combine_shared_rows(
+                        &ctx,
+                        &pass,
+                        &down_w,
+                        h,
+                        &ea,
+                        &ids,
+                        &scores,
+                        &shared,
+                        &gate,
+                        &cand_out,
+                        top_k,
+                        (g > 0).then_some(moe::HcInjection {
+                            hyper: &cand_hyper,
+                            logits: &inj,
+                            groups: g,
+                        }),
+                    )?;
+                    pass.commit()?.wait()?;
+                    ensure!(
+                        ref_out.raw_bytes() == cand_out.raw_bytes(),
+                        "shared down/combine differs: draw {draw} rows {m} pattern {pattern} groups {g}"
+                    );
+                    ensure!(
+                        ref_hyper.raw_bytes() == cand_hyper.raw_bytes(),
+                        "shared HC write differs: draw {draw} rows {m} pattern {pattern} groups {g}"
+                    );
+                    let bytes = out_storage.raw_bytes();
+                    ensure!(
