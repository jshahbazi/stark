+                    );
+                    compared += ref_out.byte_len() + ref_hyper.byte_len();
+                    cases += 1;
+                }
+            }
+        }
+    }
+    eprintln!(
+        "{}",
+        serde_json::json!({"scope":"expert_shared_rows_byte_control","attempt":"20261119-LILYROWS-03","draws":4,"down_cases":cases,"compared_bytes":compared,"unequal_bytes":0})
+    );
+    Ok(())
+}
