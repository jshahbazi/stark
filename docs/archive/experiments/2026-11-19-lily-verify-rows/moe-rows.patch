index 00000000..dc93b6e1
--- /dev/null
+++ b/vendor/lily-core/src/moe_row_overlap.rs
@@ -0,0 +1,213 @@
+// Stark: private diagnostic for attempt 20261119-LILYROWS-03.
+//! Cross-row routed-expert overlap counter for exact verify passes.
+//!
+//! Off unless `STARK_LILY_MOE_ROW_OVERLAP_OUTPUT` names a file. When on, each
+//! exact verify layer copies its `[m, top_k]` routed expert ids into a
+//! process-local buffer. When the next verify pass (or the next prefill)
+//! starts encoding, the previous pass has completed and its ids are reduced
+//! on the host to aggregate counts; the ids themselves are never written or
+//! logged. One JSON line of counts per segment (a segment ends at the next
+//! large prefill, i.e. the next request) is appended to the file. No token
+//! ids, router scores or probabilities are recorded.
+
+use std::collections::BTreeMap;
+use std::fs::OpenOptions;
+use std::io::Write;
+use std::path::PathBuf;
+use std::sync::{Mutex, OnceLock};
+
+use anyhow::{Result, ensure};
+
+use crate::kernels::u32_bytes;
+use crate::metal::{ComputePass, Grid, MetalContext, MslVersion};
+use crate::tensor::{DType, Tensor};
+
+const SOURCE: &str = r#"
+#include <metal_stdlib>
+using namespace metal;
+kernel void stark_moe_row_overlap_copy(
+    device const uint* src [[buffer(0)]],
+    device uint* dst [[buffer(1)]],
+    constant uint& n [[buffer(2)]],
+    uint i [[thread_position_in_grid]]) {
+    if (i < n) { dst[i] = src[i]; }
+}
+"#;
+
+const MAX_LAYERS: usize = 128;
+const MAX_ROWS: usize = 4;
+const MAX_TOP_K: usize = 32;
+
+fn output() -> Option<&'static PathBuf> {
+    static PATH: OnceLock<Option<PathBuf>> = OnceLock::new();
+    PATH.get_or_init(|| {
+        std::env::var_os("STARK_LILY_MOE_ROW_OVERLAP_OUTPUT")
+            .filter(|v| !v.is_empty())
+            .map(PathBuf::from)
+    })
+    .as_ref()
+}
+
+#[derive(Default, Clone, Copy)]
+struct Totals {
+    verify_passes: u64,
+    layer_passes: u64,
+    selections: u64,
+    duplicate_selections: u64,
+    distinct_experts: u64,
+    /// Experts row `r` selects that no earlier row of the pass selected.
+    new_by_row: [u64; MAX_ROWS],
+}
+
+struct Pending {
+    ids: Tensor,
+    rows: usize,
+    top_k: usize,
+    layers: usize,
+}
+
+struct State {
+    pending: Option<Pending>,
+    totals: BTreeMap<usize, Totals>,
+    segment: u64,
+}
+
+// The buffer is only read on the host after the GPU work that wrote it has
+// completed; the mutex serializes host access.
+unsafe impl Send for State {}
+
+fn state() -> &'static Mutex<State> {
+    static STATE: OnceLock<Mutex<State>> = OnceLock::new();
+    STATE.get_or_init(|| {
+        Mutex::new(State { pending: None, totals: BTreeMap::new(), segment: 0 })
+    })
+}
+
+fn reduce(state: &mut State) -> Result<()> {
+    let Some(p) = state.pending.as_mut() else { return Ok(()) };
+    if p.layers == 0 {
+        return Ok(());
+    }
+    let ids = p.ids.to_u32()?;
+    let (m, k) = (p.rows, p.top_k);
+    let t = state.totals.entry(m).or_default();
+    t.verify_passes += 1;
+    for layer in 0..p.layers {
+        let base = layer * MAX_ROWS * MAX_TOP_K;
+        let row = |r: usize| &ids[base + r * k..base + (r + 1) * k];
+        t.layer_passes += 1;
+        let mut seen: Vec<u32> = Vec::with_capacity(m * k);
+        for r in 0..m {
+            for &e in row(r) {
+                t.selections += 1;
+                if (0..m).any(|o| o != r && row(o).contains(&e)) {
+                    t.duplicate_selections += 1;
+                }
+                if !seen.contains(&e) {
+                    seen.push(e);
+                    t.new_by_row[r] += 1;
+                }
+            }
+        }
+        t.distinct_experts += seen.len() as u64;
+    }
+    p.layers = 0;
+    Ok(())
+}
+
+fn write_segment(state: &mut State) -> Result<()> {
+    let Some(path) = output() else { return Ok(()) };
+    if state.totals.is_empty() {
+        return Ok(());
+    }
+    let mut by_rows = serde_json::Map::new();
+    for (m, t) in &state.totals {
+        by_rows.insert(
+            m.to_string(),
+            serde_json::json!({
+                "verify_passes": t.verify_passes,
+                "layer_passes": t.layer_passes,
+                "selections": t.selections,
+                "duplicate_selections": t.duplicate_selections,
+                "distinct_experts": t.distinct_experts,
+                "new_by_row": &t.new_by_row[..*m],
+            }),
+        );
+    }
+    let line = serde_json::json!({
+        "diagnostic": "moe_row_overlap",
+        "attempt": "20261119-LILYROWS-03",
+        "segment": state.segment,
+        "by_rows": by_rows,
+    });
+    let mut file = OpenOptions::new().create(true).append(true).open(path)?;
+    writeln!(file, "{line}")?;
+    state.segment += 1;
+    state.totals.clear();
+    Ok(())
+}
+
+/// Records this exact verify layer's routed ids. `indices` is `[m, top_k]`
+/// and must already be complete in pass order (the caller places this after
+/// the MoE block's barriers). A no-op unless the diagnostic is enabled.
+pub(crate) fn capture(
+    ctx: &MetalContext,
+    pass: &ComputePass<'_>,
+    layer_index: usize,
+    indices: &Tensor,
+) -> Result<()> {
+    if output().is_none() {
+        return Ok(());
+    }
+    ensure!(indices.dtype() == DType::U32 && indices.shape().len() == 2, "overlap ids");
+    let (m, k) = (indices.shape()[0], indices.shape()[1]);
+    ensure!(
+        (1..=MAX_ROWS).contains(&m) && k <= MAX_TOP_K && layer_index < MAX_LAYERS,
+        "overlap geometry"
+    );
+    let mut st =
+        state().lock().map_err(|_| anyhow::anyhow!("overlap state poisoned"))?;
+    if layer_index == 0 {
+        // The previous verify pass completed before this one is encoded.
+        reduce(&mut st)?;
+    }
+    if st.pending.is_none() {
+        st.pending = Some(Pending {
+            ids: Tensor::zeros(ctx, &[MAX_LAYERS * MAX_ROWS * MAX_TOP_K], DType::U32)?,
+            rows: m,
+            top_k: k,
+            layers: 0,
+        });
+    }
+    let p = st.pending.as_mut().expect("pending allocated");
+    if layer_index == 0 {
+        p.rows = m;
+        p.top_k = k;
+        p.layers = 0;
+    }
+    ensure!(p.rows == m && p.top_k == k, "overlap rows changed within a pass");
+    let dst = p.ids.view(layer_index * MAX_ROWS * MAX_TOP_K, &[m * k])?;
+    let n = m * k;
+    let pipeline =
+        ctx.pipeline("stark_moe_row_overlap_copy", SOURCE, MslVersion::V3_1)?;
+    pass.dispatch_at(
+        &pipeline,
+        &[indices.binding(), dst.binding()],
+        &[&u32_bytes(n)],
+        Grid::Threads { grid: (n, 1, 1), threadgroup: (n.min(256), 1, 1) },
+    )?;
+    p.layers = p.layers.max(layer_index + 1);
+    Ok(())
+}
+
+/// Ends a segment at the start of a large prefill: reduces the last verify
+/// pass (complete by then) and appends one aggregate line.
+pub(crate) fn end_segment() -> Result<()> {
+    if output().is_none() {
+        return Ok(());
+    }
+    let mut st =
+        state().lock().map_err(|_| anyhow::anyhow!("overlap state poisoned"))?;
+    reduce(&mut st)?;
+    write_segment(&mut st)
+}
