+/// Attempt 20261119-LILYROWS-03: does the current per-row routed-expert
+/// verifier already get cross-row sharing from the cache? Times the ordinary
+/// row kernels over 48 distinct synthetic layers (far larger than any cache)
+/// with routes whose rows pick all-distinct, partly shared or identical
+/// experts. Zero-filled weights: only the traffic and dispatch shape matter.
+#[test]
+#[ignore = "physical Apple Silicon; component timings only"]
+fn moe_rows_expert_overlap_timing() -> Result<()> {
+    let ctx = MetalContext::new()?;
+    let (h, inter, top_k, layers, e) = (2560, 640, 10, 48, 40);
+    let zero_q4 = |n: usize, k: usize| -> Result<QuantWeights> {
+        Ok(QuantWeights {
+            codes: Tensor::zeros(&ctx, &[n, k / 8], DType::U32)?,
+            scales: Tensor::zeros(&ctx, &[n, k / 64], DType::BF16)?,
+            biases: Tensor::zeros(&ctx, &[n, k / 64], DType::BF16)?,
+            bits: 4,
+            group_size: 64,
+        })
+    };
+    let banks: Vec<_> = (0..layers)
+        .map(|_| {
+            Ok((zero_q4(e * inter, h)?, zero_q4(e * inter, h)?, zero_q4(e * h, inter)?))
+        })
+        .collect::<Result<_>>()?;
+    let pattern = |name: &str, m: usize| -> Vec<u32> {
+        (0..m * top_k)
+            .map(|i| {
+                let (r, s) = (i / top_k, i % top_k);
+                match name {
+                    "distinct" => (r * top_k + s) as u32,
+                    // Four shared slots: close to the measured 25-30 percent
+                    // saved reads at three and four rows.
+                    "partial" if s < 4 => s as u32,
+                    "partial" => (r * top_k + s) as u32,
+                    _ => s as u32,
+                }
+            })
+            .collect()
+    };
+    let mut cases = Vec::new();
+    for m in 1..=4 {
+        let x = Tensor::zeros(&ctx, &[m, h], DType::BF16)?;
+        let ea = Tensor::zeros(&ctx, &[m * top_k, inter], DType::BF16)?;
+        let scores = Tensor::zeros(&ctx, &[m, top_k], DType::F32)?;
+        let shared = Tensor::zeros(&ctx, &[m, h], DType::BF16)?;
+        let gate = Tensor::zeros(&ctx, &[m], DType::F32)?;
+        let out = Tensor::zeros(&ctx, &[m, h], DType::BF16)?;
+        let names: &[&str] =
+            if m == 1 { &["distinct"] } else { &["distinct", "partial", "same"] };
+        for name in names {
+            let ids_values = pattern(name, m);
+            let distinct = {
+                let mut v = ids_values.clone();
+                v.sort_unstable();
+                v.dedup();
+                v.len()
+            };
+            let ids = Tensor::from_bytes(
+                &ctx,
+                bytemuck::cast_slice(&ids_values),
+                &[m, top_k],
+                DType::U32,
+            )?;
+            let run = |stage: usize| -> Result<f64> {
+                let pass = ctx.begin_concurrent()?;
+                for (g, u, d) in &banks {
+                    match stage {
+                        0 => {
+                            moe::moe_gate_up_decode_rows(
+                                &ctx, &pass, g, u, inter, &x, &ids, &ea, top_k,
+                            )?;
+                            pass.level_barrier(&[&ea])?;
+                        }
+                        1 => {
+                            moe::moe_down_combine_decode_rows(
+                                &ctx, &pass, d, h, &ea, &ids, &scores, &shared, &gate,
+                                &out, top_k,
+                            )?;
+                            pass.level_barrier(&[&out])?;
+                        }
+                        2 => {
+                            moe::moe_gate_up_shared_rows(
+                                &ctx, &pass, g, u, inter, &x, &ids, &ea, top_k,
+                            )?;
+                            pass.level_barrier(&[&ea])?;
+                        }
+                        _ => {
+                            moe::moe_down_combine_shared_rows(
+                                &ctx, &pass, d, h, &ea, &ids, &scores, &shared, &gate,
+                                &out, top_k, None,
+                            )?;
+                            pass.level_barrier(&[&out])?;
+                        }
+                    }
+                }
+                let done = pass.commit()?.wait_retain()?;
+                let t = done.timing()?;
+                Ok((t.gpu_end_secs - t.gpu_start_secs) * 1e3)
+            };
+            let mut samples = [Vec::new(), Vec::new(), Vec::new(), Vec::new()];
+            for round in 0..14 {
+                for stage in 0..4 {
+                    let ms = run(stage)?;
+                    if round >= 2 {
+                        samples[stage].push(ms);
+                    }
+                }
+            }
+            let median = |v: &mut Vec<f64>| {
+                v.sort_by(f64::total_cmp);
+                v[v.len() / 2]
+            };
+            let (gu, dn) = (median(&mut samples[0]), median(&mut samples[1]));
+            let (sgu, sdn) = (median(&mut samples[2]), median(&mut samples[3]));
+            cases.push(serde_json::json!({
+                "rows": m, "pattern": name, "distinct_experts": distinct,
+                "gate_up_ms_48_layers": gu, "down_combine_ms_48_layers": dn,
+                "shared_gate_up_ms_48_layers": sgu, "shared_down_combine_ms_48_layers": sdn,
+            }));
+        }
+    }
+    eprintln!(
+        "{}",
+        serde_json::json!({"scope":"moe_rows_expert_overlap_timing","attempt":"20261119-LILYROWS-03","layers":layers,"samples":12,"cases":cases})
+    );
+    Ok(())
+}
+
+/// Test values by style: 0 ordinary, 1 mostly BF16 subnormals (both signs)
+/// mixed with ordinary values, 2 large near-cancelling pairs.
+fn styled_values(seed: &mut u32, n: usize, style: u8) -> Vec<f32> {
+    let ordinary = |seed: &mut u32| (word(seed) % 4097) as f32 / 1024.0 - 2.0;
+    (0..n)
+        .map(|i| match style {
+            1 => {
+                let w = word(seed);
+                if w % 4 != 0 {
+                    let bits = ((w >> 8) % 0x7f + 1) as u16
+                        | if w & 0x10 != 0 { 0x8000 } else { 0 };
+                    half::bf16::from_bits(bits).to_f32()
+                } else {
+                    ordinary(seed)
+                }
+            }
+            2 => {
+                let w = word(seed);
+                let big = ((w % 4097) as f32 + 1.0) * 64.0;
+                if i % 2 == 0 { big } else { -big + ((w >> 16) % 5) as f32 * 0.25 }
+            }
+            _ => ordinary(seed),
+        })
+        .collect()
+}
+
+/// Q4 group-64 weights whose affine terms follow `styled_values`: style 1
+/// gives subnormal scales and biases, style 2 large cancelling biases.
+fn styled_weights(
+    ctx: &MetalContext,
+    seed: &mut u32,
+    n: usize,
+    k: usize,
+    style: u8,
+) -> Result<QuantWeights> {
+    if style == 0 {
+        return weights(ctx, seed, 4, n, k);
+    }
+    let words = k / 8;
+    let codes: Vec<_> = (0..n * words).map(|_| word(seed)).collect();
+    let groups = n * k / 64;
+    let (scales, biases) = if style == 1 {
+        (styled_values(seed, groups, 1), styled_values(seed, groups, 1))
+    } else {
+        let scales: Vec<_> =
+            (0..groups).map(|_| (word(seed) % 127 + 1) as f32 / 4096.0).collect();
+        (scales, styled_values(seed, groups, 2))
+    };
+    Ok(QuantWeights {
+        codes: Tensor::from_bytes(
+            ctx,
+            bytemuck::cast_slice(&codes),
+            &[n, words],
+            DType::U32,
+        )?,
+        scales: Tensor::from_f32_as_bf16(ctx, &scales, &[n, k / 64])?,
+        biases: Tensor::from_f32_as_bf16(ctx, &biases, &[n, k / 64])?,
+        bits: 4,
+        group_size: 64,
+    })
+}
