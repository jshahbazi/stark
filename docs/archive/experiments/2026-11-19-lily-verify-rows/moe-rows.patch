@@ -0,0 +1,333 @@
+// SPDX-License-Identifier: Apache-2.0
+// Stark (attempt 20261119-LILYROWS-03): verifier rows that share routed
+// experts. Each distinct expert selected by any row of a verify pass is read
+// once; every row keeps its own accumulation with exactly the per-row decode
+// lane mapping, loop order and BF16 boundaries of
+// `stark_moe_gate_up_decode_rows` and `moe_down_combine_inject_body<16, 4>`.
+// Compiled after moe.metal (MOE_MAX_K).
+//
+// Grouping is recomputed inside each threadgroup from the [M, TOPK] routed
+// ids: entry j = r * TOPK + s owns expert ids[j] if no earlier entry selected
+// the same expert. Its members are, for each row r, the slot of that row that
+// selected the expert (top-k ids are distinct within a row), or none.
+
+constant uint STARK_MOE_NO_SLOT = 0xFFFFFFFFu;
+
+// One thread: serial form, used to fill a threadgroup table.
+template <uint R>
+static inline bool stark_moe_shared_members(device const uint* ids,
+                                            uint j, uint M, uint TOPK,
+                                            thread uint* member) {
+    const uint e = ids[j];
+    for (uint p = 0; p < j; ++p) {
+        if (ids[p] == e) {
+            return false;
+        }
+    }
+    for (uint r = 0; r < R; ++r) {
+        member[r] = STARK_MOE_NO_SLOT;
+        if (r < M) {
+            for (uint s = 0; s < TOPK; ++s) {
+                if (ids[r * TOPK + s] == e) {
+                    member[r] = r * TOPK + s;
+                }
+            }
+        }
+    }
+    return true;
+}
+
+// One simdgroup cooperatively: every lane returns the same answer.
+template <uint R>
+static inline bool stark_moe_shared_members_simd(device const uint* ids,
+                                                 uint j, uint M, uint TOPK,
+                                                 uint lane, thread uint* member) {
+    const uint e = ids[j];
+    const uint S = M * TOPK;
+    bool earlier = false;
+    for (uint p = lane; p < j; p += 32) {
+        earlier = earlier || ids[p] == e;
+    }
+    if (simd_any(earlier)) {
+        return false;
+    }
+    constexpr uint T = (R * MOE_MAX_K + 31) / 32;
+    uint found[T];
+    for (uint t = 0; t < T; ++t) {
+        const uint q = lane + 32 * t;
+        found[t] = (q < S && ids[q] == e) ? q : STARK_MOE_NO_SLOT;
+    }
+    for (uint r = 0; r < R; ++r) {
+        uint c = STARK_MOE_NO_SLOT;
+        for (uint t = 0; t < T; ++t) {
+            if (found[t] != STARK_MOE_NO_SLOT && found[t] / TOPK == r) {
+                c = found[t];
+            }
+        }
+        member[r] = simd_min(c);
+    }
+    return true;
+}
+
+// Grid (N, M * TOPK), 32 threads. Threadgroups of non-owning entries exit.
+template <uint R>
+static inline void stark_moe_gate_up_shared_rows_body(
+    device const uint* gate_codes, device const bfloat* gate_scales,
+    device const bfloat* gate_biases, device const uint* up_codes,
+    device const bfloat* up_scales, device const bfloat* up_biases,
+    device const bfloat* x, device const uint* indices, device bfloat* y,
+    uint K, uint GS, uint N, uint TOPK, uint M, uint row, uint entry,
+    uint lane) {
+    uint member[R];
+    if (!stark_moe_shared_members_simd<R>(indices, entry, M, TOPK, lane, member)) {
+        return;
+    }
+    const ulong grow = (ulong)indices[entry] * N + row;
+    const uint words = K / 8;
+    const uint blocks = words / 4;
+    const uint bpg = GS / 32;
+    const uint groups = K / GS;
+    device const uint4* gate_wrow =
+        (device const uint4*)(gate_codes + grow * words);
+    device const uint4* up_wrow =
+        (device const uint4*)(up_codes + grow * words);
+    float gate_sum[R];
+    float up_sum[R];
+    for (uint r = 0; r < R; ++r) {
+        gate_sum[r] = 0.0f;
+        up_sum[r] = 0.0f;
+    }
+    for (uint i = lane; i < blocks; i += 32) {
+        uint g = i / bpg;
+        uint4 gate_w4 = gate_wrow[i];
+        uint4 up_w4 = up_wrow[i];
+        const float gs = float(gate_scales[grow * groups + g]);
+        const float gb = float(gate_biases[grow * groups + g]);
+        const float us = float(up_scales[grow * groups + g]);
+        const float ub = float(up_biases[grow * groups + g]);
+        // Each sharing row runs decode's complete block body in turn (only
+        // the weight words and affine terms are shared). Hoisting the nibble
+        // decode out of the row loop was measured slower and changed bytes
+        // under the default math mode (20261119-LILYROWS-03).
+        for (uint r = 0; r < R; ++r) {
+            if (member[r] == STARK_MOE_NO_SLOT) {
+                continue;
+            }
+            device const bfloat4* xv = (device const bfloat4*)(x + (ulong)r * K);
+            float gate_dot = 0.0f;
+            float up_dot = 0.0f;
+            float x_sum = 0.0f;
+            for (uint j = 0; j < 4; ++j) {
+                float4 xlo = float4(xv[2 * (4 * i + j)]);
+                float4 xhi = float4(xv[2 * (4 * i + j) + 1]);
+                uint gw = gate_w4[j];
+                uint uw = up_w4[j];
+                float4 gqlo = float4(float((gw >> 0) & 0xF), float((gw >> 4) & 0xF),
+                                     float((gw >> 8) & 0xF), float((gw >> 12) & 0xF));
+                float4 gqhi = float4(float((gw >> 16) & 0xF), float((gw >> 20) & 0xF),
+                                     float((gw >> 24) & 0xF), float((gw >> 28) & 0xF));
+                float4 uqlo = float4(float((uw >> 0) & 0xF), float((uw >> 4) & 0xF),
+                                     float((uw >> 8) & 0xF), float((uw >> 12) & 0xF));
+                float4 uqhi = float4(float((uw >> 16) & 0xF), float((uw >> 20) & 0xF),
+                                     float((uw >> 24) & 0xF), float((uw >> 28) & 0xF));
+                gate_dot += dot(gqlo, xlo) + dot(gqhi, xhi);
+                up_dot += dot(uqlo, xlo) + dot(uqhi, xhi);
+                x_sum += dot(xlo, float4(1.0f)) + dot(xhi, float4(1.0f));
+            }
+            gate_sum[r] += gs * gate_dot + gb * x_sum;
+            up_sum[r] += us * up_dot + ub * x_sum;
+        }
+    }
+    for (uint r = 0; r < R; ++r) {
+        if (member[r] == STARK_MOE_NO_SLOT) {
+            continue;
+        }
+        float gsum = simd_sum(gate_sum[r]);
+        float usum = simd_sum(up_sum[r]);
+        if (lane == 0) {
+            gsum = float(bfloat(gsum));
+            usum = float(bfloat(usum));
+            y[(ulong)member[r] * N + row] =
+                bfloat((gsum / (1.0f + exp(-gsum))) * usum);
+        }
+    }
+}
+
+#define STARK_MOE_GATE_UP_SHARED_ROWS(R)                                     \
+kernel void stark_moe_gate_up_shared_rows_r##R(                              \
+    device const uint* gate_codes [[buffer(0)]],                             \
+    device const bfloat* gate_scales [[buffer(1)]],                          \
+    device const bfloat* gate_biases [[buffer(2)]],                          \
+    device const uint* up_codes [[buffer(3)]],                               \
+    device const bfloat* up_scales [[buffer(4)]],                            \
+    device const bfloat* up_biases [[buffer(5)]],                            \
+    device const bfloat* x [[buffer(6)]],                                    \
+    device const uint* indices [[buffer(7)]],                                \
+    device bfloat* y [[buffer(8)]],                                          \
+    constant uint& K [[buffer(9)]],                                          \
+    constant uint& GS [[buffer(10)]],                                        \
+    constant uint& N [[buffer(11)]],                                         \
+    constant uint& TOPK [[buffer(12)]],                                      \
+    constant uint& M [[buffer(13)]],                                         \
+    uint2 tg [[threadgroup_position_in_grid]],                               \
+    uint lane [[thread_index_in_threadgroup]]) {                             \
+    stark_moe_gate_up_shared_rows_body<R>(gate_codes, gate_scales,           \
+        gate_biases, up_codes, up_scales, up_biases, x, indices, y, K, GS,   \
+        N, TOPK, M, tg.x, tg.y, lane);                                       \
+}
+
+STARK_MOE_GATE_UP_SHARED_ROWS(4)
+STARK_MOE_GATE_UP_SHARED_ROWS(9)
+
+// Grid (H / 2), 128 threads (four simdgroups, 16 lanes per output row, two
+// rows per simdgroup). Simdgroup sg walks owning entries sg, sg + 4, ...;
+// each per-slot sum keeps the decode lane order and shuffle reduction. The
+// slot-ordered combine, shared expert and optional HC write (G > 0) then run
+// per row exactly as `moe_down_combine_inject_body`.
+template <uint R>
+static inline void stark_moe_down_shared_rows_body(
+    device const uint* codes, device const bfloat* scales,
+    device const bfloat* biases, device const bfloat* x,
+    device const uint* indices, device const float* scores,
+    device const bfloat* shared_out, device const float* shared_gate,
+    device bfloat* out, device bfloat* hyper, device const bfloat* inj,
+    uint G, float inv_g, uint K, uint GS, uint H, uint TOPK, uint M,
+    uint group, uint sg, uint lane, threadgroup float* xchg,
+    threadgroup uint* table, threadgroup uint* owners) {
+    constexpr uint LANES = 16;
+    constexpr uint SG = 4;
+    constexpr uint ROWS = 32 / LANES;
+    const uint hlane = lane % LANES;
+    const uint rl = lane / LANES;
+    const uint row = group * ROWS + rl;
+    const uint words = K / 8;
+    const uint blocks = words / 4;
+    const uint bpg = GS / 32;
+    const uint groups = K / GS;
+    const uint S = M * TOPK;
+    const uint tid = sg * 32 + lane;
+    // Ownership/member table, built once per threadgroup (S <= 128 threads).
+    if (tid < S) {
+        uint m[R];
+        const bool owner = stark_moe_shared_members<R>(indices, tid, M, TOPK, m);
+        for (uint r = 0; r < R; ++r) {
+            table[tid * R + r] = owner ? m[r] : STARK_MOE_NO_SLOT;
+        }
+        owners[tid] = owner ? 1u : 0u;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (uint entry = sg; entry < S; entry += SG) {
+        if (owners[entry] == 0) {
+            continue;
+        }
+        uint member[R];
+        for (uint r = 0; r < R; ++r) {
+            member[r] = table[entry * R + r];
+        }
+        const ulong grow = (ulong)indices[entry] * H + row;
+        device const uint4* wrow = (device const uint4*)(codes + grow * words);
+        float sum[R];
+        for (uint r = 0; r < R; ++r) {
+            sum[r] = 0.0f;
+        }
+        for (uint i = hlane; i < blocks; i += LANES) {
+            const uint g = i / bpg;
+            const float scale = float(scales[grow * groups + g]);
+            const float bias = float(biases[grow * groups + g]);
+            const uint4 w4 = wrow[i];
+            for (uint r = 0; r < R; ++r) {
+                if (member[r] == STARK_MOE_NO_SLOT) {
+                    continue;
+                }
+                device const bfloat4* xv =
+                    (device const bfloat4*)(x + (ulong)member[r] * K);
+                float qx = 0.0f;
+                float xs = 0.0f;
+                for (uint j = 0; j < 4; ++j) {
+                    const uint word = w4[j];
+                    const float4 xlo = float4(xv[2 * (4 * i + j)]);
+                    const float4 xhi = float4(xv[2 * (4 * i + j) + 1]);
+                    const float4 qlo =
+                        float4(float((word >> 0) & 0xF), float((word >> 4) & 0xF),
+                               float((word >> 8) & 0xF), float((word >> 12) & 0xF));
+                    const float4 qhi =
+                        float4(float((word >> 16) & 0xF), float((word >> 20) & 0xF),
+                               float((word >> 24) & 0xF), float((word >> 28) & 0xF));
+                    qx += dot(qlo, xlo) + dot(qhi, xhi);
+                    xs += dot(xlo, float4(1.0f)) + dot(xhi, float4(1.0f));
+                }
+                sum[r] += scale * qx + bias * xs;
+            }
+        }
+        for (uint r = 0; r < R; ++r) {
+            if (member[r] == STARK_MOE_NO_SLOT) {
+                continue;
+            }
+            float v = sum[r];
+            for (uint off = LANES / 2; off > 0; off >>= 1) {
+                v += simd_shuffle_down(v, off);
+            }
+            if (hlane == 0) {
+                xchg[member[r] * ROWS + rl] = float(bfloat(v));
+            }
+        }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (tid >= M * ROWS) {
+        return;
+    }
+    const uint r = tid / ROWS;
+    const uint orl = tid % ROWS;
+    const uint orow = group * ROWS + orl;
+    device const float* rscores = scores + (ulong)r * TOPK;
+    float combined = 0.0f;
+    for (uint slot = 0; slot < TOPK; ++slot) {
+        combined += rscores[slot] * xchg[(r * TOPK + slot) * ROWS + orl];
+    }
+    {
+        const float gate = 1.0f / (1.0f + exp(-shared_gate[r]));
+        combined += gate * float(shared_out[(ulong)r * H + orow]);
+    }
+    const bfloat branch = bfloat(combined);
+    out[(ulong)r * H + orow] = branch;
+    for (uint g = 0; g < G; ++g) {
+        const float logit = float(inj[(ulong)r * G + g]) * inv_g;
+        const float weight = 2.0f / (1.0f + exp(-logit));
+        const ulong at = (ulong)r * G * H + (ulong)g * H + orow;
+        hyper[at] = bfloat(float(hyper[at]) + float(branch) * weight);
+    }
+}
+
+#define STARK_MOE_DOWN_SHARED_ROWS(R)                                        \
+kernel void stark_moe_down_combine_shared_rows_r##R(                         \
+    device const uint* codes [[buffer(0)]],                                  \
+    device const bfloat* scales [[buffer(1)]],                               \
+    device const bfloat* biases [[buffer(2)]],                               \
+    device const bfloat* x [[buffer(3)]],                                    \
+    device const uint* indices [[buffer(4)]],                                \
+    device const float* scores [[buffer(5)]],                                \
+    device const bfloat* shared [[buffer(6)]],                               \
+    device const float* gate [[buffer(7)]],                                  \
+    device bfloat* out [[buffer(8)]],                                        \
+    device bfloat* hyper [[buffer(9)]],                                      \
+    device const bfloat* inj [[buffer(10)]],                                 \
+    constant uint& K [[buffer(11)]],                                         \
+    constant uint& GS [[buffer(12)]],                                        \
+    constant uint& H [[buffer(13)]],                                         \
+    constant uint& TOPK [[buffer(14)]],                                      \
+    constant uint& M [[buffer(15)]],                                         \
+    constant uint& G [[buffer(16)]],                                         \
+    constant float& inv_g [[buffer(17)]],                                    \
+    uint group [[threadgroup_position_in_grid]],                             \
+    uint sg [[simdgroup_index_in_threadgroup]],                              \
+    uint lane [[thread_index_in_simdgroup]]) {                               \
+    threadgroup float xchg[R * MOE_MAX_K * 2];                               \
+    threadgroup uint table[R * MOE_MAX_K * R];                               \
+    threadgroup uint owners[R * MOE_MAX_K];                                  \
+    stark_moe_down_shared_rows_body<R>(codes, scales, biases, x, indices,    \
+        scores, shared, gate, out, hyper, inj, G, inv_g, K, GS, H, TOPK, M,  \
+        group, sg, lane, xchg, table, owners);                               \
+}
