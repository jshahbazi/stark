+/// Fills `values` with one of the HC byte-test input styles: 0 random, 1
+/// zeros, 2 alternating +-32 (cancellation), 3 signed zeros, subnormals and
+/// +-1, 4 random with per-row magnitudes 2^(4m), 5 random bf16 bit patterns
+/// with small exponents (subnormal-heavy) and both signs.
+fn hc_style_values(state: &mut u32, values: &mut [f32], row_len: usize, style: usize) {
+    for (i, v) in values.iter_mut().enumerate() {
+        match style {
+            1 => *v = 0.0,
+            2 => *v = if i.is_multiple_of(2) { 32.0 } else { -32.0 },
+            3 => {
+                *v = half::bf16::from_bits(
+                    [0x0000, 0x8000, 0x0001, 0x8001, 0x3f80, 0xbf80][i % 6],
+                )
+                .to_f32();
+            }
+            4 => *v *= (16.0f32).powi((i / row_len) as i32),
+            5 => {
+                let word = next_word(state);
+                let exponent = (word >> 16) % 6;
+                let bits = ((word & 0x8000) | (exponent << 7) | (word & 0x7f)) as u16;
+                *v = half::bf16::from_bits(bits).to_f32();
+            }
+            _ => {}
+        }
+    }
+}
+
+/// The verifier HC read as `hc_read_verify_exact` encodes it (the
+/// shared-weight `hc_read_down_q8_m<rows>` kernel, then the row-axis cached
+/// up body) against the MB=1 decode bodies, at every supported row count:
+/// three weight/input draws of production and edge geometries, with and
+/// without injection, offset input and output views, output canaries, and
+/// input styles covering zeros, subnormals, per-row magnitude spread and
+/// cancellation. The up half is also checked alone on activations, streams
+/// and inverse RMS values in the same styles. A shared-weight up kernel is
+/// not used: rearranged multi-row up bodies tried in attempt
+/// 20261119-LILYROWS-01 differed from the one-row body in single bf16
+/// outputs under the compiler's fast-math scheduling.
+#[test]
+#[ignore = "requires a physical Apple Silicon Metal device"]
+fn verifier_shared_rows_match_ordinary_hc_bytes() -> Result<()> {
+    let ctx = MetalContext::new()?;
+    let mut reference_hash = Sha256::new();
+    let mut candidate_hash = Sha256::new();
+    let (mut cases, mut checked_bytes) = (0usize, 0usize);
+    let geometries = [
+        (2560, 4, 320, 64),
+        (208, 4, 192, 64),
+        (192, 3, 128, 64),
+        (176, 1, 80, 16),
+        (64, 8, 64, 64),
+    ];
+    // Three independent weight/input draws per geometry.
+    let draws = [0x5348_5257u32, 0x2545_f491, 0x9e37_79b9]
+        .into_iter()
+        .flat_map(|seed| geometries.into_iter().map(move |geometry| (seed, geometry)));
+    for (seed, (h, g, r, gs)) in draws {
+        let mut state = seed ^ (h * 8 + g) as u32;
+        let k = h * g;
+        let down = q8_weight(&ctx, &mut state, r, k, gs)?;
+        let up = q8_weight(&ctx, &mut state, k, r, gs)?;
+        let inject_w = q8_weight(&ctx, &mut state, g, k, gs)?;
+        let norm_storage = Tensor::from_f32_as_bf16(
+            &ctx,
+            &random_values(&mut state, k + 4, 1.0, -0.5),
+            &[k + 4],
+        )?;
+        let norm = norm_storage.view(2, &[k])?;
+        for m in 1..=HC_FUSED_MAX_ROWS {
+            for style in 0..6 {
+                let mut x = random_values(&mut state, m * k + 4, 6.0, -3.0);
+                hc_style_values(&mut state, &mut x[2..], k, style);
+                let hyper_storage = Tensor::from_f32_as_bf16(&ctx, &x, &[m * k + 4])?;
+                let hyper = hyper_storage.view(2, &[m, k])?;
+                for with_inject in [true, false] {
+                    let inject = with_inject.then_some(&inject_w);
+                    let reference: Vec<_> = (0..m)
+                        .map(|_| ReadOutputs::new(&ctx, h, g, r))
+                        .collect::<Result<_>>()?;
+                    let candidate = ReadOutputs::rows(&ctx, m, h, g, r)?;
+                    let pass = ctx.begin_concurrent()?;
+                    for (row, out) in reference.iter().enumerate() {
+                        hc_read_down_q8_rows(
+                            &ctx,
+                            &pass,
+                            &hyper.view(row * k, &[1, k])?,
+                            &norm,
+                            &down,
+                            inject,
+                            &out.down.value,
+                            &out.inj.value,
+                            &out.inv_rms.value,
+                            &out.act.value,
+                            h,
+                            g,
+                            1e-6,
+                            1.0,
+                        )?;
+                    }
+                    hc_read_down_q8_rows(
+                        &ctx,
+                        &pass,
+                        &hyper,
+                        &norm,
+                        &down,
+                        inject,
+                        &candidate.down.value,
+                        &candidate.inj.value,
+                        &candidate.inv_rms.value,
+                        &candidate.act.value,
+                        h,
+                        g,
+                        1e-6,
+                        1.0,
+                    )?;
+                    pass.level_barrier(&[])?;
+                    for (row, out) in reference.iter().enumerate() {
+                        hc_read_up_mix_q8_cached(
+                            &ctx,
+                            &pass,
+                            &up,
+                            &out.act.value,
+                            &hyper.view(row * k, &[1, k])?,
+                            &norm,
+                            &out.inv_rms.value,
+                            &out.mixed.value,
+                            h,
+                            g,
+                            1.0,
+                        )?;
+                    }
+                    hc_read_up_mix_q8_cached_rows(
+                        &ctx,
+                        &pass,
+                        &up,
+                        &candidate.act.value,
+                        &hyper,
+                        &norm,
+                        &candidate.inv_rms.value,
+                        &candidate.mixed.value,
+                        h,
+                        g,
+                        1.0,
+                    )?;
+                    pass.commit_wait()?;
+                    for (index, (field, b)) in
+                        candidate.fields().into_iter().enumerate()
+                    {
+                        b.check_canaries()?;
+                        if !with_inject && field == "inject" {
+                            continue;
+                        }
+                        let bytes = b.value.raw_bytes();
+                        let stride = bytes.len() / m;
+                        for (row, out) in reference.iter().enumerate() {
+                            let a = out.fields()[index].1;
+                            a.check_canaries()?;
+                            let diff = a
+                                .value
+                                .raw_bytes()
+                                .chunks(2)
+                                .zip(bytes[row * stride..(row + 1) * stride].chunks(2))
+                                .filter(|(x, y)| x != y)
+                                .count();
+                            ensure!(
+                                diff == 0,
+                                "HC shared verifier mismatch: field={field} row={row} rows={m} h={h} g={g} r={r} gs={gs} inject={with_inject} style={style} unequal_elements={diff}"
+                            );
+                            reference_hash.update(a.value.raw_bytes());
+                        }
+                        candidate_hash.update(bytes);
+                        checked_bytes += bytes.len();
+                    }
+                    cases += 1;
+                }
+                // The up kernel alone on activations and inverse RMS values
+                // in the same styles (the end-to-end path only reaches SiLU
+                // outputs of the down logits).
+                let mut act_values = random_values(&mut state, m * r + 4, 8.0, -4.0);
+                hc_style_values(&mut state, &mut act_values[2..], r, style);
+                let mut hyper_up_values = random_values(&mut state, m * k, 6.0, -3.0);
+                hc_style_values(&mut state, &mut hyper_up_values, k, style);
+                let hyper_up =
+                    Tensor::from_f32_as_bf16(&ctx, &hyper_up_values, &[m, k])?;
+                let act_storage =
+                    Tensor::from_f32_as_bf16(&ctx, &act_values, &[m * r + 4])?;
+                let act = act_storage.view(2, &[m, r])?;
+                let rms_values = random_values(&mut state, m * g, 2.0, 0.001);
+                let inv_rms = Tensor::from_f32(&ctx, &rms_values, &[m, g])?;
+                let reference: Vec<_> = (0..m)
+                    .map(|_| GuardedTensor::new(&ctx, h, DType::BF16))
+                    .collect::<Result<_>>()?;
+                let candidate = GuardedTensor::rows(&ctx, m, h, DType::BF16)?;
+                let pass = ctx.begin_concurrent()?;
+                for (row, out) in reference.iter().enumerate() {
+                    hc_read_up_mix_q8_cached(
+                        &ctx,
+                        &pass,
+                        &up,
+                        &act.view(row * r, &[1, r])?,
+                        &hyper_up.view(row * k, &[1, k])?,
+                        &norm,
+                        &inv_rms.view(row * g, &[1, g])?,
+                        &out.value,
+                        h,
+                        g,
+                        1.0,
+                    )?;
+                }
+                hc_read_up_mix_q8_cached_rows(
+                    &ctx,
+                    &pass,
+                    &up,
+                    &act,
+                    &hyper_up,
+                    &norm,
+                    &inv_rms,
+                    &candidate.value,
+                    h,
+                    g,
+                    1.0,
+                )?;
+                pass.commit_wait()?;
+                candidate.check_canaries()?;
+                let bytes = candidate.value.raw_bytes();
+                let stride = bytes.len() / m;
+                for (row, out) in reference.iter().enumerate() {
+                    out.check_canaries()?;
+                    let a = out.value.raw_bytes();
+                    let b = &bytes[row * stride..(row + 1) * stride];
+                    let diff =
+                        a.chunks(2).zip(b.chunks(2)).filter(|(x, y)| x != y).count();
+                    ensure!(
+                        diff == 0,
+                        "HC shared verifier up-only mismatch: row={row} rows={m} h={h} g={g} r={r} gs={gs} style={style} unequal_elements={diff}"
+                    );
+                    reference_hash.update(out.value.raw_bytes());
+                }
+                candidate_hash.update(bytes);
+                checked_bytes += bytes.len();
+                cases += 1;
+            }
+        }
+    }
+    let (reference_hash, candidate_hash) =
+        (hex(&reference_hash.finish()), hex(&candidate_hash.finish()));
