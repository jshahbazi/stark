+
+/// GPU time per HC read of each verifier variant at 1 to HC_FUSED_MAX_ROWS
+/// rows, over 97 distinct weight sets (the model's HC read count) so the
+/// weights stream from DRAM as they do in a verify pass. Down and up halves
+/// are timed in separate chains.
+#[test]
+#[ignore = "requires a physical Apple Silicon Metal device; diagnostic timing only"]
+fn verifier_rows_streaming_timing() -> Result<()> {
+    let ctx = MetalContext::new()?;
+    let mut random = 0x4843_5257u32;
+    let (h, g, r, gs, reads) = (2560, 4, 320, 64, 97);
+    let k = g * h;
+    let max_rows = HC_FUSED_MAX_ROWS;
+    let hyper = Tensor::from_f32_as_bf16(
+        &ctx,
+        &random_values(&mut random, max_rows * k, 6.0, -3.0),
+        &[max_rows, k],
+    )?;
+    let mut weights = Vec::new();
+    for index in 0..reads {
+        let norm = Tensor::from_f32_as_bf16(
+            &ctx,
+            &random_values(&mut random, k, 1.0, -0.5),
+            &[k],
+        )?;
+        let down = q8_weight(&ctx, &mut random, r, k, gs)?;
+        let up = q8_weight(&ctx, &mut random, k, r, gs)?;
+        let inject = if index + 1 == reads {
+            None
+        } else {
+            Some(q8_weight(&ctx, &mut random, g, k, gs)?)
+        };
+        weights.push((norm, down, up, inject));
+    }
+    let out = VerifyTimingOutputs {
+        down: Tensor::zeros(&ctx, &[max_rows, r], DType::BF16)?,
+        inj: Tensor::zeros(&ctx, &[max_rows, g], DType::BF16)?,
+        inv_rms: Tensor::zeros(&ctx, &[max_rows, g], DType::F32)?,
+        act: Tensor::zeros(&ctx, &[max_rows, r], DType::BF16)?,
+        mixed: Tensor::zeros(&ctx, &[max_rows, h], DType::BF16)?,
+    };
+    // Give the up chains a realistic activation and inverse RMS.
+    let pass = ctx.begin_concurrent()?;
+    encode_verify_timing_variant(
+        &ctx,
+        &pass,
+        0,
+        max_rows,
+        &hyper,
+        &out,
+        &weights[0],
+        (h, g, r),
+    )?;
+    pass.commit_wait()?;
+    let configs: Vec<(usize, usize)> = (1..=max_rows)
+        .flat_map(|rows| (0..VERIFY_TIMING_VARIANTS.len()).map(move |v| (rows, v)))
+        .collect();
+    let mut times = vec![Vec::new(); configs.len()];
+    let warmup = std::time::Instant::now();
+    let mut round = 0usize;
+    let mut measured_rounds = 0;
+    loop {
+        let timed = warmup.elapsed() >= std::time::Duration::from_secs(2);
+        for step in 0..configs.len() {
+            let index = (step + round) % configs.len();
+            let (rows, variant) = configs[index];
+            let pass = ctx.begin_concurrent()?;
+            for w in &weights {
+                encode_verify_timing_variant(
+                    &ctx,
+                    &pass,
+                    variant,
+                    rows,
+                    &hyper,
+                    &out,
+                    w,
+                    (h, g, r),
+                )?;
+                pass.level_barrier(&[&out.down, &out.mixed])?;
+            }
+            let completed = pass.commit()?.wait_retain()?;
+            let timing = completed.timing()?;
+            if timed {
+                times[index].push((timing.gpu_end_secs - timing.gpu_start_secs) * 1e3);
+            }
+        }
+        round += 1;
+        if timed {
+            measured_rounds += 1;
+            if measured_rounds == 12 {
+                break;
+            }
+        }
+    }
+    for (index, samples) in times.iter_mut().enumerate() {
+        let (rows, variant) = configs[index];
+        samples.sort_unstable_by(f64::total_cmp);
+        let median = (samples[5] + samples[6]) * 0.5;
+        eprintln!(
+            "HC verify timing: variant={} rows={rows} reads={reads} samples={} min_ms_per_pass={:.4} median_ms_per_pass={median:.4}",
+            VERIFY_TIMING_VARIANTS[variant],
+            samples.len(),
+            samples[0],
+        );
+    }
+    Ok(())
+}
