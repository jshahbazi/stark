+// SPDX-License-Identifier: Apache-2.0
+//! Read-only test accounting over the unchanged encoder residency admission.
+
+use super::*;
+
+impl Weights {
+    pub(in crate::engine::hybrid) fn t2_probe_accounting(&self) -> Result<[usize; 6]> {
+        let guard = self.encoder_residency.lock().map_err(|_| Error::Invalid("T2 residency lock"))?;
+        let r = guard.as_ref().ok_or(Error::Invalid("T2 residency admission missing"))?;
+        if r.failed {
+            return Err(Error::Invalid("T2 residency failed"));
+        }
+        let driver = r.driver.lock().map_err(|_| Error::Invalid("T2 residency driver lock"))?;
+        let actual = usize::try_from(driver.set.allocated_size()).map_err(|_| Error::Invalid("T2 allocation size"))?;
+        let required = r.required(r.bank_bytes, r.static_bytes, actual)?;
+        let (cap, dynamic) = (r.cap, r.dynamic_allowance);
+        drop(driver);
+        drop(guard);
+        let statics = self.static_views.lock().map_err(|_| Error::Invalid("T2 static cache lock"))?;
+        if statics.registered_bytes > statics.limit || statics.limit != MAX_STATIC_VIEW_BYTES {
+            return Err(Error::Invalid("T2 static cache exceeded existing bound"));
+        }
+        Ok([cap, required, actual, statics.registered_bytes, statics.entries.len(), dynamic])
+    }
+}
diff --git a/scripts/probe_glm53_t2.py b/scripts/probe_glm53_t2.py
