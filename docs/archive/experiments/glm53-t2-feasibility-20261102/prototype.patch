+// SPDX-License-Identifier: Apache-2.0
+//! Ignored target-pair parity/cost probe. No speculative runtime or rollback.
+//!
+//! The pair reuses the production layer-major encoder with MMA disabled. The
+//! serial tap uses the same existing GLM Metal layer and final readout math;
+//! eight full logit rows first gate that tap against the ordinary serial API.
+
+use std::{io::Read, path::PathBuf, time::Instant};
+
+use serde::Deserialize;
+use sha2::{Digest, Sha256};
+use stark_engine_macros::stark_test;
+
+use super::*;
+use crate::engine::hybrid::{glm_metal, profile, weight_metal::allocated_bytes};
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Case {
+    input_token_ids: Vec<u32>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Request {
+    schema_version: usize,
+    cases: Vec<Case>,
+    continuation_tokens: usize,
+    rounds: usize,
+    context_tokens: usize,
+    corpus_sha256: String,
+}
+
+struct Row {
+    hidden: Vec<f32>,
+    logits: Vec<f32>,
+    choice: u32,
+}
+
+struct Reference {
+    inputs: Vec<u32>,
+    rows: Vec<Row>,
+}
+
+#[derive(Default, serde::Serialize)]
+struct Memory {
+    cap_bytes: usize,
+    observed_required_peak_bytes: usize,
+    residency_allocated_peak_bytes: usize,
+    static_registered_peak_bytes: usize,
+    static_entries_peak: usize,
+    dynamic_allowance_bytes: usize,
+    sampled_metal_peak_bytes: usize,
+    graph_scratch_high_water_bytes: usize,
+}
+
+impl Memory {
+    fn observe(
+        &mut self,
+        model: &GlmModel,
+    ) -> Result<()> {
+        let [cap, required, actual, statics, entries, dynamic] = model.weights.t2_probe_accounting()?;
+        self.cap_bytes = cap;
+        self.observed_required_peak_bytes = self.observed_required_peak_bytes.max(required);
+        self.residency_allocated_peak_bytes = self.residency_allocated_peak_bytes.max(actual);
+        self.static_registered_peak_bytes = self.static_registered_peak_bytes.max(statics);
+        self.static_entries_peak = self.static_entries_peak.max(entries);
+        self.dynamic_allowance_bytes = dynamic;
+        self.sampled_metal_peak_bytes = self.sampled_metal_peak_bytes.max(allocated_bytes()?);
+        let counters = profile::snapshot();
+        if let Some(counter) = counters.get("native.metal.allocated_bytes") {
+            self.sampled_metal_peak_bytes = self.sampled_metal_peak_bytes.max(counter.max_bytes as usize);
+        }
+        if let Some(counter) = counters.get("native.metal.graph.scratch_high_water") {
+            self.graph_scratch_high_water_bytes = self.graph_scratch_high_water_bytes.max(counter.max_bytes as usize);
+        }
+        if self.sampled_metal_peak_bytes > cap || self.graph_scratch_high_water_bytes > 512 * 1024 * 1024 {
+            return Err(Error::Invalid("T2 memory cap"));
+        }
+        Ok(())
+    }
+}
+
+fn same(
+    a: &[f32],
+    b: &[f32],
+) -> bool {
+    a.len() == b.len() && a.iter().zip(b).all(|(a, b)| a.to_bits() == b.to_bits())
+}
+
+fn choice(values: &[f32]) -> Result<u32> {
+    if values.is_empty() || values.iter().any(|v| !v.is_finite()) {
+        return Err(Error::Invalid("T2 greedy values"));
+    }
+    let mut best = 0;
+    for i in 1..values.len() {
+        if values[i] > values[best] {
+            best = i;
+        }
+    }
+    Ok(best as u32)
+}
+
+fn take_row(
+    rows: &mut impl Iterator<Item = Vec<f32>>,
+    c: &Config,
+) -> Result<Row> {
+    let hidden = rows.next().ok_or(Error::Invalid("T2 hidden row"))?;
+    let index = rows.next().ok_or(Error::Invalid("T2 greedy row"))?;
+    let logits = rows.next().ok_or(Error::Invalid("T2 logit row"))?;
+    if hidden.len() != c.hidden
+        || hidden.iter().any(|v| !v.is_finite())
+        || index.len() != 1
+        || !index[0].is_finite()
+        || index[0] < 0.0
+        || index[0].fract() != 0.0
+        || index[0] as f64 >= c.vocab as f64
+        || logits.len() != c.vocab
+    {
+        return Err(Error::Invalid("T2 readout values"));
+    }
+    let selected = index[0] as u32;
+    if choice(&logits)? != selected {
+        return Err(Error::Invalid("T2 greedy parity"));
+    }
+    Ok(Row {
+        hidden,
+        logits,
+        choice: selected,
+    })
+}
+
+/// Serial source-equivalent target with full readout and a post-output-norm tap.
+/// No test layer-trace readbacks are inserted into this timing path.
+fn serial_row(
+    model: &mut GlmModel,
+    token: u32,
+    readout: bool,
+) -> Result<Option<Row>> {
+    objc2::rc::autoreleasepool(|_| {
+        let c = &model.config;
+        if model.cleanup_failed || token as usize >= c.vocab || model.position >= c.max_context {
+            return Err(Error::Invalid("T2 serial bounds"));
+        }
+        let decode = model.decode.as_mut().ok_or(Error::Invalid("T2 serial decode"))?;
+        let plan = decode.bounded_plan.clone().ok_or(Error::Invalid("T2 bounded plan"))?;
+        if !decode.encoder_banks || plan.groups.len() != 1 || decode.parallel_projections {
+            return Err(Error::Invalid("T2 serial policy"));
+        }
+        let embedding = model.weights.row("token_embd.weight", token as usize)?;
+        let mut streams = DecodeGraph::upload(&embedding.repeat(c.hc))?;
+        let mut graph = new_encoder_graph(decode)?;
+        let group = &plan.groups[0];
+        let banks = model.weights.encoder_indexed_group(&group.names, plan.budget)?;
+        if banks.registered_bytes() > group.bytes {
+            return Err(Error::Invalid("T2 serial inventory changed"));
+        }
+        for layer in group.start..group.end {
+            (graph, streams) = encode_metal_layer(
+                &model.weights,
+                c,
+                decode,
+                layer,
+                &mut model.states[layer],
+                graph,
+                streams,
+                Some(&banks),
+            )?;
+        }
+        let mut outputs = Vec::new();
+        if readout {
+            let mean = glm_metal::stream_mean(&mut graph, &streams, c.hidden, c.hc)?;
+            let hidden = graph.rms_norm(&mean, &decode.output_norm, c.hidden, c.rms_eps)?;
+            let logits = model.weights.encode_matvec(&mut graph, "output.weight", &hidden)?;
+            let greedy = graph.greedy_argmax(&logits)?;
+            outputs.extend([hidden, greedy, logits]);
+        } else {
+            graph.check_finite(&streams)?;
+        }
+        drop(banks);
+        let mut rows = graph.finish(&outputs)?.into_iter();
+        for state in &model.states {
+            if let LayerState::Kda(state) = state
+                && let Some(metal) = &state.metal
+            {
+                metal.check_completed()?;
+            }
+        }
+        model.position += 1;
+        model.last_greedy = None;
+        if readout {
+            take_row(&mut rows, c).map(Some)
+        } else {
+            Ok(None)
+        }
+    })
+}
+
+fn pair_rows(
+    model: &mut GlmModel,
+    tokens: &[u32],
+) -> Result<Vec<Row>> {
+    objc2::rc::autoreleasepool(|_| {
+        let c = &model.config;
+        if model.cleanup_failed
+            || tokens.len() != 2
+            || tokens.iter().any(|&t| t as usize >= c.vocab)
+            || model.position.checked_add(2).is_none_or(|end| end > c.max_context)
+        {
+            return Err(Error::Invalid("T2 pair bounds"));
+        }
+        let decode = model.decode.as_mut().ok_or(Error::Invalid("T2 pair decode"))?;
+        let plan = decode.bounded_plan.clone().ok_or(Error::Invalid("T2 bounded plan"))?;
+        if !decode.encoder_banks || plan.groups.len() != 1 || decode.parallel_projections {
+            return Err(Error::Invalid("T2 pair policy"));
+        }
+        let mut values = Vec::with_capacity(2 * c.hidden * c.hc);
+        for &token in tokens {
+            let embedding = model.weights.row("token_embd.weight", token as usize)?;
+            if embedding.len() != c.hidden || embedding.iter().any(|v| !v.is_finite()) {
+                return Err(Error::Invalid("T2 pair embedding"));
+            }
+            for _ in 0..c.hc {
+                values.extend_from_slice(&embedding);
+            }
+        }
+        let mut graph = new_encoder_graph(decode)?;
+        let mut streams = graph.upload_into(&values)?;
+        let group = &plan.groups[0];
+        let banks = model.weights.encoder_indexed_group(&group.names, plan.budget)?;
+        if banks.registered_bytes() > group.bytes {
+            return Err(Error::Invalid("T2 pair inventory changed"));
+        }
+        for layer in group.start..group.end {
+            // Two legacy row projections; no MMA or dot reassociation.
+            streams = encode_layer(
+                &model.weights,
+                c,
+                decode,
+                layer,
+                &mut model.states[layer],
+                &mut graph,
+                &streams,
+                &banks,
+                2,
+                false,
+            )?;
+        }
+        let mut outputs = Vec::with_capacity(6);
+        for token in 0..2 {
+            let row = streams.slice(token * c.hidden * c.hc, c.hidden * c.hc)?;
+            let mean = glm_metal::stream_mean(&mut graph, &row, c.hidden, c.hc)?;
+            let hidden = graph.rms_norm(&mean, &decode.output_norm, c.hidden, c.rms_eps)?;
+            let logits = model.weights.encode_matvec(&mut graph, "output.weight", &hidden)?;
+            let greedy = graph.greedy_argmax(&logits)?;
+            outputs.extend([hidden, greedy, logits]);
+        }
+        drop(banks);
+        let mut values = graph.finish(&outputs)?.into_iter();
+        let rows = vec![take_row(&mut values, c)?, take_row(&mut values, c)?];
+        for state in &model.states {
+            if let LayerState::Kda(state) = state
+                && let Some(metal) = &state.metal
+            {
+                metal.check_completed()?;
+            }
+        }
+        model.position += 2;
+        model.last_greedy = None;
+        Ok(rows)
+    })
+}
+
+fn compare_rows(
+    actual: &Row,
+    expected: &Row,
+) -> Result<()> {
+    if actual.choice != expected.choice
+        || !same(&actual.hidden, &expected.hidden)
+        || !same(&actual.logits, &expected.logits)
+    {
+        return Err(Error::Invalid("T2 complete row parity"));
+    }
+    Ok(())
+}
+
+fn prefill(
+    model: &mut GlmModel,
+    tokens: &[u32],
+) -> Result<Row> {
+    model.reset();
+    let mut last = None;
+    for (i, &token) in tokens.iter().enumerate() {
+        last = serial_row(model, token, i + 1 == tokens.len())?;
+    }
+    last.ok_or(Error::Invalid("T2 empty prompt"))
+}
+
+fn gpu_seconds() -> f64 {
+    profile::snapshot().get("native.metal.gpu").map_or(0.0, |c| c.seconds)
+}
+
+fn median(values: &[f64]) -> Result<f64> {
+    if values.is_empty() || values.iter().any(|v| !v.is_finite() || *v < 0.0) {
+        return Err(Error::Invalid("T2 missing timings"));
+    }
+    let mut sorted = values.to_vec();
+    sorted.sort_by(f64::total_cmp);
+    let mid = sorted.len() / 2;
+    Ok(if sorted.len().is_multiple_of(2) {
+        (sorted[mid - 1] + sorted[mid]) * 0.5
+    } else {
+        sorted[mid]
+    })
+}
+
+fn probe() -> Result<Value> {
+    let mut bytes = Vec::new();
+    std::io::stdin().take(128 * 1024 + 1).read_to_end(&mut bytes)?;
+    if bytes.len() > 128 * 1024 {
+        return Err(Error::Invalid("T2 stdin bound"));
+    }
+    let request: Request = serde_json::from_slice(&bytes).map_err(|_| Error::Invalid("T2 stdin schema"))?;
+    if request.schema_version != 1
+        || request.cases.len() != 3
+        || request.continuation_tokens != 8
+        || request.rounds != 4
+        || request.context_tokens != 256
+        || request.corpus_sha256.len() != 64
+        || !request.corpus_sha256.bytes().all(|b| b.is_ascii_hexdigit())
+        || request.cases.iter().any(|c| !(12..=128).contains(&c.input_token_ids.len()))
+    {
+        return Err(Error::Invalid("T2 stdin admission"));
+    }
+    let ids = request.cases.iter().map(|c| &c.input_token_ids).collect::<Vec<_>>();
+    if format!("{:x}", Sha256::digest(serde_json::to_vec(&ids).map_err(|_| Error::Invalid("T2 stdin schema"))?))
+        != request.corpus_sha256
+    {
+        return Err(Error::Invalid("T2 stdin admission"));
+    }
+    for name in [
+        "STARK_GLM53_ENCODER_BANKS",
+        "STARK_GLM53_RESIDENT_BANKS",
+        "STARK_GLM53_WIDE_ENCODER",
+        "STARK_GLM53_GPU_GREEDY",
+        "STARK_GLM53_DECODE_GRAPH",
+    ] {
+        if std::env::var_os(name).is_none_or(|v| v != "1") {
+            return Err(Error::Invalid("T2 policy"));
+        }
+    }
+    for name in [
+        "STARK_GLM53_GREEDY_OVERLAP",
+        "STARK_GLM53_PREFILL_MMA",
+        "STARK_GLM53_SCRATCH_HEAP",
+        "STARK_GLM53_PARALLEL_PROJECTIONS",
+        "STARK_GLM53_CONCURRENT_ENCODER",
+        "STARK_GLM53_PACKED_FAST_MATH",
+    ] {
+        if std::env::var_os(name).is_some_and(|v| v == "1") {
+            return Err(Error::Invalid("T2 policy"));
+        }
+    }
+    let path =
+        PathBuf::from(std::env::var_os("STARK_GLM53_T2_PROBE_MODEL_PATH").ok_or(Error::Invalid("T2 model path"))?);
+    let config: Value = serde_json::from_slice(&std::fs::read(path.join("config.json"))?)
+        .map_err(|_| Error::Invalid("T2 model config"))?;
+    let source: Value = serde_json::from_slice(&std::fs::read(path.join("native-source.json"))?)
+        .map_err(|_| Error::Invalid("T2 model provenance"))?;
+    if source["architecture"].as_str() != Some("glm5_next")
+        || source["weights_source"]["revision"].as_str() != Some("a38483c8cd5df544f53d70fb281afe97369d5ab6")
+        || source["metadata_source"]["revision"].as_str() != Some("04c4e9e95c5da8862dced7e5056455116f83a7e0")
+    {
+        return Err(Error::Invalid("T2 model provenance"));
+    }
+    let mut model = GlmModel::new(Weights::open(&path)?, &config)?;
+    if model.config.hidden != 4096
+        || model.config.hc != 4
+        || model.config.layer_types.len() != 45
+        || model.config.index_pool != 4
+        || !model.decode_graph_enabled
+        || request.cases.iter().any(|c| {
+            c.input_token_ids.iter().any(|&t| t as usize >= model.config.vocab)
+                || c.input_token_ids.len() + request.continuation_tokens + 1 > request.context_tokens
+        })
+    {
+        return Err(Error::Invalid("T2 model geometry"));
+    }
+    model.decode = Some(MetalDecode::new(&model.weights, &model.config, model.hyper_connections.as_deref())?);
+    // Match production ownership; no duplicate CPU mHC weight retention.
+    model.hyper_connections = None;
+    let generation: Value = serde_json::from_slice(&std::fs::read(path.join("generation_config.json"))?)
+        .map_err(|_| Error::Invalid("T2 generation config"))?;
+    let eos = match &generation["eos_token_id"] {
+        Value::Number(n) => {
+            vec![n.as_u64().and_then(|n| u32::try_from(n).ok()).ok_or(Error::Invalid("T2 EOS config"))?]
+        },
+        Value::Array(values) => values
+            .iter()
+            .map(|v| v.as_u64().and_then(|n| u32::try_from(n).ok()).ok_or(Error::Invalid("T2 EOS config")))
+            .collect::<Result<Vec<_>>>()?,
+        _ => return Err(Error::Invalid("T2 EOS config")),
+    };
+    if eos.is_empty() || eos.iter().any(|&n| n as usize >= model.config.vocab) {
+        return Err(Error::Invalid("T2 EOS config"));
+    }
+    profile::enable(true);
+    profile::reset();
+    let mut memory = Memory::default();
+    memory.observe(&model)?;
+
+    // Gate the serial tap against the ordinary API before using it as a hidden
+    // reference. The ordinary API alone has no hidden-row return contract.
+    let initial = &request.cases[0].input_token_ids;
+    let mut tap_rows = Vec::with_capacity(8);
+    for &token in &initial[..8] {
+        tap_rows.push(serial_row(&mut model, token, true)?.ok_or(Error::Invalid("T2 tap"))?);
+    }
+    model.reset();
+    for (&token, expected) in initial[..8].iter().zip(&tap_rows) {
+        let actual = model.step(token)?;
+        if !same(&actual, &expected.logits) || choice(&actual)? != expected.choice {
+            return Err(Error::Invalid("T2 ordinary serial tap parity"));
+        }
+    }
+    drop(tap_rows);
+
+    // Every residue modulo the four-row MLA pool is tested explicitly. This
+    // catches pairs crossing compression boundaries after either row.
+    let mut pooled_pairs = 0usize;
+    for length in 8..12 {
+        let first = prefill(&mut model, &initial[..length])?.choice;
+        let first_ref = serial_row(&mut model, first, true)?.ok_or(Error::Invalid("T2 tap"))?;
+        let second = first_ref.choice;
+        let second_ref = serial_row(&mut model, second, true)?.ok_or(Error::Invalid("T2 tap"))?;
+        prefill(&mut model, &initial[..length])?;
+        let actual = pair_rows(&mut model, &[first, second])?;
+        compare_rows(&actual[0], &first_ref)?;
+        compare_rows(&actual[1], &second_ref)?;
+        pooled_pairs += 1;
+        memory.observe(&model)?;
+    }
+
+    let mut references = Vec::with_capacity(request.cases.len());
+    let mut continuation_hash = Sha256::new();
+    for case in &request.cases {
+        let mut pending = prefill(&mut model, &case.input_token_ids)?.choice;
+        let mut reference = Reference {
+            inputs: Vec::new(),
+            rows: Vec::new(),
+        };
+        for _ in 0..request.continuation_tokens {
+            // This fixed-length component protocol is qualified only when all
+            // eight authoritative rows precede EOS; never force generation
+            // past an ordinary stopping point to fill a favorable cost sample.
+            if eos.contains(&pending) {
+                return Err(Error::Invalid("T2 early EOS"));
+            }
+            reference.inputs.push(pending);
+            continuation_hash.update(pending.to_le_bytes());
+            let row = serial_row(&mut model, pending, true)?.ok_or(Error::Invalid("T2 tap"))?;
+            pending = row.choice;
+            reference.rows.push(row);
+        }
+        references.push(reference);
+    }
+
+    let mut serial_wall = Vec::new();
+    let mut pair_wall = Vec::new();
+    let mut serial_gpu = Vec::new();
+    let mut pair_gpu = Vec::new();
+    let mut compared_rows = 0usize;
+    let mut warm_static_state = None;
+    // First round warms the exact pair schedule; remaining rounds alternate
+    // schedule order. Reset/prompt replay/parity comparisons are outside cost.
+    for round in 0..request.rounds {
+        for (case, reference) in request.cases.iter().zip(&references) {
+            for paired in if round.is_multiple_of(2) {
+                [false, true]
+            } else {
+                [true, false]
+            } {
+                prefill(&mut model, &case.input_token_ids)?;
+                for (inputs, expected) in reference.inputs.chunks_exact(2).zip(reference.rows.chunks_exact(2)) {
+                    memory.observe(&model)?;
+                    let gpu_before = gpu_seconds();
+                    let started = Instant::now();
+                    let actual = if paired {
+                        pair_rows(&mut model, inputs)?
+                    } else {
+                        vec![
+                            serial_row(&mut model, inputs[0], true)?.ok_or(Error::Invalid("T2 tap"))?,
+                            serial_row(&mut model, inputs[1], true)?.ok_or(Error::Invalid("T2 tap"))?,
+                        ]
+                    };
+                    let wall_ms = started.elapsed().as_secs_f64() * 1000.0;
+                    let gpu_ms = (gpu_seconds() - gpu_before) * 1000.0;
+                    for (actual, expected) in actual.iter().zip(expected) {
+                        compare_rows(actual, expected)?;
+                    }
+                    compared_rows += 2;
+                    memory.observe(&model)?;
+                    if round > 0 {
+                        if paired {
+                            pair_wall.push(wall_ms);
+                            pair_gpu.push(gpu_ms);
+                        } else {
+                            serial_wall.push(wall_ms);
+                            serial_gpu.push(gpu_ms);
+                        }
+                    }
+                }
+            }
+        }
+        let current = model.weights.t2_probe_accounting()?;
+        let static_state = (current[3], current[4]);
+        if round == 0 {
+            warm_static_state = Some(static_state);
+        } else if warm_static_state != Some(static_state) {
+            return Err(Error::Invalid("T2 static cache growth after warmup"));
+        }
+    }
+    memory.observe(&model)?;
+    let counters = profile::snapshot();
+    if counters.contains_key("native.glm.prefill.q5_mma") || counters.contains_key("native.glm.prefill.q6_mma") {
+        return Err(Error::Invalid("T2 unexpected MMA"));
+    }
+    model.reset();
+    profile::enable(false);
+    Ok(serde_json::json!({"glm_t2_probe_result":true,"aggregate":{
+        "status":"target_pair_component_complete_no_rollback", "precision":"existing_safe_f32_legacy_projections",
+        "counts":{"cases":request.cases.len(),"continuation_rows_per_case":request.continuation_tokens,
+            "rounds":request.rounds,"warmup_rounds":1,"ordinary_serial_alignment_rows":8,
+            "pooled_alignment_pairs":pooled_pairs,"pool_residues_tested":4,"complete_rows_compared":compared_rows,
+            "measured_serial_pairs":serial_wall.len(),"measured_layer_major_pairs":pair_wall.len(),"rollback_calls":0},
+        "timing_ms":{"serial_two_wall_total":serial_wall.iter().sum::<f64>(),"layer_major_two_wall_total":pair_wall.iter().sum::<f64>(),
+            "serial_two_gpu_total":serial_gpu.iter().sum::<f64>(),"layer_major_two_gpu_total":pair_gpu.iter().sum::<f64>(),
+            "serial_two_wall_median":median(&serial_wall)?,"layer_major_two_wall_median":median(&pair_wall)?,
+            "serial_two_gpu_median":median(&serial_gpu)?,"layer_major_two_gpu_median":median(&pair_gpu)?},
+        "memory_gauges":memory, "hashes":{"corpus_sha256":request.corpus_sha256,
+            "authoritative_continuation_sha256":format!("{:x}",continuation_hash.finalize())},
+        "target_reserved_context_tokens":model.config.max_context
+    }}))
+}
+
+#[stark_test]
+#[ignore]
+fn glm_t2_verification_probe() {
+    match objc2::rc::autoreleasepool(|_| probe()) {
+        Ok(aggregate) => println!("{aggregate}"),
+        Err(error) => {
+            profile::enable(false);
+            let guard = match error {
+                Error::Invalid("T2 stdin bound") => "stdin_bound",
+                Error::Invalid("T2 stdin schema") => "stdin_schema",
+                Error::Invalid("T2 stdin admission") => "stdin_admission",
+                Error::Invalid("T2 policy" | "T2 serial policy" | "T2 pair policy" | "T2 unexpected MMA") => {
+                    "target_policy"
+                },
+                Error::Invalid(code) if code.contains("parity") || code.contains("tap") => "alignment_parity",
+                Error::Invalid(code)
+                    if code.contains("cap")
+                        || code.contains("residency")
+                        || code.contains("memory")
+                        || code.contains("alloc")
+                        || code.contains("static cache") =>
+                {
+                    "memory_gate"
+                },
+                Error::Io(_) => "model_load",
+                _ => "probe_rejected",
+            };
+            println!(
+                "{}",
+                serde_json::json!({"glm_t2_probe_result":true,"aggregate":{
+                    "status":"rejected","rows":{"failure":{"guard":guard}}
+                }})
+            );
+            panic!("T2 aggregate probe failed; no private values are reported");
+        },
+    }
+}
