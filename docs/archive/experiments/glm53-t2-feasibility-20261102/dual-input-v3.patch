@@ -0,0 +1,320 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Exact-order dual-input components against two admitted Safe scalar calls.
+
+use stark_engine_macros::stark_test;
+
+use super::*;
+
+fn dual_pipeline(kind: u32) -> Result<PipelineState> {
+    crate::engine::hybrid::weight_metal::decode_graph::dual_input::pipeline(kind)
+}
+
+fn encode_dual(
+    encoder: &ProtocolObject<dyn MTLComputeCommandEncoder>,
+    shape: Shape,
+    codes: &ProtocolObject<dyn MTLBuffer>,
+    input: &ProtocolObject<dyn MTLBuffer>,
+    output: &ProtocolObject<dyn MTLBuffer>,
+    offsets: [usize; 3],
+) -> Result<()> {
+    validate_views(shape, codes, input, output, offsets)?;
+    if shape.tokens != 2 {
+        return Err(Error::Invalid("dual component input count"));
+    }
+    let pipeline = dual_pipeline(shape.kind)?;
+    encoder.set_compute_pipeline_state(&pipeline);
+    encoder.set_buffer(Some(codes), 0, 0);
+    encoder.set_buffer(Some(input), offsets[1] * 4, 1);
+    encoder.set_buffer(Some(output), offsets[2] * 4, 2);
+    let p = [
+        shape.rows as u32,
+        shape.columns as u32,
+        shape.kind,
+        256,
+        weights::block_layout(shape.kind)?.1 as u32,
+        0,
+        0,
+        0,
+    ];
+    let packed_offsets = [offsets[0] as u32, 0, 0, 0];
+    encoder.set_bytes(NonNull::from(&p).cast(), std::mem::size_of_val(&p), 3);
+    encoder.set_bytes(NonNull::from(&packed_offsets).cast(), std::mem::size_of_val(&packed_offsets), 6);
+    encoder.dispatch_threadgroups(
+        MTLSize {
+            width: shape.rows.div_ceil(if shape.kind == 13 {
+                2
+            } else {
+                4
+            }),
+            height: 1,
+            depth: 1,
+        },
+        MTLSize {
+            width: 64,
+            height: 1,
+            depth: 1,
+        },
+    );
+    Ok(())
+}
+
+fn run_dual(
+    shape: Shape,
+    codes: &[u8],
+    input: &[f32],
+    offsets: [usize; 3],
+) -> Result<Vec<f32>> {
+    shape.sizes()?;
+    if shape.tokens != 2 || codes.len() != shape.sizes()?.1 || input.len() != 2 * shape.columns {
+        return Err(Error::Invalid("dual component payload"));
+    }
+    objc2::rc::autoreleasepool(|_| {
+        let executor = executor()?;
+        let mut storage = vec![0xa7; offsets[0]];
+        storage.extend_from_slice(codes);
+        storage.extend_from_slice(&[0x4d; 19]);
+        let codes = buffer(executor, &storage)?;
+        let mut values = vec![f32::NAN; offsets[1]];
+        values.extend_from_slice(input);
+        values.extend_from_slice(&[f32::NAN; 3]);
+        let input = buffer(executor, bytemuck::cast_slice(&values))?;
+        let count = 2 * shape.rows;
+        let output = buffer(executor, bytemuck::cast_slice(&vec![7.25f32; offsets[2] + count + 3]))?;
+        let command = executor.queue.command_buffer().ok_or(Error::Invalid("dual component command"))?;
+        let encoder = command.compute_command_encoder().ok_or(Error::Invalid("dual component encoder"))?;
+        encode_dual(&encoder, shape, &codes, &input, &output, offsets)?;
+        encoder.end_encoding();
+        command.commit();
+        command.wait_until_completed();
+        if command.status() != MTLCommandBufferStatus::Completed {
+            return Err(Error::Invalid("dual component execution"));
+        }
+        let values =
+            unsafe { std::slice::from_raw_parts(output.contents().as_ptr().cast::<f32>(), offsets[2] + count + 3) };
+        assert!(
+            values[..offsets[2]].iter().chain(&values[offsets[2] + count..]).all(|&v| v == 7.25),
+            "dual component output tail changed"
+        );
+        if values[offsets[2]..offsets[2] + count].iter().any(|v| !v.is_finite()) {
+            return Err(Error::Invalid("dual component nonfinite result"));
+        }
+        Ok(values[offsets[2]..offsets[2] + count].to_vec())
+    })
+}
+
+fn exact(
+    actual: &[f32],
+    expected: &[f32],
+) -> bool {
+    actual.len() == expected.len() && actual.iter().zip(expected).all(|(a, b)| a.to_bits() == b.to_bits())
+}
+
+#[stark_test]
+fn kquant_dual_input_basis_offsets_tails_and_source_f64() {
+    for kind in [13, 14] {
+        for (rows, columns) in [(1, 256), (3, 768), (5, 4096), (17, 8192)] {
+            let shape = Shape {
+                kind,
+                rows,
+                columns,
+                tokens: 2,
+            };
+            let codes = finite_codes(kind, rows, columns, rows + columns + kind as usize);
+            let mut dense = (0..2 * columns).map(|i| ((i * 31 % 149) as f32 - 74.0) * 0.0078125).collect::<Vec<_>>();
+            for (case, at) in [0, 15, 16, 31, 32, 63, 127, 128, 255, columns - 1].into_iter().enumerate() {
+                let mut basis = vec![0.0; 2 * columns];
+                basis[at] = 1.0;
+                basis[columns + (columns - 1 - at)] = -0.5;
+                for values in [&basis, &dense] {
+                    let source = run(shape, &codes, values, false).unwrap();
+                    for offsets in [[0, 0, 0], [1, 1, 1], [19, 3, 3]] {
+                        let actual = run_dual(shape, &codes, values, offsets).unwrap();
+                        assert!(exact(&actual, &source), "dual input changed admitted scalar bits");
+                        let (rrms, normalized, _) = numerical_errors(shape, &codes, values, &actual, &source, 16);
+                        assert!(rrms == 0.0 && normalized <= 2e-6, "dual input source/F64 gate failed");
+                    }
+                }
+                dense[(case * 43) % columns] *= -1.0;
+            }
+        }
+    }
+}
+
+#[stark_test]
+fn kquant_dual_input_independent_fallback_cancellation_and_subnormals() {
+    for kind in [13, 14] {
+        let shape = Shape {
+            kind,
+            rows: 17,
+            columns: 4096,
+            tokens: 2,
+        };
+        let codes = finite_codes(kind, shape.rows, shape.columns, 773 + kind as usize);
+        let bounded = (0..shape.columns)
+            .map(|i| {
+                let value = (1.0 + (i % 7) as f32 * f32::EPSILON)
+                    * if i % 2 == 0 {
+                        1.0
+                    } else {
+                        -1.0
+                    };
+                if i % 19 == 0 {
+                    value * 1.0e10
+                } else {
+                    value
+                }
+            })
+            .collect::<Vec<_>>();
+        let extreme = (0..shape.columns)
+            .map(|i| {
+                if i % 3 == 0 {
+                    1.0e21
+                } else {
+                    -3.0e20
+                }
+            })
+            .collect::<Vec<_>>();
+        let subnormal = (0..shape.columns).map(|i| f32::from_bits(1 + (i % 127) as u32)).collect::<Vec<_>>();
+        for (first, second) in
+            [(&extreme, &bounded), (&bounded, &extreme), (&bounded, &subnormal), (&subnormal, &bounded)]
+        {
+            let values = [first.as_slice(), second.as_slice()].concat();
+            let source = run(shape, &codes, &values, false).unwrap();
+            let actual = run_dual(shape, &codes, &values, [19, 3, 3]).unwrap();
+            assert!(exact(&actual, &source), "one dual input changed its neighbor's fallback or reduction bits");
+            let (rrms, normalized, _) = numerical_errors(shape, &codes, &values, &actual, &source, 16);
+            assert!(rrms == 0.0 && normalized <= 2e-6, "dual input mixed source/F64 gate failed");
+        }
+        // Zero-valued encoded weights must retain original-block behavior for
+        // MAX inputs. Factored intermediate input sums can overflow even when
+        // the original per-weight products are all exactly zero.
+        let mut zero = vec![0u8; weights::block_layout(kind).unwrap().1];
+        if kind == 14 {
+            zero[128..192].fill(0xaa);
+            zero[192..208].fill(1);
+            zero[208..210].copy_from_slice(&half::f16::from_f32(2.0).to_bits().to_le_bytes());
+        } else {
+            zero[..2].copy_from_slice(&half::f16::from_f32(2.0).to_bits().to_le_bytes());
+            zero[4..16].fill(1);
+        }
+        let zero = zero.repeat(shape.rows * shape.columns / 256);
+        let maximum = vec![f32::MAX; shape.columns];
+        for (first, second) in [(&maximum, &bounded), (&bounded, &maximum)] {
+            let values = [first.as_slice(), second.as_slice()].concat();
+            let source = run(shape, &zero, &values, false).unwrap();
+            let actual = run_dual(shape, &zero, &values, [19, 3, 3]).unwrap();
+            assert!(
+                exact(&actual, &source) && actual.iter().all(|&v| v == 0.0),
+                "dual zero times MAX fallback changed original bits"
+            );
+        }
+    }
+}
+
+fn operation(
+    shape: Shape,
+    codes: &[u8],
+) -> MappedOperation<'static> {
+    let mut encoded = vec![0xa7; 19];
+    encoded.extend_from_slice(codes);
+    encoded.extend_from_slice(&[0xa7; 19]);
+    MappedOperation {
+        matrices: vec![MappedMatrix {
+            codes: MappedSlice {
+                buffer: buffer(executor().unwrap(), &encoded).unwrap(),
+                offset: 19,
+                length: codes.len(),
+                registered_length: encoded.len(),
+            },
+            planes: None,
+        }],
+        inputs: &[],
+        rows: shape.rows,
+        columns: shape.columns,
+        rows_per_batch: 0,
+        format: MatrixFormat::Packed(shape.kind),
+    }
+}
+
+#[stark_test]
+fn kquant_dual_input_actual_shapes_dispatch_and_failure_gates() {
+    for kind in [13, 14] {
+        for (rows, columns) in [(8192, 4096), (4096, 8192)] {
+            let shape = Shape {
+                kind,
+                rows,
+                columns,
+                tokens: 2,
+            };
+            let codes = finite_codes(kind, rows, columns, rows + columns + kind as usize);
+            let inputs = (0..2 * columns).map(|i| ((i * 17 % 113) as f32 - 56.0) * 0.015625).collect::<Vec<_>>();
+            let source = run(shape, &codes, &inputs, false).unwrap();
+            let direct = run_dual(shape, &codes, &inputs, [19, 3, 3]).unwrap();
+            assert!(exact(&direct, &source), "actual-shape dual kernel changed scalar bits");
+            let (rrms, normalized, _) = numerical_errors(shape, &codes, &inputs, &direct, &source, 16);
+            assert!(rrms == 0.0 && normalized <= 2e-6, "actual dual source/F64 gate failed");
+            let operation = operation(shape, &codes);
+            let qualified = executor().unwrap().device.name() == "Apple M5 Max"
+                && if kind == 13 {
+                    q5_grouped32_shape(operation.format, columns)
+                } else {
+                    q6_grouped16_shape(operation.format, columns)
+                };
+            let counter = if kind == 13 {
+                "native.glm.t2.dual_input.q5"
+            } else {
+                "native.glm.t2.dual_input.q6"
+            };
+            let previous = profile::enabled();
+            profile::enable(true);
+            let before = profile::snapshot().get(counter).map_or(0, |c| c.calls);
+            let mut graph = DecodeGraph::new().unwrap();
+            let input = graph.upload_into(&inputs).unwrap();
+            let output = graph.scratch(2 * rows).unwrap();
+            let encoded = graph.mapped_exact_dual_input(&operation, &input, &output, 2).unwrap();
+            assert_eq!(encoded, qualified, "dual runtime admission changed");
+            if !encoded {
+                profile::enable(previous);
+                continue;
+            }
+            let actual = graph.finish(&[output]).unwrap().remove(0);
+            assert!(exact(&actual, &source), "dual runtime changed scalar bits");
+            let after = profile::snapshot().get(counter).map_or(0, |c| c.calls);
+            profile::enable(previous);
+            assert_eq!(after - before, 1, "dual runtime dispatch counter missing");
+
+            for token in 0..2 {
+                for poison in [f32::NAN, f32::INFINITY, f32::NEG_INFINITY] {
+                    let mut bad = inputs.clone();
+                    bad[token * columns + 255] = poison;
+                    let mut graph = DecodeGraph::new().unwrap();
+                    let input = DeviceVector {
+                        buffer: buffer(executor().unwrap(), bytemuck::cast_slice(&bad)).unwrap(),
+                        offset: 0,
+                        len: bad.len(),
+                    };
+                    let output = graph.scratch(2 * rows).unwrap();
+                    assert!(graph.mapped_exact_dual_input(&operation, &input, &output, 2).unwrap());
+                    assert!(graph.finish(&[output]).is_err(), "dual runtime concealed nonfinite input");
+                }
+            }
+            let maximum = vec![f32::MAX; 2 * columns];
+            assert!(run(shape, &codes, &maximum, false).is_err(), "scalar overflow fixture must reject");
+            let mut graph = DecodeGraph::new().unwrap();
+            let input = graph.upload_into(&maximum).unwrap();
+            let output = graph.scratch(2 * rows).unwrap();
+            assert!(graph.mapped_exact_dual_input(&operation, &input, &output, 2).unwrap());
+            assert!(graph.finish(&[output]).is_err(), "dual runtime concealed finite-input overflow");
+            let mut graph = DecodeGraph::new().unwrap();
+            let input = graph.upload_into(&inputs).unwrap();
+            let output = graph.scratch(2 * rows).unwrap();
+            assert!(!graph.mapped_exact_dual_input(&operation, &input, &output, 1).unwrap(), "dual admitted one input");
+            let mut unsupported = operation;
+            unsupported.rows_per_batch = 1;
+            assert!(
+                !graph.mapped_exact_dual_input(&unsupported, &input, &output, 2).unwrap(),
+                "dual admitted indexed grouping"
+            );
+        }
+    }
+}
