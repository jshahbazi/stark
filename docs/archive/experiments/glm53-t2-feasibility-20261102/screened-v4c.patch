+"""Private V4 same-process ABBA pair probe; raw native/host rows stay in RAM.
+
+Initial full/compact target gates run before screened pair intervals. Each
+interval follows a replayed, drained prefix and unchanged ten-second admission.
+Monitor phases may extend into idle catch-up; native timing never includes it.
+This measures prepared-model pair latency, not sustained decode or MTP gain.
+"""
+
+from __future__ import annotations
+
+import argparse
+import contextlib
+import hashlib
+import importlib
+import io
+import json
+import math
+import os
+from pathlib import Path
+import queue
+import re
+import signal
+import statistics
+import subprocess
+import sys
+import threading
+import time
+
+import probe_glm53_t2 as legacy
+
+SCOPE = "glm53_t2_same_loaded_screened_abba_v4"
+POSITIONS = ((0, 0), (0, 1), (0, 2), (0, 3), (1, 0), (2, 0))
+MODES = (False, True, True, False)
+MAX_ATTEMPTS = 3
+MAX_SAMPLES = len(POSITIONS) * MAX_ATTEMPTS * len(MODES)
+PER_PAIR = (68, 1_568_669_696, 68, 1_871_708_160)
+HELPERS = ("benchmark_clean_qwen.py", "benchmark_glm_mlx_serve.py", "benchmark_stock_engines.py")
+SENTINEL = b'"glm_t2_screened_event"'
+FAILURES = {"arguments", "source_guard", "helper_guard", "binary_guard", "execution_policy",
+    "model_guard", "tokenization", "native_launch", "native_output", "native_timeout", "native_exit",
+    "native_protocol", "native_validation", "native_coverage", "native_memory", "monitor_health",
+    "deadline", "driver"}
+
+
+class Failure(Exception):
+    def __init__(self, stage):
+        assert stage in FAILURES
+        self.stage = stage
+        super().__init__(stage)
+
+
+def require(condition, stage="native_protocol"):
+    if not condition:
+        raise Failure(stage)
+
+
+def uint(value, maximum=2**64 - 1):
+    return type(value) is int and 0 <= value <= maximum
+
+
+def finite(value):
+    return type(value) in (float, int) and math.isfinite(value) and value > 0
+
+
+@contextlib.contextmanager
+def session_deadline(seconds):
+    """Interrupt blocking admission/pipe calls; leave bounded cleanup outside."""
+    require(threading.current_thread() is threading.main_thread()
+        and signal.getitimer(signal.ITIMER_REAL) == (0.0, 0.0), "arguments")
+    previous = signal.getsignal(signal.SIGALRM)
+    def expired(_number, _frame):
+        raise Failure("deadline")
+    signal.signal(signal.SIGALRM, expired)
+    signal.setitimer(signal.ITIMER_REAL, seconds)
+    try:
+        yield
+    finally:
+        signal.setitimer(signal.ITIMER_REAL, 0)
+        signal.signal(signal.SIGALRM, previous)
+
+
+def strict_json(raw):
+    def object_pairs(pairs):
+        result = {}
+        for key, value in pairs:
+            require(key not in result)
+            result[key] = value
+        return result
+    try:
+        return json.loads(raw, object_pairs_hook=object_pairs,
+            parse_constant=lambda _: (_ for _ in ()).throw(Failure("native_protocol")))
+    except Failure:
+        raise
+    except BaseException:
+        raise Failure("native_protocol") from None
+
+
+def parse_event(line):
+    if len(line) > 256 * 1024:
+        raise Failure("native_output")
+    raw = line.strip()
+    if SENTINEL not in raw:
+        if legacy.SENTINEL in raw:
+            raise Failure("native_validation")
+        return None
+    if not raw.startswith(b"{"):
+        framing = re.fullmatch(rb"test " + re.escape(legacy.TEST_NAME) + rb" * \.\.\. (\{.*\})", raw)
+        require(framing is not None)
+        raw = framing.group(1)
+    value = strict_json(raw)
+    require(isinstance(value, dict) and set(value) == {"glm_t2_screened_event", "schema_version", "event", "payload"})
+    require(value["glm_t2_screened_event"] is True and type(value["schema_version"]) is int and value["schema_version"] == 4)
+    require(value["event"] in {"validated", "prepared", "sample", "cancelled", "decided", "finished"})
+    require(isinstance(value["payload"], dict))
+    return value
+
+
+def validate_memory(value):
+    require(isinstance(value, dict) and set(value) == legacy.MEMORY_KEYS, "native_memory")
+    require(all(uint(v) for v in value.values()), "native_memory")
+    require(value["cap_bytes"] > 0 and value["observed_required_peak_bytes"] <= value["cap_bytes"]
+        and value["sampled_metal_peak_bytes"] <= value["cap_bytes"]
+        and value["graph_scratch_high_water_bytes"] <= 512 * 1024 * 1024, "native_memory")
+
+
+def validate_counters(value, graphs):
+    require(type(value) is list and len(value) == 4 and all(uint(v) for v in value), "native_coverage")
+    require(value == [per * graphs for per in PER_PAIR], "native_coverage")
+
+
+def validate_sample(payload, expected):
+    require(set(payload) == set(expected) | {"wall_ms", "gpu_ms", "compact_rows_compared", "dual_counters", "memory_gauges"})
+    require(all(type(payload[k]) is type(v) and payload[k] == v for k, v in expected.items()))
+    require(finite(payload["wall_ms"]) and finite(payload["gpu_ms"]))
+    require(type(payload["compact_rows_compared"]) is int and payload["compact_rows_compared"] == 2)
+    validate_counters(payload["dual_counters"], int(expected["dual"]))
+    validate_memory(payload["memory_gauges"])
+    return payload
+
+
+def rejection_reasons(screen):
+    keys = {"samples", "external_cpu_max", "external_model_cpu_max", "thermal_max", "compiler_active",
+        "sampling_gap", "sampling_failures", "paging_delta", "eligible"}
+    require(isinstance(screen, dict) and set(screen) == keys, "monitor_health")
+    require(uint(screen["samples"]) and screen["samples"] > 0 and uint(screen["thermal_max"])
+        and uint(screen["sampling_failures"]), "monitor_health")
+    require(all(type(screen[k]) is bool for k in ("compiler_active", "sampling_gap", "eligible")), "monitor_health")
+    require(all(type(screen[k]) in (float, int) and math.isfinite(screen[k]) and screen[k] >= 0
+        for k in ("external_cpu_max", "external_model_cpu_max")), "monitor_health")
+    paging = screen["paging_delta"]
+    require(type(paging) is dict and set(paging) == {"pageouts", "swapouts"}
+        and all(uint(v) for v in paging.values()), "monitor_health")
+    reasons = []
+    for reject, reason in ((screen["external_cpu_max"] > 150, "external_cpu"),
+        (screen["external_model_cpu_max"] > 10, "external_model_cpu"),
+        (screen["thermal_max"] > 1, "thermal"), (screen["compiler_active"], "compiler"),
+        (screen["sampling_gap"], "sampling_gap"), (bool(screen["sampling_failures"]), "sampling_failure"),
+        (bool(paging["pageouts"]), "pageouts"), (bool(paging["swapouts"]), "swapouts")):
+        if reject:
+            reasons.append(reason)
+    require(screen["eligible"] is (not reasons), "monitor_health")
+    return reasons
+
+
+def validate_admission(value):
+    require(type(value) is dict and set(value) == {"streak_seconds", "samples", "external_cpu_max",
+        "max_process_cpu", "external_model_cpu_max", "gpu_utilization_max", "thermal_max"}, "monitor_health")
+    require(all(type(v) in (int, float) and math.isfinite(v) and v >= 0 for v in value.values()), "monitor_health")
+    require(value["streak_seconds"] >= 10 and uint(value["samples"]) and value["samples"] > 0
+        and value["external_cpu_max"] <= 150 and value["max_process_cpu"] <= 80
+        and value["external_model_cpu_max"] <= 10 and value["gpu_utilization_max"] <= 5
+        and uint(value["thermal_max"]) and value["thermal_max"] <= 1, "monitor_health")
+
+
+def phase_health(monitor, phase):
+    rows = [row for row in monitor.rows if phase in row["phases"]]
+    require(bool(rows), "monitor_health")
+    gpu = [row["gpu_device_utilization_percent"] for row in rows]
+    intervals = [row["interval_seconds"] for row in rows]
+    require(all(type(v) in (int, float) and math.isfinite(v) and 0 <= v <= 100 for v in gpu)
+        and all(finite(v) for v in intervals), "monitor_health")
+    return {"samples": len(rows), "device_gpu_utilization_min": min(gpu),
+        "device_gpu_utilization_max": max(gpu), "max_interval_seconds": max(intervals)}
+
+
+class Native:
+    """Drain both pipes continuously with bounded RAM; never print pipe bytes."""
+    def __init__(self, binary, environment):
+        try:
+            self.process = subprocess.Popen([str(binary), "glm_t2_verification_probe", "--ignored", "--nocapture", "--test-threads=1"],
+                stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=environment)
+        except Failure:
+            raise
+        except BaseException:
+            raise Failure("native_launch") from None
+        self.events = queue.Queue(maxsize=8)
+        self.failed = threading.Event()
+        self.bytes = {"stdout": 0, "stderr": 0}
+        self.hashes = {key: hashlib.sha256() for key in self.bytes}
+        self.threads = [threading.Thread(target=self._read, args=(key,), daemon=True) for key in self.bytes]
+        for thread in self.threads:
+            thread.start()
+
+    def _read(self, key):
+        stream = getattr(self.process, key)
+        try:
+            while True:
+                raw = stream.readline(256 * 1024 + 1) if key == "stdout" else stream.read(16 * 1024)
+                if not raw:
+                    break
+                self.bytes[key] += len(raw)
+                self.hashes[key].update(raw)
+                if self.bytes[key] > 2 * 1024 * 1024 or (key == "stdout" and len(raw) > 256 * 1024):
+                    self.failed.set()
+                    continue
+                if key == "stdout":
+                    parsed = parse_event(raw)
+                    if parsed is not None:
+                        self.events.put(parsed, timeout=1)
+        except BaseException:
+            self.failed.set()
+
+    def send(self, value):
+        require(not self.failed.is_set(), "native_output")
+        try:
+            self.process.stdin.write((json.dumps(value, separators=(",", ":"), allow_nan=False) + "\n").encode("ascii"))
+            self.process.stdin.flush()
+        except Failure:
+            raise
+        except BaseException:
+            raise Failure("native_exit") from None
+
+    def receive(self, name, timeout):
+        deadline = time.monotonic() + timeout
+        while time.monotonic() < deadline:
+            require(not self.failed.is_set(), "native_output")
+            try:
+                event = self.events.get(timeout=min(.2, max(.001, deadline - time.monotonic())))
+                require(event["event"] == name)
+                return event["payload"]
+            except queue.Empty:
+                # Allow the pipe readers to consume a final flushed event after
+                # process exit; process status alone can race their queue put.
+                require(self.process.poll() is None or any(t.is_alive() for t in self.threads), "native_exit")
+        raise Failure("native_timeout")
+
+    def close(self, success=False):
+        if not success and self.process.poll() is None:
+            try:
+                self.send({"command": "abort"})
+            except BaseException:
+                pass
+        try:
+            self.process.stdin.close()
+        except BaseException:
+            pass
+        try:
+            self.process.wait(timeout=15)
+        except subprocess.TimeoutExpired:
+            self.process.terminate()
+            try:
+                self.process.wait(timeout=10)
+            except subprocess.TimeoutExpired:
+                self.process.kill()
+                self.process.wait(timeout=10)
+        for thread in self.threads:
+            thread.join(timeout=5)
+        return {"returncode": self.process.returncode, "stream_bytes": self.bytes,
+            "stream_sha256": {k: v.hexdigest() for k, v in self.hashes.items()},
+            "stream_reader_failed": self.failed.is_set() or any(t.is_alive() for t in self.threads),
+            "unexpected_events": not self.events.empty(), "raw_native_output_persisted": False}
+
+
+def wait_phase(monitor, phase, cursor):
+    deadline = time.monotonic() + 3
+    while time.monotonic() < deadline:
+        require(not monitor.failures, "monitor_health")
+        if any(phase in row["phases"] for row in monitor.rows[cursor:]):
+            return
+        time.sleep(.05)
+    raise Failure("monitor_health")
+
+
+def source_guard(root, freeze_path, expected):
+    require(legacy.sha256_file(freeze_path) == expected, "source_guard")
+    freeze = strict_json(freeze_path.read_bytes())
+    files = freeze.get("source_files")
+    require(type(files) is dict and 13 <= len(files) <= 24, "source_guard")
+    for name, record in files.items():
+        path = Path(name)
+        require(not path.is_absolute() and ".." not in path.parts and type(record) is dict
+            and set(record) == {"bytes", "sha256"}, "source_guard")
+        actual = root / path
+        require(actual.is_file() and actual.stat().st_size == record["bytes"]
+            and legacy.sha256_file(actual) == record["sha256"], "source_guard")
+    return freeze
+
+
+def helper_guard(directory, pins):
+    require(type(pins) is dict and set(pins) == set(HELPERS), "helper_guard")
+    require(all(legacy.sha256_file(directory / name) == value for name, value in pins.items()), "helper_guard")
+
+
+def grouped_comparison(attempts):
+    accepted = [a for a in attempts if a["accepted"]]
+    require(all(len(a["samples"]) == 4 for a in accepted))
+    comparisons = []
+    for block in accepted:
+        row = {"block": block["block"], "attempt": block["attempt"]}
+        for clock in ("wall_ms", "gpu_ms"):
+            values = [sample["native"][clock] for sample in block["samples"]]
+            row[clock] = {"A_mean": (values[0] + values[3]) / 2,
+                "B_mean": (values[1] + values[2]) / 2,
+                "B_over_A": (values[1] + values[2]) / (values[0] + values[3])}
+        comparisons.append(row)
+    summary = {"accepted_blocks": len(accepted), "accepted_samples": 4 * len(accepted), "paired_blocks": comparisons}
+    for clock in ("wall_ms", "gpu_ms"):
+        a = [s["native"][clock] for block in accepted for s in block["samples"] if not s["native"]["dual"]]
+        b = [s["native"][clock] for block in accepted for s in block["samples"] if s["native"]["dual"]]
+        if a:
+            summary[clock] = {"A_mean": statistics.mean(a), "B_mean": statistics.mean(b),
+                "A_median": statistics.median(a), "B_median": statistics.median(b),
+                "mean_block_B_over_A": statistics.mean(row[clock]["B_over_A"] for row in comparisons),
+                "median_block_B_over_A": statistics.median(row[clock]["B_over_A"] for row in comparisons)}
+    summary["performance_controls_qualified"] = len(accepted) == len(POSITIONS)
+    return summary
+
+
+def execute(args, report):
+    root = Path(__file__).resolve().parent.parent
+    model = args.model_path.resolve(strict=True)
+    binary = args.test_binary.resolve(strict=True)
+    freeze = source_guard(root, args.source_freeze, args.source_freeze_sha256)
+    helper_pins = freeze.get("screening_helper_sha256")
+    helper_guard(args.screening_scripts, helper_pins)
+    require(legacy.sha256_file(args.execution_wrapper) == freeze.get("execution_wrapper_sha256"), "helper_guard")
+    require(legacy.sha256_file(binary) == args.binary_sha256, "binary_guard")
+    selectors = legacy.execution_selectors()
+    require(selectors["STARK_GLM53_T2_DUAL_INPUT"] is True, "execution_policy")
+    # Import exact hashed helpers before inserting their directory ahead of the
+    # local V3 protocol module. The dependency has only standard-library imports.
+    sys.path.insert(0, str(args.screening_scripts.resolve()))
+    Monitor = importlib.import_module("benchmark_clean_qwen").Monitor
+    paging = importlib.import_module("benchmark_clean_qwen").paging
+    policy = importlib.import_module("benchmark_glm_mlx_serve")
+    artifacts = legacy.model_artifact_identity(model)
+    with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
+        from benchmark_hybrid import weight_identity
+        from stark_convert.chat import load_template
+        from tokenizers import Tokenizer
+        weights = weight_identity(model, args.verified_weights)
+        codec, template = load_template(model)
+        tokenizer = Tokenizer.from_file(str(model / "tokenizer.json"))
+        rendered = [template.render(messages=[{"role": "user", "content": prompt}], tools=None,
+            add_generation_prompt=True, enable_thinking=True, bos_token=codec.get("bos_token") or "",
+            eos_token=codec.get("eos_token") or "") for prompt in legacy.PROMPTS]
+        inputs = [tokenizer.encode(text, add_special_tokens=False).ids for text in rendered]
+    require(len(inputs) == 3 and all(12 <= len(ids) <= 128 for ids in inputs), "tokenization")
+    corpus = hashlib.sha256(json.dumps(inputs, separators=(",", ":")).encode("ascii")).hexdigest()
+    report.update(source_freeze_sha256=args.source_freeze_sha256, binary_sha256=args.binary_sha256,
+        driver_sha256=legacy.sha256_file(Path(__file__)), screening_helper_sha256=helper_pins,
+        execution_wrapper_sha256=freeze["execution_wrapper_sha256"],
+        execution_selectors=selectors, model_artifacts=artifacts, weights=weights, corpus_sha256=corpus)
+    env = dict(os.environ, STARK_GLM53_T2_PROBE_MODEL_PATH=str(model))
+    native = None
+    success = False
+    finished = None
+    started = time.monotonic()
+    def deadline():
+        require(time.monotonic() - started <= 1800, "deadline")
+    try:
+        with session_deadline(1800), Monitor() as monitor:
+            native = Native(binary, env)
+            native.send({"schema_version": 4, "cases": [{"input_token_ids": ids} for ids in inputs],
+                "continuation_tokens": 8, "rounds": 4, "context_tokens": 256, "corpus_sha256": corpus, "dual_input": True})
+            ready = native.receive("validated", 600)
+            require(set(ready) == {"validation", "selected_full_rows_compared", "selected_pool_residues", "initial_candidate_pair_graphs", "max_samples"})
+            validation = legacy.validate_aggregate(ready["validation"])
+            require(validation["status"] != "rejected" and validation["dual_input"]["enabled"] is True
+                and validation["hashes"]["corpus_sha256"] == corpus, "native_validation")
+            require(ready["selected_full_rows_compared"] == 12 and ready["selected_pool_residues"] == 4
+                and ready["initial_candidate_pair_graphs"] == 106 and ready["max_samples"] == MAX_SAMPLES, "native_validation")
+            report["initial_validation"] = ready
+            sample_id, candidate_graphs, completed, cancelled = 0, 0, 0, 0
+            for block, (case, pair) in enumerate(POSITIONS):
+                for attempt in range(1, MAX_ATTEMPTS + 1):
+                    entry = {"block": block, "attempt": attempt, "case": case, "pair": pair, "accepted": False, "samples": []}
+                    report["attempts"].append(entry)
+                    for slot, dual in enumerate(MODES):
+                        deadline()
+                        sample_id += 1
+                        expected = {"sample": sample_id, "block": block, "attempt": attempt, "slot": slot, "case": case, "pair": pair, "dual": dual}
+                        native.send({"command": "prepare", **expected})
+                        prepared = native.receive("prepared", 30)
+                        require(set(prepared) == set(expected) | {"pool_residue"}
+                            and all(type(prepared[k]) is type(v) and prepared[k] == v for k, v in expected.items())
+                            and uint(prepared["pool_residue"], 3)
+                            and prepared["pool_residue"] == (len(inputs[case]) + pair) % 4)
+                        record = {"sample": sample_id, "pool_residue": prepared["pool_residue"], "eligible": False, "reasons": []}
+                        entry["samples"].append(record)
+                        try:
+                            admission = policy.quiet_admission(monitor)
+                        except Failure:
+                            raise
+                        except TimeoutError:
+                            record["reasons"] = ["quiet_admission_timeout"]
+                            native.send({"command": "cancel", "sample": sample_id})
+                            require(native.receive("cancelled", 5) == {"sample": sample_id})
+                            cancelled += 1
+                            deadline()
+                            continue
+                        except BaseException:
+                            raise Failure("monitor_health") from None
+                        validate_admission(admission)
+                        record["admission"] = admission
+                        deadline()
+                        phase = f"pair_{sample_id}"
+                        cursor = len(monitor.rows)
+                        monitor.set_phase(phase)
+                        before = paging()
+                        native.send({"command": "continue", "sample": sample_id})
+                        sample = validate_sample(native.receive("sample", 10), expected)
+                        after = paging()
+                        completed += 1
+                        candidate_graphs += int(dual)
+                        record["native"] = sample
+                        wait_phase(monitor, phase, cursor)
+                        screen = policy.screen_attempt(monitor, phase, before, after)
+                        record["host_screen"] = screen
+                        record["host_health"] = phase_health(monitor, phase)
+                        record["reasons"] = rejection_reasons(screen)
+                        record["eligible"] = screen["eligible"]
+                    entry["accepted"] = all(s["eligible"] for s in entry["samples"])
+                    native.send({"command": "decide", "block": block, "attempt": attempt, "accepted": entry["accepted"]})
+                    require(native.receive("decided", 5) == {"block": block, "attempt": attempt, "accepted": entry["accepted"]})
+                    if entry["accepted"]:
+                        break
+            native.send({"command": "finish"})
+            finished = native.receive("finished", 10)
+            require(set(finished) == {"prepared_samples", "completed_samples", "cancelled_samples", "accepted_blocks",
+                "initial_candidate_pair_graphs", "candidate_sample_pair_graphs", "dual_counters", "memory_gauges", "rollback_calls"})
+            expected_counts = {"prepared_samples": sample_id, "completed_samples": completed, "cancelled_samples": cancelled,
+                "accepted_blocks": sum(a["accepted"] for a in report["attempts"]), "initial_candidate_pair_graphs": 106,
+                "candidate_sample_pair_graphs": candidate_graphs, "rollback_calls": 0}
+            require(all(type(finished[k]) is int and finished[k] == v for k, v in expected_counts.items()))
+            validate_counters(finished["dual_counters"], 106 + candidate_graphs)
+            validate_memory(finished["memory_gauges"])
+            report["native_final"] = finished
+            success = True
+        require(not monitor.failures, "monitor_health")
+        report["monitor_sampling_failures_at_exit"] = monitor.failures
+        report["comparison"] = grouped_comparison(report["attempts"])
+    finally:
+        if native is not None:
+            report["native_capture"] = native.close(success)
+        source_guard(root, args.source_freeze, args.source_freeze_sha256)
+        helper_guard(args.screening_scripts, helper_pins)
+        require(legacy.sha256_file(args.execution_wrapper) == freeze["execution_wrapper_sha256"], "helper_guard")
+        require(legacy.sha256_file(binary) == args.binary_sha256, "binary_guard")
+        require(legacy.model_artifact_identity(model) == artifacts and weight_identity(model, args.verified_weights) == weights, "model_guard")
+        report["source_helpers_binary_model_weights_unchanged"] = True
+    capture = report["native_capture"]
+    require(capture["returncode"] == 0 and not capture["stream_reader_failed"] and not capture["unexpected_events"], "native_exit")
+
+
+def private_json(path, value):
+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    with os.fdopen(fd, "w") as stream:
+        stream.write(json.dumps(value, sort_keys=True, indent=2, allow_nan=False) + "\n")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    for name in ("test-binary", "model-path", "verified-weights", "source-freeze", "screening-scripts", "execution-wrapper", "output-dir"):
+        parser.add_argument("--" + name, type=Path, required=True)
+    for name in ("binary-sha256", "source-freeze-sha256"):
+        parser.add_argument("--" + name, required=True)
+    args = parser.parse_args()
+    report = {"schema_version": 4, "scope": SCOPE, "status": "failed", "failure_stage": None, "attempts": [],
+        "prospective_plan": {"positions": POSITIONS, "modes": MODES, "max_attempts_per_block": MAX_ATTEMPTS,
+            "required_accepted_blocks": 6, "max_samples": MAX_SAMPLES, "deadline_seconds": 1800},
+        "measurement_scope": "prepared_pair_gpu_greedy_hidden_only_full_parity_untimed",
+        "screen_scope": "phase_includes_idle_catchup_paging_brackets_continue_to_sample",
+        "limits": "component_latency_only_no_MTP_head_catchup_rollback_or_full_request_gain; active_GPU_is_device_total; entire_matched_block_excluded_on_any_sample_rejection",
+        "raw_host_rows_names_pids_persisted": False}
+    created = False
+    try:
+        args.output_dir.mkdir(mode=0o700, parents=False, exist_ok=False)
+        created = True
+        execute(args, report)
+        report["status"] = "complete"
+    except Failure as error:
+        report["failure_stage"] = error.stage
+    except BaseException:
+        report["failure_stage"] = "driver"
+    if created:
+        private_json(args.output_dir / "result.json", report)
+    print(json.dumps({"schema_version": 4, "scope": SCOPE, "status": report["status"],
+        "failure_stage": report["failure_stage"], "performance_controls_qualified": report.get("comparison", {}).get("performance_controls_qualified", False)}, sort_keys=True), flush=True)
+    return 0 if report["status"] == "complete" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
