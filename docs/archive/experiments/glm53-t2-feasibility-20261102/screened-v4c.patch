+"""Private aggregate-only driver for the ignored two-token target probe.
+
+Prompts, IDs, full logits, and native process output remain in RAM. This driver
+writes only allowlisted counts, timings, hashes, source identity and guards.
+V3 preserves full-row validation outside compact timed intervals. Timed paths
+return GPU greedy choices and post-output-norm hidden rows, with unchanged GPU
+math and finite/status checks. They establish no speculative speedup, rollback
+cost, production memory admission, or explanation of V1's unmatched GPU delta.
+An explicit test-only flag selects the dual-row decoder; actual dispatch
+coverage must match the source inventory before candidate results are accepted.
+"""
+
+from __future__ import annotations
+
+import argparse
+import contextlib
+import hashlib
+import io
+import json
+import math
+import os
+import platform
+import re
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+
+SCOPE = "glm53_target_two_token_exact_dual_v3"
+TEST_NAME = b"stark_engine::engine::hybrid::glm::prefill_batch::t2_probe::glm_t2_verification_probe"
+SENTINEL = b'"glm_t2_probe_result"'
+CONTINUATION_TOKENS = 8
+CONTEXT_TOKENS = 256
+ROUNDS = 4
+PROMPTS = (
+    "Name three colors.",
+    "Give one sentence about a quiet garden.",
+    "What is 7 plus 5? Answer briefly.",
+)
+EXPECTED_COUNTS = {
+    "cases": 3, "continuation_rows_per_case": 8, "rounds": 4,
+    "warmup_rounds": 1, "ordinary_serial_alignment_rows": 8,
+    "pooled_alignment_pairs": 4, "pool_residues_tested": 4,
+    "complete_rows_compared": 192, "compact_rows_compared": 192,
+    "timed_full_logit_readback_rows": 0, "measured_compact_serial_pairs": 36,
+    "measured_compact_layer_major_pairs": 36, "rollback_calls": 0,
+}
+TIMING_KEYS = {
+    "compact_serial_two_wall_total", "compact_layer_major_two_wall_total",
+    "compact_serial_two_gpu_total", "compact_layer_major_two_gpu_total",
+    "compact_serial_two_wall_median", "compact_layer_major_two_wall_median",
+    "compact_serial_two_gpu_median", "compact_layer_major_two_gpu_median",
+}
+MEMORY_KEYS = {
+    "cap_bytes", "observed_required_peak_bytes", "residency_allocated_peak_bytes",
+    "static_registered_peak_bytes", "static_entries_peak", "dynamic_allowance_bytes",
+    "sampled_metal_peak_bytes", "graph_scratch_high_water_bytes",
+}
+HASH_KEYS = {"corpus_sha256", "authoritative_continuation_sha256"}
+DUAL_KEYS = {"enabled", "pair_graphs", "q5_dispatch_calls", "q5_encoded_weight_bytes",
+    "q6_dispatch_calls", "q6_encoded_weight_bytes", "q5_calls_per_pair", "q5_weight_bytes_per_pair",
+    "q6_calls_per_pair", "q6_weight_bytes_per_pair"}
+FAILURE_GUARDS = {
+    "stdin_bound", "stdin_schema", "stdin_admission", "target_policy",
+    "alignment_parity", "memory_gate", "model_load", "probe_rejected", "dual_coverage",
+}
+BOOLEAN_SELECTORS = (
+    "STARK_GLM53_ENCODER_BANKS", "STARK_GLM53_RESIDENT_BANKS", "STARK_GLM53_WIDE_ENCODER",
+    "STARK_GLM53_BATCH_FINITE", "STARK_GLM53_Q4K_BLOCK", "STARK_GLM53_KQUANT_FACTORED",
+    "STARK_GLM53_Q6_GROUPED16", "STARK_GLM53_Q5_GROUPED32", "STARK_GLM53_Q4_GROUPED32",
+    "STARK_GLM53_GPU_GREEDY", "STARK_GLM53_CONTROL_SPLIT", "STARK_GLM53_CONTROL_RMS_PROJECT",
+    "STARK_GLM53_CONTROL_SIMD", "STARK_GLM53_KDA_TRANSPOSED", "STARK_GLM53_KDA_FUSED_STATE",
+    "STARK_GLM53_KDA_PARALLEL_NORM", "STARK_GLM53_Q8_SHAPES", "STARK_GLM53_IQ4_VECTOR",
+    "STARK_GLM53_IQ_MULTIROW", "STARK_GLM53_IQ_GPU_BOUND", "STARK_GLM53_IQ_TYPED16",
+    "STARK_GLM53_IQ_SIGNED_FACTOR", "STARK_GLM53_IQ_FUSED_GATE_UP", "STARK_GLM53_IQ_FUSED_GATE_UP_R2",
+    "STARK_GLM53_POLL_WAIT", "STARK_GLM53_SERIAL_FINITE_ORDER", "STARK_GLM53_UNRETAINED_GRAPH",
+    "STARK_GLM53_SCRATCH_HEAP", "STARK_GLM53_CONTROL_FUSED_PARALLEL", "STARK_GLM53_Q8_GROUPED8",
+    "STARK_GLM53_PARALLEL_RMS", "STARK_GLM53_RMS_PREFETCH", "STARK_GLM53_GREEDY_OVERLAP",
+    "STARK_GLM53_PREFILL_OVERLAP", "STARK_GLM53_PREFILL_QUEUED", "STARK_GLM53_PREFILL_MMA",
+    "STARK_GLM53_FINITE_SELECTIVE", "STARK_GLM53_PACKED_FAST_MATH", "STARK_GLM53_PARALLEL_PROJECTIONS",
+    "STARK_GLM53_CONCURRENT_ENCODER", "STARK_GLM53_BOUNDED_GRAPH", "STARK_GLM53_SERIAL_ROUTER",
+    "STARK_GLM53_DECODE_GRAPH", "STARK_HYBRID_ORDERED_RMS", "STARK_HYBRID_PACKED_REFERENCE",
+    "STARK_HYBRID_BYTE_LOADS", "STARK_HYBRID_VECTOR8", "STARK_HYBRID_SCALAR_UINT_LOADS",
+    "STARK_HYBRID_FACTORED_AFFINE", "STARK_HYBRID_SEPARATE_FINITE",
+    "STARK_GLM53_T2_DUAL_INPUT",
+)
+
+
+class ProbeError(Exception):
+    def __init__(self, stage: str, diagnostics: dict | None = None):
+        super().__init__(stage)
+        self.stage = stage
+        self.diagnostics = diagnostics
+
+
+def sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def hash_value(value: object) -> str:
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":")).encode("ascii")).hexdigest()
+
+
+def model_artifact_identity(model_path: Path) -> dict:
+    artifacts = {}
+    for name in ("config.json", "generation_config.json", "tokenizer.json", "tokenizer_config.json", "chat_template.jinja", "native-source.json"):
+        path = model_path / name
+        if path.is_file():
+            artifacts[name] = {"bytes": path.stat().st_size, "sha256": sha256_file(path)}
+    if not {"config.json", "generation_config.json", "tokenizer.json", "native-source.json"} <= set(artifacts):
+        raise ProbeError("model_artifacts")
+    return artifacts
+
+
+def validate_aggregate(value: object) -> dict:
+    if not isinstance(value, dict) or set(value) != {"glm_t2_probe_result", "aggregate"} or value["glm_t2_probe_result"] is not True:
+        raise ProbeError("test_result")
+    aggregate = value["aggregate"]
+    if not isinstance(aggregate, dict):
+        raise ProbeError("test_result")
+    if aggregate.get("status") == "rejected":
+        if (
+            set(aggregate) != {"status", "rows"}
+            or not isinstance(aggregate["rows"], dict)
+            or set(aggregate["rows"]) != {"failure"}
+            or not isinstance(aggregate["rows"]["failure"], dict)
+            or set(aggregate["rows"]["failure"]) != {"guard"}
+            or aggregate["rows"]["failure"]["guard"] not in FAILURE_GUARDS
+        ):
+            raise ProbeError("test_result")
+        return aggregate
+    if set(aggregate) != {"status", "precision", "measurement_scope", "dual_input", "counts", "timing_ms", "memory_gauges", "hashes", "target_reserved_context_tokens"}:
+        raise ProbeError("test_result")
+    if aggregate["status"] != "target_pair_exact_dual_component_complete_no_rollback" or aggregate["precision"] != "existing_safe_f32_legacy_projections":
+        raise ProbeError("test_result")
+    if aggregate["measurement_scope"] != "gpu_greedy_and_post_output_norm_hidden_full_parity_untimed_v3":
+        raise ProbeError("test_result")
+    counts = aggregate["counts"]
+    if not isinstance(counts, dict) or set(counts) != set(EXPECTED_COUNTS) or any(type(counts[key]) is not int or counts[key] != expected for key, expected in EXPECTED_COUNTS.items()):
+        raise ProbeError("test_result")
+    dual = aggregate["dual_input"]
+    if not isinstance(dual, dict) or set(dual) != DUAL_KEYS or type(dual["enabled"]) is not bool or any(type(v) is not int or not 0 <= v <= 2**64 - 1 for k, v in dual.items() if k != "enabled"):
+        raise ProbeError("test_result")
+    pairs = counts["pooled_alignment_pairs"] + counts["complete_rows_compared"] // 4 + counts["compact_rows_compared"] // 4
+    if dual["pair_graphs"] != pairs or any(dual[key] < 1 for key in ("q5_calls_per_pair", "q5_weight_bytes_per_pair", "q6_calls_per_pair", "q6_weight_bytes_per_pair")):
+        raise ProbeError("test_result")
+    for actual, per_pair in (("q5_dispatch_calls", "q5_calls_per_pair"), ("q5_encoded_weight_bytes", "q5_weight_bytes_per_pair"), ("q6_dispatch_calls", "q6_calls_per_pair"), ("q6_encoded_weight_bytes", "q6_weight_bytes_per_pair")):
+        if dual[actual] != (pairs * dual[per_pair] if dual["enabled"] else 0):
+            raise ProbeError("test_result")
+    timing = aggregate["timing_ms"]
+    if not isinstance(timing, dict) or set(timing) != TIMING_KEYS or any(type(v) not in (int, float) or not math.isfinite(v) or v < 0 for v in timing.values()):
+        raise ProbeError("test_result")
+    memory = aggregate["memory_gauges"]
+    if not isinstance(memory, dict) or set(memory) != MEMORY_KEYS or any(type(v) is not int or v < 0 for v in memory.values()):
+        raise ProbeError("test_result")
+    if memory["cap_bytes"] < 1 or memory["observed_required_peak_bytes"] > memory["cap_bytes"] or memory["sampled_metal_peak_bytes"] > memory["cap_bytes"] or memory["graph_scratch_high_water_bytes"] > 512 * 1024 * 1024:
+        raise ProbeError("test_result")
+    hashes = aggregate["hashes"]
+    if not isinstance(hashes, dict) or set(hashes) != HASH_KEYS or any(not isinstance(v, str) or len(v) != 64 or any(c not in "0123456789abcdef" for c in v) for v in hashes.values()):
+        raise ProbeError("test_result")
+    reserved = aggregate["target_reserved_context_tokens"]
+    if type(reserved) is not int or not CONTEXT_TOKENS <= reserved <= 4096:
+        raise ProbeError("test_result")
+    return aggregate
+
+
+def parse_test_result(output: bytes) -> dict:
+    """Accept only standalone JSON or pinned libtest-mimic 0.8.2 framing."""
+    if len(output) > 256 * 1024:
+        raise ProbeError("test_result")
+    prefix = re.compile(rb"test " + re.escape(TEST_NAME) + rb" * \.\.\. (?P<json>\{.*\})")
+
+    def unique_object(pairs):
+        result = {}
+        for key, value in pairs:
+            if key in result:
+                raise ProbeError("test_result")
+            result[key] = value
+        return result
+
+    results = []
+    try:
+        for line in output.splitlines():
+            stripped = line.strip()
+            if SENTINEL not in stripped:
+                continue
+            if stripped.startswith(b"{"):
+                candidate = stripped
+            else:
+                match = prefix.fullmatch(stripped)
+                if match is None:
+                    raise ProbeError("test_result")
+                candidate = match.group("json")
+            results.append(json.loads(candidate, object_pairs_hook=unique_object))
+        if len(results) != 1:
+            raise ProbeError("test_result")
+        return validate_aggregate(results[0])
+    except ProbeError:
+        raise
+    except BaseException:
+        raise ProbeError("test_result") from None
+
+
+def execution_selectors() -> dict:
+    values = {name: os.environ.get(name) == "1" for name in BOOLEAN_SELECTORS}
+    for name in ("STARK_GLM53_CONTROL_CHUNKS", "STARK_GLM53_BANK_GROUP_LAYERS", "STARK_GLM53_PREFILL_CHUNK"):
+        value = os.environ.get(name)
+        values[name] = value if value in {"4", "8", "16", "32", "45"} else "unset_or_invalid"
+    for name in ("STARK_GLM53_ENCODER_BANKS", "STARK_GLM53_RESIDENT_BANKS", "STARK_GLM53_WIDE_ENCODER", "STARK_GLM53_GPU_GREEDY", "STARK_GLM53_DECODE_GRAPH"):
+        if os.environ.get(name) != "1":
+            raise ProbeError("execution_policy")
+    for name in ("STARK_GLM53_GREEDY_OVERLAP", "STARK_GLM53_PREFILL_MMA", "STARK_GLM53_SCRATCH_HEAP", "STARK_GLM53_PARALLEL_PROJECTIONS", "STARK_GLM53_CONCURRENT_ENCODER", "STARK_GLM53_PACKED_FAST_MATH"):
+        if os.environ.get(name) != "0":
+            raise ProbeError("execution_policy")
+    if os.environ.get("STARK_GLM53_T2_DUAL_INPUT") not in (None, "0", "1"):
+        raise ProbeError("execution_policy")
+    return values
+
+
+def run(args: argparse.Namespace) -> dict:
+    model_path = args.model_path.resolve(strict=True)
+    test_binary = args.test_binary.resolve(strict=True)
+    verified_weights = args.verified_weights.resolve(strict=True)
+    if not model_path.is_dir() or not test_binary.is_file():
+        raise ProbeError("arguments")
+    selectors = execution_selectors()
+    artifacts_before = model_artifact_identity(model_path)
+    try:
+        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
+            from benchmark_hybrid import weight_identity
+            from stark_convert.chat import load_template
+            from tokenizers import Tokenizer
+
+            weights_before = weight_identity(model_path, verified_weights)
+            codec, template = load_template(model_path)
+            tokenizer = Tokenizer.from_file(str(model_path / "tokenizer.json"))
+            rendered = [template.render(messages=[{"role": "user", "content": prompt}], tools=None,
+                add_generation_prompt=True, enable_thinking=True, bos_token=codec.get("bos_token") or "",
+                eos_token=codec.get("eos_token") or "") for prompt in PROMPTS]
+            inputs = [tokenizer.encode(prompt, add_special_tokens=False).ids for prompt in rendered]
+    except BaseException:
+        raise ProbeError("preflight") from None
+    if len(inputs) != 3 or any(not 12 <= len(ids) <= 128 for ids in inputs):
+        raise ProbeError("tokenization")
+    corpus_hash = hashlib.sha256(json.dumps(inputs, separators=(",", ":")).encode("ascii")).hexdigest()
+    request = {"schema_version": 3, "cases": [{"input_token_ids": ids} for ids in inputs],
+        "continuation_tokens": CONTINUATION_TOKENS, "rounds": ROUNDS, "context_tokens": CONTEXT_TOKENS,
+        "corpus_sha256": corpus_hash, "dual_input": selectors["STARK_GLM53_T2_DUAL_INPUT"]}
+    environment = os.environ.copy()
+    environment["STARK_GLM53_T2_PROBE_MODEL_PATH"] = str(model_path)
+    started = time.monotonic_ns()
+    try:
+        completed = subprocess.run([str(test_binary), "glm_t2_verification_probe", "--ignored", "--nocapture", "--test-threads=1"],
+            input=(json.dumps(request, separators=(",", ":")) + "\n").encode("ascii"),
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=environment, timeout=1800, check=False)
+    except subprocess.TimeoutExpired:
+        raise ProbeError("test_timeout") from None
+    except BaseException:
+        raise ProbeError("test_launch") from None
+    finally:
+        try:
+            if weight_identity(model_path, verified_weights) != weights_before:
+                raise ProbeError("weight_guard")
+            if model_artifact_identity(model_path) != artifacts_before:
+                raise ProbeError("artifact_guard")
+        except ProbeError:
+            raise
+        except BaseException:
+            raise ProbeError("weight_guard") from None
+    diagnostics = {"native_returncode": completed.returncode, "stdout_bytes": len(completed.stdout),
+        "stderr_bytes": len(completed.stderr), "sentinel_candidates": sum(SENTINEL in line for line in completed.stdout.splitlines())}
+    try:
+        aggregate = parse_test_result(completed.stdout)
+    except ProbeError:
+        raise ProbeError("test_result", diagnostics) from None
+    if aggregate.get("status") != "rejected" and aggregate["hashes"]["corpus_sha256"] != corpus_hash:
+        raise ProbeError("corpus_guard")
+    if aggregate.get("status") != "rejected" and aggregate["dual_input"]["enabled"] != selectors["STARK_GLM53_T2_DUAL_INPUT"]:
+        raise ProbeError("dual_coverage")
+    passed = completed.returncode == 0 and aggregate.get("status") != "rejected"
+    return {"schema_version": 3, "scope": SCOPE, "status": "complete" if passed else "failed",
+        "glm_t2_probe_result": True, "error_stage": None if passed else "test_rejected",
+        "elapsed_ms": (time.monotonic_ns() - started) // 1_000_000,
+        "test_binary_sha256": sha256_file(test_binary), "driver_sha256": sha256_file(Path(__file__).resolve()),
+        "weight_guard_helper_sha256": sha256_file(Path(__file__).with_name("benchmark_hybrid.py")),
+        "execution_selectors": selectors, "execution_selector_sha256": hash_value(selectors),
+        "model_artifacts": artifacts_before, "model_artifacts_unchanged": True,
+        "weights": weights_before, "weights_unchanged": True,
+        "corpus_sha256": corpus_hash, "input_token_count": sum(map(len, inputs)),
+        "input_token_min": min(map(len, inputs)), "input_token_max": max(map(len, inputs)),
+        "context_tokens": CONTEXT_TOKENS, "continuation_tokens": CONTINUATION_TOKENS,
+        "hardware": {"machine": platform.machine(), "macos": platform.mac_ver()[0]},
+        "cost_scope": "compact_greedy_hidden_readback_full_parity_untimed_no_head_catchup_or_rollback",
+        "aggregate": aggregate}
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--test-binary", type=Path, required=True)
+    parser.add_argument("--model-path", type=Path, required=True)
+    parser.add_argument("--verified-weights", type=Path, required=True)
+    args = parser.parse_args()
+    try:
+        result = run(args)
+    except ProbeError as error:
+        result = {"schema_version": 3, "scope": SCOPE, "status": "failed", "glm_t2_probe_result": False,
+            "error_stage": error.stage}
+        if error.diagnostics is not None:
+            result["native_structure"] = error.diagnostics
+    except BaseException:
+        result = {"schema_version": 3, "scope": SCOPE, "status": "failed", "glm_t2_probe_result": False,
+            "error_stage": "driver"}
+    sys.stdout.write(json.dumps(result, sort_keys=True, separators=(",", ":")) + "\n")
+    sys.stdout.flush()
+    return 0 if result["status"] == "complete" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
