+def test_source_and_helper_guards_detect_mutation(tmp_path):
+    files = {}
+    for i in range(13):
+        path = tmp_path / f"source{i}.txt"
+        path.write_text("frozen")
+        files[path.name] = {"bytes": path.stat().st_size, "sha256": legacy.sha256_file(path)}
+    freeze_path = tmp_path / "freeze.json"
+    freeze_path.write_text(json.dumps({"source_files": files}))
+    freeze_sha = legacy.sha256_file(freeze_path)
+    probe.source_guard(tmp_path, freeze_path, freeze_sha)
+    (tmp_path / "source0.txt").write_text("mutable")
+    with pytest.raises(probe.Failure) as error:
+        probe.source_guard(tmp_path, freeze_path, freeze_sha)
+    assert error.value.stage == "source_guard"
+
