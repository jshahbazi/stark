+"""Model-free boundary cases for the aggregate-only target-pair driver."""
+
+import copy
+import json
+
+import pytest
+
+import probe_glm53_t2 as probe
+
+
+def success(enabled=False):
+    pairs = 100
+    q5_calls, q5_bytes, q6_calls, q6_bytes = 68, 1_568_669_696, 68, 1_871_708_160
+    return {"glm_t2_probe_result": True, "aggregate": {
+        "status": "target_pair_exact_dual_component_complete_no_rollback",
+        "precision": "existing_safe_f32_legacy_projections",
+        "measurement_scope": "gpu_greedy_and_post_output_norm_hidden_full_parity_untimed_v3",
+        "dual_input": {"enabled": enabled, "pair_graphs": pairs,
+            "q5_dispatch_calls": pairs * q5_calls if enabled else 0,
+            "q5_encoded_weight_bytes": pairs * q5_bytes if enabled else 0,
+            "q6_dispatch_calls": pairs * q6_calls if enabled else 0,
+            "q6_encoded_weight_bytes": pairs * q6_bytes if enabled else 0,
+            "q5_calls_per_pair": q5_calls, "q5_weight_bytes_per_pair": q5_bytes,
+            "q6_calls_per_pair": q6_calls, "q6_weight_bytes_per_pair": q6_bytes},
+        "counts": dict(probe.EXPECTED_COUNTS),
+        "timing_ms": {name: 1.0 for name in probe.TIMING_KEYS},
+        "memory_gauges": dict({name: 0 for name in probe.MEMORY_KEYS}, cap_bytes=1_000_000),
+        "hashes": {name: "a" * 64 for name in probe.HASH_KEYS},
+        "target_reserved_context_tokens": 4096,
+    }}
+
+
+def rejected():
+    return {"glm_t2_probe_result": True, "aggregate": {
+        "status": "rejected", "rows": {"failure": {"guard": "alignment_parity"}},
+    }}
+
+
+def encoded(value):
+    return json.dumps(value, separators=(",", ":")).encode("ascii")
+
+
+def framed(value, padding=b""):
+    return b"test " + probe.TEST_NAME + padding + b" ... " + encoded(value) + b"\n"
+
+
+@pytest.mark.parametrize("source,expected", [
+    (lambda: encoded(success()), "target_pair_exact_dual_component_complete_no_rollback"),
+    (lambda: framed(success()), "target_pair_exact_dual_component_complete_no_rollback"),
+    (lambda: framed(success(), b"     "), "target_pair_exact_dual_component_complete_no_rollback"),
+    (lambda: encoded(success(True)), "target_pair_exact_dual_component_complete_no_rollback"),
+    (lambda: framed(success(True)), "target_pair_exact_dual_component_complete_no_rollback"),
+    (lambda: encoded(rejected()), "rejected"),
+    (lambda: framed(rejected()), "rejected"),
+])
+def test_accepts_only_supported_single_sentinel_framing(source, expected):
+    assert probe.parse_test_result(source())["status"] == expected
+
+
+def altered(section, key, value):
+    result = copy.deepcopy(success())
+    result["aggregate"][section][key] = value
+    return encoded(result)
+
+
+@pytest.mark.parametrize("source", [
+    lambda: b"test result: ok\n",
+    lambda: encoded(success()) + b"\n" + encoded(success()),
+    lambda: encoded(success()) + b" trailing",
+    lambda: b"test wrong_test ... " + encoded(success()),
+    lambda: b'{"glm_t2_probe_result":true,"aggregate":',
+    lambda: encoded(success()).replace(b'"cases":3', b'"cases":3,"cases":3'),
+    lambda: encoded(dict(success(), unexpected=True)),
+    lambda: altered("counts", "complete_rows_compared", 1),
+    lambda: altered("counts", "compact_rows_compared", 1),
+    lambda: altered("counts", "timed_full_logit_readback_rows", 2),
+    lambda: altered("dual_input", "enabled", True),
+    lambda: altered("dual_input", "q5_dispatch_calls", 1),
+    lambda: altered("dual_input", "q6_encoded_weight_bytes", 1),
+    lambda: altered("dual_input", "q5_calls_per_pair", 0),
+    lambda: altered("dual_input", "pair_graphs", 99),
+    lambda: altered("dual_input", "enabled", "1"),
+    lambda: altered("dual_input", "q5_weight_bytes_per_pair", 2**64),
+    lambda: altered("memory_gauges", "sampled_metal_peak_bytes", 1_000_001),
+    lambda: altered("hashes", "corpus_sha256", "not_a_hash"),
+])
+def test_rejects_missing_duplicate_malformed_or_unqualified_results(source):
+    with pytest.raises(probe.ProbeError) as error:
+        probe.parse_test_result(source())
+    assert error.value.stage == "test_result"
+
+
+def test_metadata_identity_detects_content_changes(tmp_path):
+    for name in ("config.json", "generation_config.json", "tokenizer.json", "native-source.json"):
+        (tmp_path / name).write_text("{}")
+    before = probe.model_artifact_identity(tmp_path)
+    (tmp_path / "tokenizer.json").write_text('{"changed":true}')
+    after = probe.model_artifact_identity(tmp_path)
+    assert before != after
+    assert before["config.json"] == after["config.json"]
+
+
+def test_execution_policy_requires_serial_legacy_math(monkeypatch):
+    for name in probe.BOOLEAN_SELECTORS:
+        monkeypatch.setenv(name, "0")
+    for name in ("STARK_GLM53_ENCODER_BANKS", "STARK_GLM53_RESIDENT_BANKS", "STARK_GLM53_WIDE_ENCODER", "STARK_GLM53_GPU_GREEDY", "STARK_GLM53_DECODE_GRAPH"):
+        monkeypatch.setenv(name, "1")
+    assert probe.execution_selectors()["STARK_GLM53_PREFILL_MMA"] is False
+    monkeypatch.setenv("STARK_GLM53_PREFILL_MMA", "1")
+    with pytest.raises(probe.ProbeError) as error:
+        probe.execution_selectors()
+    assert error.value.stage == "execution_policy"
+    monkeypatch.setenv("STARK_GLM53_PREFILL_MMA", "0")
+    monkeypatch.setenv("STARK_GLM53_T2_DUAL_INPUT", "1")
+    assert probe.execution_selectors()["STARK_GLM53_T2_DUAL_INPUT"] is True
+    monkeypatch.setenv("STARK_GLM53_T2_DUAL_INPUT", "true")
+    with pytest.raises(probe.ProbeError) as error:
+        probe.execution_selectors()
+    assert error.value.stage == "execution_policy"
