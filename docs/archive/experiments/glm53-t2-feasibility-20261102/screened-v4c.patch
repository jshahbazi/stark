+"""Model-free V4 protocol, screening, coverage and bounded-stream fixtures."""
+
+import copy
+import json
+from pathlib import Path
+import subprocess
+import sys
+import time
+
+import pytest
+
+import probe_glm53_t2 as legacy
+import probe_glm53_t2_screened as probe
+from test_probe_glm53_t2 import success
+
+
+def encode(event="prepared", payload=None):
+    return json.dumps({"glm_t2_screened_event": True, "schema_version": 4,
+        "event": event, "payload": payload or {}}).encode("ascii")
+
+
+@pytest.mark.parametrize("raw", [encode(), b"test " + legacy.TEST_NAME + b" ... " + encode(),
+    b"test " + legacy.TEST_NAME + b"     ... " + encode()])
+def test_event_supported_framing(raw):
+    assert probe.parse_event(raw)["event"] == "prepared"
+
+
+def test_hard_deadline_interrupts_blocking_call_and_restores_signal():
+    previous = probe.signal.getsignal(probe.signal.SIGALRM)
+    with pytest.raises(probe.Failure) as error:
+        with probe.session_deadline(.02):
+            time.sleep(1)
+    assert error.value.stage == "deadline"
+    assert probe.signal.getitimer(probe.signal.ITIMER_REAL) == (0.0, 0.0)
+    assert probe.signal.getsignal(probe.signal.SIGALRM) == previous
+
+
+def test_hard_deadline_restores_on_early_error():
+    previous = probe.signal.getsignal(probe.signal.SIGALRM)
+    with pytest.raises(ValueError):
+        with probe.session_deadline(10):
+            raise ValueError("fixed model-free failure")
+    assert probe.signal.getitimer(probe.signal.ITIMER_REAL) == (0.0, 0.0)
+    assert probe.signal.getsignal(probe.signal.SIGALRM) == previous
+
+
+@pytest.mark.parametrize("raw", [
+    b"test wrong ... " + encode(), encode() + b" trailing", encode() + encode(),
+    encode().replace(b'"schema_version": 4', b'"schema_version": 4, "schema_version": 4'),
+    encode().replace(b'"schema_version": 4', b'"schema_version": true'),
+    encode().replace(b'"prepared"', b'"unknown"'),
+    encode().replace(b'"payload": {}', b'"payload": {"value": NaN}'),
+    encode().replace(b'"payload": {}', b'"payload": []'),
+    encode().replace(b'"payload": {}', b'"payload": {}, "extra": 1'),
+    b'"glm_t2_screened_event"' + b" " * (256 * 1024),
+    json.dumps(success()).encode("ascii"),
+])
+def test_event_rejects_schema_and_private_output_bound(raw):
+    with pytest.raises(probe.Failure):
+        probe.parse_event(raw)
+
+
+def sample(dual):
+    expected = {"sample": 1, "block": 0, "attempt": 1, "slot": int(dual), "case": 0, "pair": 0, "dual": dual}
+    value = {**expected, "wall_ms": 70.0, "gpu_ms": 60.0, "compact_rows_compared": 2,
+        "dual_counters": [value * int(dual) for value in probe.PER_PAIR],
+        "memory_gauges": success()["aggregate"]["memory_gauges"]}
+    return expected, value
+
+
+@pytest.mark.parametrize("dual", [False, True])
+def test_exact_per_sample_coverage_and_types(dual):
+    expected, value = sample(dual)
+    assert probe.validate_sample(value, expected) is value
+    for key, changed in (("sample", True), ("dual", int(dual)), ("wall_ms", float("nan")),
+        ("gpu_ms", 0), ("compact_rows_compared", True)):
+        bad = copy.deepcopy(value)
+        bad[key] = changed
+        with pytest.raises(probe.Failure):
+            probe.validate_sample(bad, expected)
+    bad = copy.deepcopy(value)
+    bad["dual_counters"][0] += 1
+    with pytest.raises(probe.Failure) as error:
+        probe.validate_sample(bad, expected)
+    assert error.value.stage == "native_coverage"
+
+
+def clean_screen():
+    return {"samples": 1, "external_cpu_max": 150.0, "external_model_cpu_max": 10.0, "thermal_max": 1,
+        "compiler_active": False, "sampling_gap": False, "sampling_failures": 0,
+        "paging_delta": {"pageouts": 0, "swapouts": 0}, "eligible": True}
+
+
+@pytest.mark.parametrize("field,value,reason", [("external_cpu_max", 150.001, "external_cpu"),
+    ("external_model_cpu_max", 10.001, "external_model_cpu"), ("thermal_max", 2, "thermal"),
+    ("compiler_active", True, "compiler"), ("sampling_gap", True, "sampling_gap"),
+    ("sampling_failures", 1, "sampling_failure"), ("pageouts", 1, "pageouts"), ("swapouts", 1, "swapouts")])
+def test_unchanged_screen_limits_and_fixed_reasons(field, value, reason):
+    assert probe.rejection_reasons(clean_screen()) == []
+    screen = clean_screen()
+    if field in {"pageouts", "swapouts"}:
+        screen["paging_delta"][field] = value
+    else:
+        screen[field] = value
+    screen["eligible"] = False
+    assert probe.rejection_reasons(screen) == [reason]
+    screen["eligible"] = True
+    with pytest.raises(probe.Failure):
+        probe.rejection_reasons(screen)
+
+
+@pytest.mark.parametrize("change", [lambda s: s.update(processes=[]), lambda s: s.update(samples=0),
+    lambda s: s.update(samples=True), lambda s: s["paging_delta"].update(pageouts=-1),
+    lambda s: s.update(external_cpu_max=float("inf"))])
+def test_monitor_schema_fail_closed(change):
+    screen = clean_screen()
+    change(screen)
+    with pytest.raises(probe.Failure) as error:
+        probe.rejection_reasons(screen)
+    assert error.value.stage == "monitor_health"
+
+
+@pytest.mark.parametrize("field,value", [("streak_seconds", 9.99), ("samples", 0),
+    ("external_cpu_max", 150.01), ("max_process_cpu", 80.01),
+    ("external_model_cpu_max", 10.01), ("gpu_utilization_max", 5.01), ("thermal_max", 2)])
+def test_quiet_admission_contract_preserves_all_limits(field, value):
+    admission = {"streak_seconds": 10.0, "samples": 20, "external_cpu_max": 150.0,
+        "max_process_cpu": 80.0, "external_model_cpu_max": 10.0, "gpu_utilization_max": 5.0, "thermal_max": 1}
+    probe.validate_admission(admission)
+    admission[field] = value
+    with pytest.raises(probe.Failure) as error:
+        probe.validate_admission(admission)
+    assert error.value.stage == "monitor_health"
