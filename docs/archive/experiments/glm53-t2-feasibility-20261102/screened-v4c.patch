+def test_pipe_readers_drain_both_streams_without_raw_artifacts(monkeypatch, tmp_path):
+    original = subprocess.Popen
+    code = "import sys; sys.stderr.write('x'*100000); sys.stderr.flush(); print(" + repr(encode().decode("ascii")) + ",flush=True)"
+    def launch(*args, **kwargs):
+        return original([sys.executable, "-c", code], **kwargs)
+    monkeypatch.setattr(probe.subprocess, "Popen", launch)
+    native = probe.Native(Path("unused"), dict(probe.os.environ))
+    assert native.receive("prepared", 5) == {}
+    capture = native.close(True)
+    assert capture["returncode"] == 0
+    assert capture["stream_bytes"]["stderr"] == 100000
+    assert capture["stream_reader_failed"] is False
+    assert capture["unexpected_events"] is False
+    assert list(tmp_path.iterdir()) == []
+
+
+def test_pipe_output_bound_fails_and_drains(monkeypatch):
+    original = subprocess.Popen
+    def launch(*args, **kwargs):
+        return original([sys.executable, "-c", "import sys; sys.stderr.write('x'*(3*1024*1024)); sys.stderr.flush()"], **kwargs)
+    monkeypatch.setattr(probe.subprocess, "Popen", launch)
+    native = probe.Native(Path("unused"), dict(probe.os.environ))
+    with pytest.raises(probe.Failure):
+        native.receive("prepared", 5)
+    capture = native.close()
+    assert capture["stream_reader_failed"] is True
+    assert capture["stream_bytes"]["stderr"] == 3 * 1024 * 1024
