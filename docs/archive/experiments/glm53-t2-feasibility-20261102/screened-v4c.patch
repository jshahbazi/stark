+def test_full_matched_block_exclusion_and_six_block_requirement():
+    blocks = []
+    for block in range(6):
+        samples = [{"native": {"wall_ms": value, "gpu_ms": value / 2, "dual": dual}}
+            for value, dual in zip((100, 80, 80, 100), probe.MODES)]
+        blocks.append({"block": block, "attempt": 1, "accepted": True, "samples": samples})
+    result = probe.grouped_comparison(blocks)
+    assert result["performance_controls_qualified"] is True
+    assert result["accepted_samples"] == 24
+    assert result["wall_ms"]["mean_block_B_over_A"] == pytest.approx(.8)
+    blocks[0]["accepted"] = False
+    blocks[0]["samples"][0]["native"]["wall_ms"] = 1000000
+    result = probe.grouped_comparison(blocks)
+    assert result["performance_controls_qualified"] is False
+    assert result["accepted_samples"] == 20
+    assert result["wall_ms"]["A_mean"] == 100
