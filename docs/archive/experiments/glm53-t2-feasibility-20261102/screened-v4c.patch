+// SPDX-License-Identifier: Apache-2.0
+//! V4 same-loaded-model, bounded control protocol. Native payloads stay in RAM.
+
+use std::io::{BufRead, Write};
+
+use super::*;
+use crate::engine::hybrid::weight_metal::with_t2_dual_input;
+
+const POSITIONS: [(usize, usize); 6] = [(0, 0), (0, 1), (0, 2), (0, 3), (1, 0), (2, 0)];
+const MODES: [bool; 4] = [false, true, true, false];
+const MAX_ATTEMPTS: usize = 3;
+const MAX_SAMPLES: usize = POSITIONS.len() * MAX_ATTEMPTS * MODES.len();
+
+#[derive(Deserialize)]
+#[serde(tag = "command", rename_all = "snake_case", deny_unknown_fields)]
+enum Command {
+    Prepare {
+        sample: usize,
+        block: usize,
+        attempt: usize,
+        slot: usize,
+        case: usize,
+        pair: usize,
+        dual: bool,
+    },
+    Continue {
+        sample: usize,
+    },
+    Cancel {
+        sample: usize,
+    },
+    Decide {
+        block: usize,
+        attempt: usize,
+        accepted: bool,
+    },
+    // Empty struct variants preserve deny_unknown_fields. Serde's internally
+    // tagged unit visitor would otherwise discard arbitrary extra fields.
+    Finish {},
+    Abort {},
+}
+
+pub(super) fn read_line<T: serde::de::DeserializeOwned>(
+    input: &mut impl BufRead,
+    limit: usize,
+) -> Result<T> {
+    let mut bytes = Vec::new();
+    loop {
+        let available = input.fill_buf()?;
+        if available.is_empty() {
+            return Err(Error::Invalid("T2 control EOF"));
+        }
+        let newline = available.iter().position(|&b| b == b'\n');
+        let count = newline.map_or(available.len(), |at| at + 1);
+        if bytes.len().checked_add(count).is_none_or(|n| n > limit) {
+            return Err(Error::Invalid("T2 stdin bound"));
+        }
+        bytes.extend_from_slice(&available[..count]);
+        input.consume(count);
+        if newline.is_some() {
+            return serde_json::from_slice(&bytes).map_err(|_| Error::Invalid("T2 stdin schema"));
+        }
+    }
+}
+
+fn emit(value: Value) -> Result<()> {
+    println!("{value}");
+    std::io::stdout().flush()?;
+    Ok(())
+}
+
+fn event(
+    name: &str,
+    payload: Value,
+) -> Value {
+    serde_json::json!({"glm_t2_screened_event":true,"schema_version":4,"event":name,"payload":payload})
+}
+
+fn counters() -> [u64; 4] {
+    let all = profile::snapshot();
+    let get = |name: &str| all.get(name).map_or((0, 0), |counter| (counter.calls, counter.bytes));
+    let q5 = get("native.glm.t2.dual_input.q5");
+    let q6 = get("native.glm.t2.dual_input.q6");
+    [q5.0, q5.1, q6.0, q6.1]
+}
+
+fn coverage(
+    actual: [u64; 4],
+    inventory: [usize; 4],
+    graphs: usize,
+) -> Result<()> {
+    for (actual, per_pair) in actual.into_iter().zip(inventory) {
+        let expected = u64::try_from(per_pair).ok().and_then(|n| n.checked_mul(graphs as u64));
+        if Some(actual) != expected {
+            return Err(Error::Invalid("T2 dual dispatch coverage"));
+        }
+    }
+    Ok(())
+}
+
+fn prepare(
+    model: &mut GlmModel,
+    request: &Request,
+    references: &[Reference],
+    case: usize,
+    pair: usize,
+) -> Result<()> {
+    prefill(model, &request.cases[case].input_token_ids)?;
+    for &token in &references[case].inputs[..pair] {
+        serial_row_mode(model, token, false, false)?;
+    }
+    // Every replay graph uses synchronous finish(), including finite/status and
+    // KDA completion checks. No submitted work remains when prepared is emitted.
+    if model.position != request.cases[case].input_token_ids.len() + pair || model.cleanup_failed {
+        return Err(Error::Invalid("T2 prepared state"));
+    }
+    Ok(())
+}
+
+#[stark_engine_macros::stark_test]
+fn t2_control_line_bounds_and_typed_schema() {
+    use std::io::{BufReader, Cursor};
+
+    let mut input = BufReader::new(Cursor::new(b"{\"command\":\"continue\",\"sample\":1}\n{\"command\":\"finish\"}\n"));
+    assert!(matches!(
+        read_line::<Command>(&mut input, 4096),
+        Ok(Command::Continue {
+            sample: 1
+        })
+    ));
+    assert!(matches!(read_line::<Command>(&mut input, 4096), Ok(Command::Finish {})));
+    assert!(read_line::<Command>(&mut input, 4096).is_err());
+    for bytes in [
+        b"{\"command\":\"continue\",\"sample\":true}\n".as_slice(),
+        b"{\"command\":\"continue\",\"sample\":1,\"sample\":1}\n".as_slice(),
+        b"{\"command\":\"finish\",\"extra\":1}\n".as_slice(),
+        b"{\"command\":\"unknown\"}\n".as_slice(),
+        b"{\"command\":\"finish\"}".as_slice(),
+    ] {
+        assert!(read_line::<Command>(&mut BufReader::new(Cursor::new(bytes)), 4096).is_err());
+    }
+    assert!(read_line::<Command>(&mut BufReader::new(Cursor::new(b"{}\n")), 2).is_err());
+}
+
+pub(super) fn run(
+    model: &mut GlmModel,
+    request: &Request,
+    references: &[Reference],
+    memory: &mut Memory,
+    inventory: [usize; 4],
+    validated: Value,
+    input: &mut impl BufRead,
+) -> Result<Value> {
+    if inventory[0] != 68 || inventory[2] != 68 || inventory[1] == 0 || inventory[3] == 0 {
+        return Err(Error::Invalid("T2 dual inventory"));
+    }
+    coverage(counters(), inventory, 100)?;
+    let mut residues = [false; 4];
+    // The original 192 full +192 compact gates stay intact. Additionally prove
+    // the exact six scheduled positions, including overlapping odd prefixes,
+    // before the first screened interval. All use the candidate globally on.
+    for (case, pair) in POSITIONS {
+        prepare(model, request, references, case, pair)?;
+        residues[model.position % 4] = true;
+        let actual = pair_rows(model, &references[case].inputs[pair..pair + 2])?;
+        for (actual, expected) in actual.iter().zip(&references[case].rows[pair..pair + 2]) {
+            compare_rows(actual, expected)?;
+        }
+        memory.observe(model)?;
+    }
+    if residues != [true; 4] {
+        return Err(Error::Invalid("T2 selected pool residues"));
+    }
+    let proof_graphs = 100 + POSITIONS.len();
+    coverage(counters(), inventory, proof_graphs)?;
+    let accounting = model.weights.t2_probe_accounting()?;
+    let static_state = (accounting[3], accounting[4]);
+    emit(event(
+        "validated",
+        serde_json::json!({"validation":validated,
+        "selected_full_rows_compared":12,"selected_pool_residues":4,
+        "initial_candidate_pair_graphs":proof_graphs,"max_samples":MAX_SAMPLES}),
+    ))?;
+
+    let (mut block, mut attempt, mut slot) = (0usize, 1usize, 0usize);
+    let (mut next_sample, mut pending) = (1usize, None);
+    let (mut completed, mut cancelled, mut candidate_graphs, mut accepted_blocks) = (0usize, 0usize, 0usize, 0usize);
+    let mut attempt_cancelled = false;
+    loop {
+        match read_line::<Command>(input, 4096)? {
+            Command::Prepare {
+                sample,
+                block: got_block,
+                attempt: got_attempt,
+                slot: got_slot,
+                case,
+                pair,
+                dual,
+            } if pending.is_none()
+                && block < POSITIONS.len()
+                && slot < MODES.len()
+                && sample == next_sample
+                && sample <= MAX_SAMPLES
+                && got_block == block
+                && got_attempt == attempt
+                && got_slot == slot
+                && (case, pair) == POSITIONS[block]
+                && dual == MODES[slot] =>
+            {
+                prepare(model, request, references, case, pair)?;
+                memory.observe(model)?;
+                pending = Some((sample, case, pair, dual));
+                next_sample += 1;
+                emit(event(
+                    "prepared",
+                    serde_json::json!({"sample":sample,"block":block,"attempt":attempt,
+                    "slot":slot,"case":case,"pair":pair,"dual":dual,"pool_residue":model.position % 4}),
+                ))?;
+            },
+            Command::Continue {
+                sample,
+            } if pending.is_some_and(|p| p.0 == sample) => {
+                let (_, case, pair, dual) = pending.take().ok_or(Error::Invalid("T2 control state"))?;
+                let before = counters();
+                let (actual, wall_ms, gpu_ms) = with_t2_dual_input(dual, || -> Result<_> {
+                    let gpu_before = gpu_seconds();
+                    let started = Instant::now();
+                    let actual = pair_rows_mode(model, &references[case].inputs[pair..pair + 2], false)?;
+                    let wall_ms = started.elapsed().as_secs_f64() * 1000.0;
+                    let gpu_ms = (gpu_seconds() - gpu_before) * 1000.0;
+                    Ok((actual, wall_ms, gpu_ms))
+                })?;
+                if !wall_ms.is_finite() || wall_ms <= 0.0 || !gpu_ms.is_finite() || gpu_ms <= 0.0 {
+                    return Err(Error::Invalid("T2 sample timing"));
+                }
+                for (actual, expected) in actual.iter().zip(&references[case].rows[pair..pair + 2]) {
+                    compare_compact_rows(actual, expected)?;
+                }
+                let after = counters();
+                let mut delta = [0; 4];
+                for i in 0..4 {
+                    delta[i] = after[i].checked_sub(before[i]).ok_or(Error::Invalid("T2 dual counter order"))?;
+                }
+                coverage(delta, inventory, usize::from(dual))?;
+                memory.observe(model)?;
+                let accounting = model.weights.t2_probe_accounting()?;
+                if (accounting[3], accounting[4]) != static_state {
+                    return Err(Error::Invalid("T2 static cache growth after warmup"));
+                }
+                completed += 1;
+                candidate_graphs += usize::from(dual);
+                emit(event(
+                    "sample",
+                    serde_json::json!({"sample":sample,"block":block,"attempt":attempt,"slot":slot,
+                    "case":case,"pair":pair,"dual":dual,"wall_ms":wall_ms,"gpu_ms":gpu_ms,
+                    "compact_rows_compared":2,"dual_counters":delta,"memory_gauges":memory}),
+                ))?;
+                slot += 1;
+            },
+            Command::Cancel {
+                sample,
+            } if pending.is_some_and(|p| p.0 == sample) => {
+                pending = None;
+                attempt_cancelled = true;
+                cancelled += 1;
+                emit(event("cancelled", serde_json::json!({"sample":sample})))?;
+                slot += 1;
+            },
+            Command::Decide {
+                block: got_block,
+                attempt: got_attempt,
+                accepted,
+            } if pending.is_none()
+                && block < POSITIONS.len()
+                && slot == MODES.len()
+                && got_block == block
+                && got_attempt == attempt
+                && (!accepted || !attempt_cancelled) =>
+            {
+                if accepted {
+                    accepted_blocks += 1;
+                }
+                emit(event("decided", serde_json::json!({"block":block,"attempt":attempt,"accepted":accepted})))?;
+                if accepted || attempt == MAX_ATTEMPTS {
+                    block += 1;
+                    attempt = 1;
+                } else {
+                    attempt += 1;
+                }
+                slot = 0;
+                attempt_cancelled = false;
+            },
+            Command::Finish {} if pending.is_none() && block == POSITIONS.len() && slot == 0 => {
+                coverage(counters(), inventory, proof_graphs + candidate_graphs)?;
+                return Ok(event(
+                    "finished",
+                    serde_json::json!({"prepared_samples":next_sample - 1,
+                    "completed_samples":completed,"cancelled_samples":cancelled,"accepted_blocks":accepted_blocks,
+                    "initial_candidate_pair_graphs":proof_graphs,"candidate_sample_pair_graphs":candidate_graphs,
+                    "dual_counters":counters(),"memory_gauges":memory,"rollback_calls":0}),
+                ));
+            },
+            Command::Abort {} => return Err(Error::Invalid("T2 control aborted")),
+            _ => return Err(Error::Invalid("T2 control order")),
+        }
+    }
+}
