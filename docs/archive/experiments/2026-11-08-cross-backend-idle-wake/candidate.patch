+    impl Read for ScriptInput {
+        fn read(
+            &mut self,
+            output: &mut [u8],
+        ) -> io::Result<usize> {
+            let available = self.fill_buf()?;
+            let count = available.len().min(output.len());
+            output[..count].copy_from_slice(&available[..count]);
+            self.consume(count);
+            Ok(count)
