+#[derive(Clone, Copy, Debug)]
+enum Q5Path {
+    Generic,
+    Guarded,
+    RawDiagnostic,
+}
+
+fn special_pipeline(
+    shape: Shape,
+    guarded: bool,
+) -> Result<(PipelineState, MmaGeometry)> {
+    if shape.kind != 13 {
+        return Err(Error::Invalid("specialized MMA requires Q5_K"));
+    }
+    let executor = executor()?;
+    let mut geometry = initial_geometry(shape)?;
+    loop {
+        let constants = MTLFunctionConstantValues::new();
+        for (index, value) in [(0, 13u32), (4, 256), (5, 176), (80, geometry.nsg as u32), (81, u32::from(guarded))] {
+            constants.set_constant_value_type_at_index(NonNull::from(&value).cast(), MTLDataType::UInt, index);
+        }
+        let name = format!("hybrid_q5_special_nt{}_rt{}", geometry.nt, geometry.rt);
+        let function = executor
+            .library
+            .new_function_with_name_constant_values(&name, &constants)
+            .map_err(|_| Error::Unsupported("Q5 specialized function unavailable"))?;
+        let pipeline = executor
+            .device
+            .new_compute_pipeline_state_with_function(&function)
+            .map_err(|_| Error::Unsupported("Q5 specialized pipeline unavailable"))?;
+        if pipeline.thread_execution_width() != 32 {
+            return Err(Error::Unsupported("Q5 specialized lane mapping"));
+        }
+        if pipeline.max_total_threads_per_threadgroup() < geometry.nsg * 32 {
+            if geometry.nsg == 1 {
+                return Err(Error::Unsupported("Q5 specialized thread limit"));
+            }
+            geometry.nsg /= 2;
+            geometry.shared_bytes = geometry.nsg * geometry.nt * geometry.rt * 256;
+            continue;
+        }
+        if geometry.shared_bytes + pipeline.static_threadgroup_memory_length()
+            > executor.device.max_threadgroup_memory_length()
+        {
+            return Err(Error::Unsupported("Q5 specialized shared memory limit"));
+        }
+        return Ok((pipeline, geometry));
+    }
+}
