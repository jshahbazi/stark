+// SPDX-License-Identifier: Apache-2.0
+// Adapted from ggml-org/llama.cpp dde879bc4f954b809892fd0d660515f42536394a,
+// ggml/src/ggml-metal/kernels/mul_mv_mma.metal:317-494. Copyright (c)
+// 2023-2026 The ggml authors. See LICENSE.ggml-hybrid. Test-only experiment.
+// Exact integer F16 A fragments, original F32 B values, F32 accumulation and
+// affine reconstruction. Byte-safe metadata conversion preserves stored F16
+// subnormals. Affine factoring changes rounding; no bit-equivalence claim.
+// Guarded mode admits modest finite coefficients and inputs, then rejects
+// cancellation using an affine L1 bound. Every rejection uniformly replays
+// the archived generic F32 MMA. Raw mode is a diagnostic required to expose
+// the legal zero-coefficient counterexample; it is never a runtime selector.
+// The source-input fallback below preserves Stark's existing Apache-2.0
+// packed_q5_grouped32_matvec.metal chronology; upstream MIT notices remain above.
+
+constant uint hybrid_q5_special_guarded [[function_constant(81)]];
+
+inline float hybrid_q5_special_source_dot(device const uchar *codes,device const float *input,
+    ulong row_offset,ulong input_offset,uint columns,uint lane) {
+    const uint tid=lane>>2,parity=lane&3,quarter=tid>>2,low_start=(tid&3)*8;
+    const uint low_offset=48+quarter*32+low_start,high_offset=16+low_start;
+    const uint input_start=quarter*64+low_start,g0=quarter*2;
+    float sum=0.0f;bool reference_required=false;
+    for (uint block_index=parity;block_index<(columns>>8);block_index+=4) {
+        device const uchar *block=codes+row_offset+ulong(block_index)*176;
+        device const float *x=input+input_offset+block_index*256+input_start;
+        float4 lower=float4(0.0f),upper=float4(0.0f),input_sum=float4(0.0f);
+        #pragma clang loop unroll(full)
+        for (uint j=0;j<8;++j) {
+            const float4 values=float4(x[j],x[j+32],x[j+128],x[j+160]);
+            reference_required=reference_required||any(abs(values)>float4(1e20f));
+            input_sum+=values;
+            const uint low0=block[low_offset+j],low1=block[low_offset+j+64],high=block[high_offset+j];
+            lower.x+=values.x*float(low0&15);lower.y+=values.y*float(low0>>4);
+            lower.z+=values.z*float(low1&15);lower.w+=values.w*float(low1>>4);
+            upper.x+=high&(1u<<g0)?values.x:0.0f;upper.y+=high&(1u<<(g0+1))?values.y:0.0f;
+            upper.z+=high&(1u<<(g0+4))?values.z:0.0f;upper.w+=high&(1u<<(g0+5))?values.w:0.0f;
+        }
+        const uint2 sm0=hybrid_scale_min(block+4,g0),sm1=hybrid_scale_min(block+4,g0+1);
+        const uint2 sm2=hybrid_scale_min(block+4,g0+4),sm3=hybrid_scale_min(block+4,g0+5);
+        const float4 group_dot=lower+16.0f*upper;
+        sum+=hybrid_half(block)*(float(sm0.x)*group_dot.x+float(sm1.x)*group_dot.y
+            +float(sm2.x)*group_dot.z+float(sm3.x)*group_dot.w)
+            -hybrid_half(block+2)*(input_sum.x*float(sm0.y)+input_sum.y*float(sm1.y)
+            +input_sum.z*float(sm2.y)+input_sum.w*float(sm3.y));
+    }
+    if (simd_any(reference_required)) return hybrid_packed_block_dot(codes,input,row_offset,input_offset,columns,lane);
+    return simd_sum(sum);
+}
+
+inline half2 hybrid_q5_special_integer(ushort2 q) {
+    return as_type<half2>(q | ushort(0x6400)) - half(1024.0h);
+}
+inline void hybrid_q5_special_fragments(uint q, uint h, thread half2 *lo, thread half2 *hi) {
+    const ushort2 qw = as_type<ushort2>(q), hw = as_type<ushort2>(h);
+    lo[0] = hybrid_q5_special_integer((qw & 0x000f) | ((hw << 4) & 0x0010));
+    lo[1] = hybrid_q5_special_integer(((qw >> 8) & 0x000f) | ((hw >> 4) & 0x0010));
+    hi[0] = hybrid_q5_special_integer((qw & 0x00f0) | ((hw << 7) & 0x0100));
+    hi[1] = hybrid_q5_special_integer(((qw >> 8) & 0x00f0) | ((hw >> 1) & 0x0100));
+}
+
+template<uint NT, uint RT>
+inline void hybrid_q5_special_impl(device const uchar *codes_base,
+    device const float *input_base, device float *output_base, constant uint *p,
+    device atomic_uint *failure, device atomic_uint *counters, threadgroup float *red,
+    threadgroup atomic_uint *fallback, threadgroup atomic_uint *reference,
+    uint2 tile, uint lane, uint sg) {
+    const uint nsg = hybrid_q5_reference_mma_nsg;
+    const uint rows = p[0], columns = p[1], tokens = p[2];
+    const uint fm = hybrid_q5_reference_mma_fm(lane), fn = hybrid_q5_reference_mma_fn(lane);
+    const uint first_row = tile.x * (8 * NT), first_token = tile.y * (8 * RT);
+    const uint tid = sg * 32 + lane;
+    device const uchar *codes = codes_base + p[3];
+    device const float *input = input_base + p[4];
+    device float *output = output_base + p[5];
+    const ulong row_bytes = ulong(columns / 256) * 176;
+    if (tid == 0) atomic_store_explicit(fallback, 0u, memory_order_relaxed);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    // Counters: specialized TGs, metadata generic fallback, input source
+    // fallback, cancellation generic fallback, total fallback. No values escape.
+    if (hybrid_q5_special_guarded) {
+        const uint count = min(uint(8 * NT), rows - first_row) * (columns / 256);
+        for (uint at = tid; at < count; at += nsg * 32) {
+            const uint row = first_row + at / (columns / 256);
+            device const uchar *block = codes + ulong(row) * row_bytes + ulong(at % (columns / 256)) * 176;
+            const float d = hybrid_half(block), dm = hybrid_half(block + 2);
+            bool risky = !isfinite(d) || !isfinite(dm);
+            #pragma clang loop unroll(full)
+            for (uint j = 0; j < 8; ++j) {
+                const uint2 sm = hybrid_scale_min(block + 4, j);
+                risky = risky || abs(d * float(sm.x) * 31.0f) > 1.0f || abs(dm * float(sm.y)) > 1.0f;
+            }
+            if (risky) atomic_fetch_or_explicit(fallback, 1u, memory_order_relaxed);
+        }
+    }
+    const uint input_count = min(uint(8 * RT), tokens - first_token) * columns;
+    for (uint at = tid; at < input_count; at += nsg * 32) {
+        const float x = input[ulong(first_token) * columns + at];
+        const uint abs_bits = as_type<uint>(x) & 0x7fffffffu;
+        // Classify tiny/subnormal inputs by their IEEE bits: floating-point
+        // comparisons can themselves flush subnormals. The 1e-30 floor also
+        // keeps products with the smallest nonzero Q5 coefficient away from
+        // F32 underflow. Zero is admitted. This is an experimental envelope.
+        if (abs_bits >= 0x7f800000u || abs_bits > as_type<uint>(1e20f)
+            || (abs_bits != 0u && abs_bits < as_type<uint>(1e-30f)))
+            atomic_fetch_or_explicit(fallback, 2u, memory_order_relaxed);
+        if (abs_bits >= 0x7f800000u) atomic_store_explicit(failure,1u,memory_order_relaxed);
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    uint reason = atomic_load_explicit(fallback, memory_order_relaxed);
+    if (reason) {
+        if (tid == 0) {
+            if (reason & 1u) atomic_fetch_add_explicit(counters + 1, 1u, memory_order_relaxed);
+            if (reason & 2u) atomic_fetch_add_explicit(counters + 2, 1u, memory_order_relaxed);
+            atomic_fetch_add_explicit(counters + 4, 1u, memory_order_relaxed);
+        }
+        if (reason & 2u) {
+            // Preserve original chronology for subnormal inputs as well as
+            // extreme/nonfinite inputs. Generic v1 MMA has an extreme guard,
+            // but its ordinary MMA reduction does not promise subnormal parity.
+            for (uint flat = sg; flat < (8 * NT) * (8 * RT); flat += nsg) {
+                const uint row = first_row + flat % (8 * NT), token = first_token + flat / (8 * NT);
+                if (row < rows && token < tokens) {
+                    const float total = hybrid_q5_special_source_dot(codes,input,ulong(row)*row_bytes,ulong(token)*columns,columns,lane);
+                    if (lane == 0) {
+                        if (!isfinite(total)) atomic_store_explicit(failure,1u,memory_order_relaxed);
+                        output[ulong(token)*rows+row] = total;
+                    }
+                }
+            }
+        } else hybrid_q5_reference_mma_impl<NT, RT>(codes_base,input_base,output_base,p,failure,red,reference,tile,lane,sg);
+        return;
+    }
+    float acc[RT][NT][2] = {};
+    float magnitude[RT][NT][2] = {};
+    for (uint ip = sg; ip < columns / 64; ip += nsg) {
+        const uint pair = ip % 4;
+        float2 xs[RT][2][2][2];
+        float c[RT][2][2], absolute_c[RT][2][2];
+        #pragma clang loop unroll(full)
+        for (uint rt = 0; rt < RT; ++rt) {
+            #pragma clang loop unroll(full)
+            for (uint e = 0; e < 2; ++e) {
+                const uint token = min(first_token + 8 * rt + fn + e, tokens - 1);
+                const ulong base = ulong(token) * columns + ip * 64 + 8 * (fm / 2) + 2 * (fm % 2);
+                #pragma clang loop unroll(full)
+                for (uint h = 0; h < 2; ++h) {
+                    xs[rt][e][h][0] = float2(input[base + h * 32], input[base + h * 32 + 1]);
+                    xs[rt][e][h][1] = float2(input[base + h * 32 + 4], input[base + h * 32 + 5]);
+                    float u = xs[rt][e][h][0].x + xs[rt][e][h][0].y + xs[rt][e][h][1].x + xs[rt][e][h][1].y;
+                    float absolute = abs(xs[rt][e][h][0].x) + abs(xs[rt][e][h][0].y)
+                        + abs(xs[rt][e][h][1].x) + abs(xs[rt][e][h][1].y);
+                    u += simd_shuffle_xor(u, 2); absolute += simd_shuffle_xor(absolute, 2);
+                    u += simd_shuffle_xor(u, 4); absolute += simd_shuffle_xor(absolute, 4);
+                    u += simd_shuffle_xor(u, 16); absolute += simd_shuffle_xor(absolute, 16);
+                    c[rt][e][h] = u; absolute_c[rt][e][h] = absolute;
+                }
+            }
+        }
+        #pragma clang loop unroll(full)
+        for (uint t = 0; t < NT; ++t) {
+            const uint row = min(first_row + 8 * t + fm, rows - 1);
+            device const uchar *block = codes + ulong(row) * row_bytes + ulong(ip / 4) * 176;
+            const float d = hybrid_half(block), dm = hybrid_half(block + 2);
+            const uint q0 = hybrid_u32(block + 48 + pair * 32 + 4 * fn);
+            const uint q1 = hybrid_u32(block + 52 + pair * 32 + 4 * fn);
+            const uint h0 = hybrid_u32(block + 16 + 4 * fn) >> (2 * pair);
+            const uint h1 = hybrid_u32(block + 20 + 4 * fn) >> (2 * pair);
+            half2 a[2][2][2];
+            hybrid_q5_special_fragments(q0,h0,a[0][0],a[1][0]);
+            hybrid_q5_special_fragments(q1,h1,a[0][1],a[1][1]);
+            #pragma clang loop unroll(full)
+            for (uint hh = 0; hh < 2; ++hh) {
+                simdgroup_float8x8 mp[RT];
+                #pragma clang loop unroll(full)
+                for (uint rt = 0; rt < RT; ++rt) mp[rt] = make_filled_simdgroup_matrix<float,8>(0.0f);
+                #pragma clang loop unroll(full)
+                for (uint s = 0; s < 4; ++s) {
+                    simdgroup_half8x8 ma;
+                    ma.thread_elements()[0] = a[hh][s / 2][s % 2].x;
+                    ma.thread_elements()[1] = a[hh][s / 2][s % 2].y;
+                    #pragma clang loop unroll(full)
+                    for (uint rt = 0; rt < RT; ++rt) {
+                        simdgroup_float8x8 mb;
+                        mb.thread_elements()[0] = s % 2 == 0 ? xs[rt][0][hh][s / 2].x : xs[rt][0][hh][s / 2].y;
+                        mb.thread_elements()[1] = s % 2 == 0 ? xs[rt][1][hh][s / 2].x : xs[rt][1][hh][s / 2].y;
+                        simdgroup_multiply_accumulate(mp[rt],ma,mb,mp[rt]);
+                    }
+                }
+                const uint2 sm = hybrid_scale_min(block + 4, 2 * pair + hh);
+                const float unscaled = d * float(sm.x), dsc = unscaled * (hh == 0 ? 1.0f : 1.0f / 16.0f);
+                const float dmn = dm * float(sm.y);
+                #pragma clang loop unroll(full)
+                for (uint rt = 0; rt < RT; ++rt) {
+                    acc[rt][t][0] = fma(dsc,mp[rt].thread_elements()[0],fma(-dmn,c[rt][0][hh],acc[rt][t][0]));
+                    acc[rt][t][1] = fma(dsc,mp[rt].thread_elements()[1],fma(-dmn,c[rt][1][hh],acc[rt][t][1]));
+                    if (hybrid_q5_special_guarded) {
+                        const float coefficient_bound = abs(unscaled) * 31.0f + abs(dmn);
+                        magnitude[rt][t][0] += coefficient_bound * absolute_c[rt][0][hh];
+                        magnitude[rt][t][1] += coefficient_bound * absolute_c[rt][1][hh];
+                    }
+                }
+            }
+        }
+    }
+    #pragma clang loop unroll(full)
+    for (uint rt = 0; rt < RT; ++rt) {
+        #pragma clang loop unroll(full)
+        for (uint t = 0; t < NT; ++t) {
+            red[((sg * RT + rt) * NT + t) * 64 + 2 * lane] = acc[rt][t][0];
+            red[((sg * RT + rt) * NT + t) * 64 + 2 * lane + 1] = acc[rt][t][1];
+        }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    float candidate[RT][NT][2] = {};
+    if (sg == 0) {
+        #pragma clang loop unroll(full)
+        for (uint rt = 0; rt < RT; ++rt) {
+            #pragma clang loop unroll(full)
+            for (uint t = 0; t < NT; ++t) {
+                for (uint split = 0; split < nsg; ++split) {
+                    candidate[rt][t][0] += red[((split * RT + rt) * NT + t) * 64 + 2 * lane];
+                    candidate[rt][t][1] += red[((split * RT + rt) * NT + t) * 64 + 2 * lane + 1];
+                }
+            }
+        }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (hybrid_q5_special_guarded) {
+        #pragma clang loop unroll(full)
+        for (uint rt = 0; rt < RT; ++rt) {
+            #pragma clang loop unroll(full)
+            for (uint t = 0; t < NT; ++t) {
+                red[((sg * RT + rt) * NT + t) * 64 + 2 * lane] = magnitude[rt][t][0];
+                red[((sg * RT + rt) * NT + t) * 64 + 2 * lane + 1] = magnitude[rt][t][1];
+            }
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (sg == 0) {
+            #pragma clang loop unroll(full)
+            for (uint rt = 0; rt < RT; ++rt) {
+                #pragma clang loop unroll(full)
+                for (uint t = 0; t < NT; ++t) {
+                    #pragma clang loop unroll(full)
+                    for (uint e = 0; e < 2; ++e) {
+                        const uint row = first_row + 8 * t + fm, token = first_token + 8 * rt + fn + e;
+                        float bound = 0.0f;
+                        for (uint split = 0; split < nsg; ++split)
+                            bound += red[((split * RT + rt) * NT + t) * 64 + 2 * lane + e];
+                        if (row < rows && token < tokens && (!isfinite(candidate[rt][t][e]) || !isfinite(bound)
+                            || (bound > 0.0f && abs(candidate[rt][t][e]) <= 2e-6f * bound)))
+                            atomic_fetch_or_explicit(fallback, 4u, memory_order_relaxed);
+                    }
+                }
+            }
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (atomic_load_explicit(fallback,memory_order_relaxed)) {
+            if (tid == 0) {
+                atomic_fetch_add_explicit(counters + 3,1u,memory_order_relaxed);
+                atomic_fetch_add_explicit(counters + 4,1u,memory_order_relaxed);
+            }
+            hybrid_q5_reference_mma_impl<NT,RT>(codes_base,input_base,output_base,p,failure,red,reference,tile,lane,sg);
+            return;
+        }
+    }
+    if (tid == 0) atomic_fetch_add_explicit(counters,1u,memory_order_relaxed);
+    if (sg == 0) {
+        #pragma clang loop unroll(full)
+        for (uint rt = 0; rt < RT; ++rt) {
+            #pragma clang loop unroll(full)
+            for (uint t = 0; t < NT; ++t) {
+                #pragma clang loop unroll(full)
+                for (uint e = 0; e < 2; ++e) {
+                    const uint row = first_row + 8 * t + fm, token = first_token + 8 * rt + fn + e;
+                    if (row < rows && token < tokens) {
+                        const float value = candidate[rt][t][e];
+                        if (!isfinite(value)) atomic_store_explicit(failure,1u,memory_order_relaxed);
+                        output[ulong(token) * rows + row] = value;
+                    }
+                }
+            }
+        }
+    }
+}
+
+#define HYBRID_Q5_SPECIAL(NT,RT) \
+kernel void hybrid_q5_special_nt##NT##_rt##RT(device const uchar *codes [[buffer(0)]], \
+    device const float *input [[buffer(1)]], device float *output [[buffer(2)]], \
+    constant uint *p [[buffer(3)]], device atomic_uint *failure [[buffer(4)]], \
+    device atomic_uint *counters [[buffer(5)]], threadgroup float *red [[threadgroup(0)]], \
+    uint2 tile [[threadgroup_position_in_grid]], uint lane [[thread_index_in_simdgroup]], \
+    uint sg [[simdgroup_index_in_threadgroup]]) { \
+    threadgroup atomic_uint fallback, reference; \
+    hybrid_q5_special_impl<NT,RT>(codes,input,output,p,failure,counters,red,&fallback,&reference,tile,lane,sg); \
+}
+HYBRID_Q5_SPECIAL(1,1)
+HYBRID_Q5_SPECIAL(2,1)
+HYBRID_Q5_SPECIAL(4,1)
+HYBRID_Q5_SPECIAL(1,2)
+HYBRID_Q5_SPECIAL(2,2)
+HYBRID_Q5_SPECIAL(4,2)
+#undef HYBRID_Q5_SPECIAL
