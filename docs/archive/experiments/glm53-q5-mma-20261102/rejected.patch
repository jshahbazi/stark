+#[stark_test]
+fn q5_special_extremes_subnormals_nonfinite_and_failure_recovery() {
+    let shape = Shape {
+        kind: 13,
+        rows: 13,
+        columns: 256,
+        tokens: 4,
+    };
+    let ordinary = representative_q5_codes(13, 256, 31);
+    for value in [1e30, -1e30, f32::MAX, f32::NAN, f32::INFINITY, f32::NEG_INFINITY] {
+        let input = vec![value; 1024];
+        let source = run(shape, &ordinary, &input, false);
+        let generic = special_run(shape, &ordinary, &input, Q5Path::Generic);
+        let guarded = special_run(shape, &ordinary, &input, Q5Path::Guarded);
+        assert_eq!(source.is_err(), guarded.is_err(), "Q5 extreme source failure parity");
+        assert_eq!(generic.is_err(), guarded.is_err(), "Q5 extreme generic failure parity");
+        if let (Ok((a, counts)), Ok((b, _))) = (guarded, generic) {
+            assert!(a.iter().zip(b).all(|(a, b)| a.to_bits() == b.to_bits()), "Q5 extreme fallback bits");
+            assert!(counts[2] > 0 && counts[4] > 0, "Q5 extreme fallback unobserved");
+        }
+    }
+    for poison in [f32::NAN, f32::INFINITY, f32::NEG_INFINITY] {
+        for at in [0usize, 2] {
+            let mut codes = ordinary.clone();
+            for b in codes.chunks_exact_mut(176) {
+                b[at..at + 2].copy_from_slice(&half::f16::from_f32(poison).to_bits().to_le_bytes());
+            }
+            assert!(
+                special_run(shape, &codes, &vec![1.0; 1024], Q5Path::Guarded).is_err(),
+                "Q5 nonfinite metadata escaped"
+            );
+        }
+    }
+    let zero = constant_q5_block(65504.0, 65504.0, 17, 1, 17).repeat(13);
+    let (zero, counters) = special_run(shape, &zero, &vec![f32::MAX; 1024], Q5Path::Guarded).unwrap();
+    assert!(zero.iter().all(|&v| v == 0.0) && counters[2] > 0, "Q5 zero times MAX contract");
+    for d in [2.0f32.powi(-24), 2.0f32.powi(-14)] {
+        let codes = constant_q5_block(d, 0.0, 17, 1, 0).repeat(13);
+        for magnitude in [1.0, f32::MIN_POSITIVE, f32::from_bits(1)] {
+            let input = vec![magnitude; 1024];
+            let source = run(shape, &codes, &input, false).unwrap();
+            let (actual, _) = special_run(shape, &codes, &input, Q5Path::Guarded).unwrap();
+            let (rms, f64_error, _) = numerical_errors(shape, &codes, &input, &actual, &source, 13);
+            assert!(rms <= 2e-5 && f64_error <= 2e-6, "Q5 subnormal scale/input numerical gates");
+        }
+    }
+    assert!(special_run(shape, &ordinary, &vec![1.0; 1024], Q5Path::Guarded).is_ok(), "Q5 failed recovery");
+}
