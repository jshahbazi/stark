+// SPDX-License-Identifier: Apache-2.0
+//! Test-only paired Q5 components. Synthetic payload metadata is guided by
+//! bounded actual-model aggregate samples; this is not model qualification.
+use stark_engine_macros::stark_test;
+
+use super::*;
+
+const BANKS: usize = 8;
+#[derive(Clone, Copy)]
+enum Schedule {
+    ProjectionMajor,
+    Generic,
+    Guarded,
+}
+impl Schedule {
+    fn label(self) -> &'static str {
+        match self {
+            Self::ProjectionMajor => "legacy_projection_major",
+            Self::Generic => "generic_f32_mma",
+            Self::Guarded => "guarded_integer_mma",
+        }
+    }
+}
+#[derive(Clone, Copy)]
+struct Timing {
+    gpu: f64,
+    encode: f64,
+    roundtrip: f64,
+}
+
+#[expect(clippy::too_many_arguments, reason = "explicit independent reference and experimental component buffers")]
+fn dispatch(
+    shape: Shape,
+    schedule: Schedule,
+    legacy: &PipelineState,
+    generic: &PipelineState,
+    generic_geometry: MmaGeometry,
+    special: &PipelineState,
+    special_geometry: MmaGeometry,
+    codes: &[Retained<ProtocolObject<dyn MTLBuffer>>],
+    input: &ProtocolObject<dyn MTLBuffer>,
+    output: &ProtocolObject<dyn MTLBuffer>,
+    failure: &ProtocolObject<dyn MTLBuffer>,
+    counters: &ProtocolObject<dyn MTLBuffer>,
+    rotation: usize,
+    capture: bool,
+) -> Result<(Timing, Option<Vec<f32>>, [u32; 5])> {
+    objc2::rc::autoreleasepool(|_| {
+        if codes.len() != BANKS || failure.length() < 4 || counters.length() < 20 {
+            return Err(Error::Invalid("Q5 component counter/bank geometry"));
+        }
+        unsafe {
+            failure.contents().as_ptr().cast::<u32>().write(0);
+            counters.contents().as_ptr().cast::<[u32; 5]>().write([0; 5]);
+        }
+        let start = std::time::Instant::now();
+        let command = executor()?.queue.command_buffer().ok_or(Error::Invalid("Q5 component command"))?;
+        let encoder = command.compute_command_encoder().ok_or(Error::Invalid("Q5 component encoder"))?;
+        for step in 0..BANKS {
+            let bank = (step + rotation) % BANKS;
+            let offsets = [0, 0, bank * shape.tokens * shape.rows];
+            match schedule {
+                Schedule::ProjectionMajor => {
+                    for token in 0..shape.tokens {
+                        encode_serial(&encoder, shape, legacy, &codes[bank], input, output, offsets, token)?;
+                    }
+                },
+                Schedule::Generic => encode_mma(
+                    &encoder,
+                    shape,
+                    generic,
+                    generic_geometry,
+                    &codes[bank],
+                    input,
+                    output,
+                    failure,
+                    offsets,
+                )?,
+                Schedule::Guarded => encode_special(
+                    &encoder,
+                    shape,
+                    special,
+                    special_geometry,
+                    &codes[bank],
+                    input,
+                    output,
+                    failure,
+                    counters,
+                    offsets,
+                )?,
+            }
+        }
+        encoder.end_encoding();
+        let encode = start.elapsed().as_secs_f64();
+        command.commit();
+        command.wait_until_completed();
+        let roundtrip = start.elapsed().as_secs_f64();
+        if command.status() != MTLCommandBufferStatus::Completed
+            || unsafe { *failure.contents().as_ptr().cast::<u32>() } != 0
+        {
+            return Err(Error::Invalid("Q5 component GPU/status failure"));
+        }
+        let gpu = command.gpu_end_time() - command.gpu_start_time();
+        let counts = unsafe { *counters.contents().as_ptr().cast::<[u32; 5]>() };
+        let values = if capture {
+            Some(
+                unsafe {
+                    std::slice::from_raw_parts(
+                        output.contents().as_ptr().cast::<f32>(),
+                        BANKS * shape.tokens * shape.rows,
+                    )
+                }
+                .to_vec(),
+            )
+        } else {
+            None
+        };
+        Ok((
+            Timing {
+                gpu,
+                encode,
+                roundtrip,
+            },
+            values,
+            counts,
+        ))
+    })
+}
+fn median(values: &[f64]) -> f64 {
+    let mut v = values.to_vec();
+    v.sort_by(f64::total_cmp);
+    (v[(v.len() - 1) / 2] + v[v.len() / 2]) * 0.5
+}
+fn hash(values: &[f32]) -> String {
+    use sha2::{Digest, Sha256};
+    let mut digest = Sha256::new();
+    for value in values {
+        digest.update(value.to_bits().to_le_bytes());
+    }
+    digest.finalize().iter().map(|b| format!("{b:02x}")).collect()
+}
