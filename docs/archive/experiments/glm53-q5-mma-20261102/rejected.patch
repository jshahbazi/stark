+#[expect(clippy::too_many_arguments, reason = "explicit checked experimental buffers and counters")]
+fn encode_special(
+    encoder: &ProtocolObject<dyn MTLComputeCommandEncoder>,
+    shape: Shape,
+    pipeline: &PipelineState,
+    geometry: MmaGeometry,
+    codes: &ProtocolObject<dyn MTLBuffer>,
+    input: &ProtocolObject<dyn MTLBuffer>,
+    output: &ProtocolObject<dyn MTLBuffer>,
+    failure: &ProtocolObject<dyn MTLBuffer>,
+    counters: &ProtocolObject<dyn MTLBuffer>,
+    offsets: [usize; 3],
+) -> Result<()> {
+    if shape.kind != 13 || counters.length() < 5 * 4 {
+        return Err(Error::Invalid("Q5 specialized counter/format span"));
+    }
+    encoder.set_buffer(Some(counters), 0, 5);
+    encode_mma(encoder, shape, pipeline, geometry, codes, input, output, failure, offsets)
+}
+
+fn representative_q5_codes(
+    rows: usize,
+    columns: usize,
+    seed: usize,
+) -> Vec<u8> {
+    let mut result = finite_codes(13, rows, columns, seed);
+    // Synthetic metadata guided by bounded actual-main/output aggregate samples.
+    // Stored dmin stays nonzero; subgroup min codes and quants are randomized.
+    // The resulting a*31 and b ranges are within the sampled ordinary envelope.
+    for (index, block) in result.chunks_exact_mut(176).enumerate() {
+        let d = half::f16::from_f32(0.000015 + ((index * 17 + seed) % 257) as f32 * 0.00000025);
+        let dm = half::f16::from_f32(0.0004 + ((index * 29 + seed) % 131) as f32 * 0.0000075);
+        block[..2].copy_from_slice(&d.to_bits().to_le_bytes());
+        block[2..4].copy_from_slice(&dm.to_bits().to_le_bytes());
+    }
+    result
+}
+
+fn special_run(
+    shape: Shape,
+    codes: &[u8],
+    input: &[f32],
+    path: Q5Path,
+) -> Result<(Vec<f32>, [u32; 5])> {
+    if shape.kind != 13 || codes.len() != shape.sizes()?.1 || input.len() != shape.tokens * shape.columns {
+        return Err(Error::Invalid("Q5 special test payload"));
+    }
+    objc2::rc::autoreleasepool(|_| {
+        let executor = executor()?;
+        let mut storage = vec![0xa7u8; 19];
+        storage.extend_from_slice(codes);
+        storage.extend_from_slice(&[0x4d; 19]);
+        let codes = buffer(executor, &storage)?;
+        let mut values = vec![f32::NAN; 3];
+        values.extend_from_slice(input);
+        values.extend_from_slice(&[f32::NAN; 3]);
+        let input = buffer(executor, bytemuck::cast_slice(&values))?;
+        let count = shape.rows * shape.tokens;
+        let output = buffer(executor, bytemuck::cast_slice(&vec![7.25f32; count + 6]))?;
+        let failure = buffer(executor, bytemuck::cast_slice(&[0u32]))?;
+        let counters = buffer(executor, bytemuck::cast_slice(&[0u32; 5]))?;
+        let command = executor.queue.command_buffer().ok_or(Error::Invalid("Q5 special test command"))?;
+        let encoder = command.compute_command_encoder().ok_or(Error::Invalid("Q5 special test encoder"))?;
+        match path {
+            Q5Path::Generic => {
+                let (pipeline, geometry) = mma_pipeline(shape)?;
+                encode_mma(&encoder, shape, &pipeline, geometry, &codes, &input, &output, &failure, [19, 3, 3])?;
+            },
+            Q5Path::Guarded | Q5Path::RawDiagnostic => {
+                let (pipeline, geometry) = special_pipeline(shape, matches!(path, Q5Path::Guarded))?;
+                encode_special(
+                    &encoder,
+                    shape,
+                    &pipeline,
+                    geometry,
+                    &codes,
+                    &input,
+                    &output,
+                    &failure,
+                    &counters,
+                    [19, 3, 3],
+                )?;
+            },
+        }
+        encoder.end_encoding();
+        command.commit();
+        command.wait_until_completed();
+        if command.status() != MTLCommandBufferStatus::Completed {
+            return Err(Error::Invalid("Q5 special test execution"));
+        }
+        let values = unsafe { std::slice::from_raw_parts(output.contents().as_ptr().cast::<f32>(), count + 6) };
+        assert!(values[..3].iter().chain(&values[count + 3..]).all(|&v| v == 7.25), "Q5 special tail sentinel");
+        if unsafe { *failure.contents().as_ptr().cast::<u32>() } != 0
+            || values[3..count + 3].iter().any(|x| !x.is_finite())
+        {
+            return Err(Error::Invalid("Q5 special nonfinite result"));
+        }
+        let counts = unsafe { *counters.contents().as_ptr().cast::<[u32; 5]>() };
+        Ok((values[3..count + 3].to_vec(), counts))
+    })
+}
+
+fn constant_q5_block(
+    d: f32,
+    dm: f32,
+    quant: u8,
+    scale: u8,
+    minimum: u8,
+) -> Vec<u8> {
+    assert!(quant < 32 && scale < 64 && minimum < 64);
+    let mut b = vec![0u8; 176];
+    b[..2].copy_from_slice(&half::f16::from_f32(d).to_bits().to_le_bytes());
+    b[2..4].copy_from_slice(&half::f16::from_f32(dm).to_bits().to_le_bytes());
+    for i in 0..4 {
+        b[4 + i] = (scale & 63) | ((scale >> 4) << 6);
+        b[8 + i] = (minimum & 63) | ((minimum >> 4) << 6);
+        b[12 + i] = (scale & 15) | ((minimum & 15) << 4);
+    }
+    b[16..48].fill(if quant & 16 != 0 {
+        255
+    } else {
+        0
+    });
+    b[48..176].fill((quant & 15) * 17);
+    b
+}
