{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Stark Docs",
  "colors": {
    "primary": "#0A0A0A",
    "light": "#FCFCFC",
    "dark": "#0A0A0A"
  },
  "navigation": {
    "groups": [
      {
        "group": "Overview",
        "pages": [
          "index"
        ]
      },
      {
        "group": "Quick start",
        "pages": [
          "quick-start/chat",
          "quick-start/chat-cloud",
          "quick-start/chat-structured-output"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/jshahbazi/stark",
          "icon": "github"
        }
      ]
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Repository",
      "href": "https://github.com/jshahbazi/stark"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/jshahbazi/stark"
    }
  }
}
